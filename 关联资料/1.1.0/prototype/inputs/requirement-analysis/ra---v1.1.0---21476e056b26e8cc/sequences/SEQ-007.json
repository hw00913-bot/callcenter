{
  "schema_version": "1.0",
  "id": "SEQ-007",
  "scenario_id": "SC-001",
  "name": "接口及手工失败下载生命周期",
  "participants": [
    {
      "id": "operator",
      "name": "运营人员",
      "kind": "actor"
    },
    {
      "id": "ui",
      "name": "运营界面（合成模拟）",
      "kind": "system"
    },
    {
      "id": "service",
      "name": "云呼叫中心业务服务（模拟）",
      "kind": "system"
    }
  ],
  "messages": [
    {
      "step": 1,
      "from": "service",
      "to": "ui",
      "message": "分类显示本地/供应商导入失败；失败分片未收齐或完整性未知显示不完整/待核",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 2,
      "from": "operator",
      "to": "ui",
      "message": "下载选中/本次导出失败明细",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 3,
      "from": "ui",
      "to": "service",
      "message": "冻结本次失败导出快照及完整性说明；后到新失败不加入已生成快照",
      "type": "internal",
      "api_id": null,
      "condition": null
    },
    {
      "step": 4,
      "from": "service",
      "to": "ui",
      "message": "生成模拟导出结果/文件；生成或点击不代表成功下载",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 5,
      "from": "ui",
      "to": "service",
      "message": "合成明确下载成功事件（非真实浏览器成功证明）",
      "type": "event",
      "api_id": null,
      "condition": "独立模拟成功情形"
    },
    {
      "step": 6,
      "from": "service",
      "to": "service",
      "message": "可信成功只清该快照明细/文件；保留客户业务关联、去重标记、分片及DCC交付状态",
      "type": "internal",
      "api_id": null,
      "condition": "成功信号已可信确认"
    },
    {
      "step": 7,
      "from": "service",
      "to": "ui",
      "message": "失败/中断保留，无固定到期；成功显示本次已清理",
      "type": "response",
      "api_id": null,
      "condition": "对应情形"
    },
    {
      "step": 8,
      "from": "service",
      "to": "service",
      "message": "后到新失败保留待再次下载；已导出重复事件不再生明细；回传失败仍可补送",
      "type": "internal",
      "api_id": null,
      "condition": "下载后异步事件到达"
    }
  ],
  "notes": [
    "严格限定为用户接受的静态合成模拟，不发真实请求；partial/missing能力不提升为verified。",
    "API引用用于责任/核验追溯，缺少端点/字段时不编造请求。",
    "未知/矛盾结果待核暂停；明确拒绝/重复通知另记，不算新的实际呼叫。"
  ],
  "source_refs": [
    "inputs/source-index.json#SRC-061",
    "inputs/source-index.json#SRC-071",
    "inputs/source-index.json#SRC-072",
    "inputs/source-index.json#SRC-073"
  ]
}
