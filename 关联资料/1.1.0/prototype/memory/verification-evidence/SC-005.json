{
  "schema_version": "1.0",
  "id": "SC-005",
  "name": "超管建立与维护应用接入凭证",
  "summary": "超管从应用列表新增或维护指定应用，查看用于获取租户token的appId/appSecret；新增、修改、详情和删除为独立可发起操作，日常UI不展示技术身份交换参数。DCC在后台使用有效凭证与tenantId换业务身份，应用管理权与业务身份分离。原型仅合成密钥，生产生成/存储/服务契约和既有token撤销机制仍待核。",
  "actors": [
    "超级管理员",
    "云呼叫中心",
    "DCC"
  ],
  "trigger": "超管需要建立或维护DCC应用接入凭证",
  "preconditions": [
    "应用管理只允许已就绪超级管理员，菜单、直达和每次模型/服务写入均校验。",
    "沿既有合法业务租户授权边界，任务归租户不归应用；凭证换业务token不授予应用管理权。",
    "本次不新增启停、重置密钥、计费或生产接口承诺；模拟密钥/token不可用于真实服务。"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "超级管理员",
      "action": "进入应用列表查询现有应用",
      "system_response": "显示应用名称、appId、创建时间与详情/修改/删除入口；无记录或无查询结果仍可新增",
      "rule_ids": [
        "BR-001",
        "BR-020"
      ]
    },
    {
      "step": 2,
      "actor": "超级管理员",
      "action": "新增应用并填写名称和必要的可访问租户；或者选择已有应用的详情、修改、删除",
      "system_response": "按当前明确操作和精确对象校验，不把列表/新增/查看/修改/删除混为一次保存",
      "rule_ids": [
        "BR-001",
        "BR-020"
      ]
    },
    {
      "step": 3,
      "actor": "云呼叫中心",
      "action": "保存新应用并提供appId和appSecret",
      "system_response": "成功进入应用详情；原型返回合成不可用值，保存失败不显示成功或假凭证",
      "rule_ids": [
        "BR-001",
        "BR-020"
      ]
    },
    {
      "step": 4,
      "actor": "超级管理员",
      "action": "按需查看/复制凭证，或修改/确认删除当前应用",
      "system_response": "详情默认遮罩、按需显示复制；修改保留原appId/密钥，合成业务身份解析始终按当前租户授权校验；删除取消不变，成功删除精确应用，其合成凭证及已发合成身份失效。删除后不能再凭其密钥申请新业务token，既有token的真实撤销/时效机制仍待核。",
      "rule_ids": [
        "BR-001",
        "BR-020"
      ]
    },
    {
      "step": 5,
      "actor": "DCC",
      "action": "在后台以有效应用凭证与tenantId申请租户业务身份",
      "system_response": "仅授权有效时返回该租户业务身份；无效/已删除凭证/未授权租户拒绝，不产生应用管理权限",
      "rule_ids": [
        "BR-001",
        "BR-020"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-001",
      "condition": "当前身份无应用管理权限",
      "steps": [
        "拒绝访问或写入，配置不变"
      ]
    },
    {
      "id": "ALT-002",
      "condition": "新增必要输入无效",
      "steps": [
        "提示当前输入问题，不保存/生成成功凭证"
      ]
    },
    {
      "id": "ALT-003",
      "condition": "保存失败或当前对象已变化",
      "steps": [
        "保留原配置，明确失败，重新打开当前对象后处理"
      ]
    },
    {
      "id": "ALT-004",
      "condition": "取消删除",
      "steps": [
        "当前应用及凭证保留"
      ]
    },
    {
      "id": "ALT-005",
      "condition": "凭证已删除/无效或租户未授权",
      "steps": [
        "拒绝新租户身份发放，管理权限不改变"
      ]
    }
  ],
  "postconditions": [
    "新增/修改/删除的结果对应当前应用；列表和详情仅显示保存事实。",
    "DCC业务身份与应用管理身份分离；日常应用页不承担技术身份交换演示。",
    "应用管理结果结束后，不自动调用token交换；只有DCC另行发起后台身份申请时才验证凭证/租户。"
  ],
  "acceptance_points": [
    "AC-017",
    "AC-028",
    "AC-044",
    "AC-045",
    "AC-053",
    "AC-054",
    "AC-055",
    "AC-056",
    "AC-057",
    "AC-058"
  ],
  "source_story_ids": [
    "US-001"
  ],
  "source_refs": [
