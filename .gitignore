# Publish the runnable prototype and portable regression tests only.
/*
!/.gitignore
!/README.md
!/DEMO_PROTYPE/
!/qa/
!/outputs/

# Local workflow state, source materials and personal tooling stay local.
/DEMO_PROTYPE/.loop-history/
/DEMO_PROTYPE/.clauderules
/DEMO_PROTYPE/CLAUDE.md
/DEMO_PROTYPE/memory/
/DEMO_PROTYPE/tools/
/DEMO_PROTYPE/docs/*
!/DEMO_PROTYPE/docs/interaction.html
/DEMO_PROTYPE/功能清单.csv
/DEMO_PROTYPE/功能说明.md

# The sequence atlas links to this supporting matrix.
/outputs/*
!/outputs/阿里云CCC系统时序接口核验矩阵.md

# Tests below require private/local workflow snapshots or another project.
/qa/*
!/qa/fixtures/
!/qa/check-customer-external-document.cjs
!/qa/check-customer-tasks.cjs
!/qa/check-customer-directory.cjs
!/qa/check-customer-select-all.cjs
!/qa/check-task-customer-pool.cjs
!/qa/check-local-task-simulation.cjs
!/qa/check-call-modal.cjs
!/qa/check-workbench-split.cjs
!/qa/check-customer-demo.cjs
!/qa/check-demo-accounts.cjs
!/qa/check-linked-demo.cjs
!/qa/check-account-online.cjs
!/qa/check-account-seat.cjs
!/qa/check-ai-billing-ui.cjs
!/qa/check-seat-navigation.cjs

# Never publish caches, credentials or generated test artifacts.
.DS_Store
__pycache__/
*.pyc
*.log
*.orig
*.zip
node_modules/
playwright-report/
test-results/
.playwright-cli/
.env
.env.*
*.pem
*.key
cookies.json
storageState.json
auth.json
