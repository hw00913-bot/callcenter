{
  "schema_version": "1.0",
  "id": "SC-018",
  "name": "呼入排队、拒接、客户匹配和非服务时间分支",
  "summary": "对无人承接、拒接、陌生来电、多客户匹配和非服务时间提供明确且不跨租户的处理路径。",
  "actors": [
    "来电客户",
    "统一外呼中台",
    "AliCti",
    "本租户承接坐席"
  ],
  "trigger": "呼入未能直接进入正常唯一客户接听路径",
  "preconditions": [
    "客户已拨入供应商账号共享号码，并已由 IVR 分支或默认兜底锁定目标租户"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "AliCti",
      "action": "呼入服务时间及队列配置待确认",
      "system_response": "仅接收来源已明确的实际呼入结果",
      "rule_ids": [
        "BR-018"
      ]
    },
    {
      "step": 2,
      "actor": "统一外呼中台",
      "action": "在服务时间且允许继续排队？",
      "system_response": "通过才继续；不通过结束本次操作",
      "rule_ids": [
        "BR-018"
      ]
    },
    {
      "step": 3,
      "actor": "AliCti",
      "action": "队列等待及拒接再分配能力待确认",
      "system_response": "无文档证据不标路由已生效",
      "rule_ids": [
        "BR-018"
      ]
    },
    {
      "step": 4,
      "actor": "统一外呼中台",
      "action": "在时限内成功分配且坐席接听？",
      "system_response": "通过才继续；不通过结束本次操作",
      "rule_ids": [
        "BR-018"
      ]
    },
    {
      "step": 5,
      "actor": "统一外呼中台",
      "action": "自有界面显示当前来电；以本租户手机号查询平台联系档案",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-018"
      ]
    },
    {
      "step": 6,
      "actor": "本租户承接坐席",
      "action": "有档案则查看，未知号码保留来电号码，不强建线索或工单",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-018"
      ]
    },
    {
      "step": 7,
      "actor": "统一外呼中台",
      "action": "最终话单分别归档客户接通、人工接听和结束原因",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-018"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-018-2",
      "condition": "在服务时间且允许继续排队？：不通过",
      "steps": [
        "按已发布非营业或超时提示结束；保留未承接记录"
      ]
    },
    {
      "id": "ALT-018-4",
      "condition": "在时限内成功分配且坐席接听？：不通过",
      "steps": [
        "队列超时或放弃则结束；不将坐席拒接等同客户整通未接通"
      ]
    }
  ],
  "postconditions": [
    "对无人承接、拒接、陌生来电、多客户匹配和非服务时间提供明确且不跨租户的处理路径。"
  ],
  "acceptance_points": [
    "超时/非营业/拒接处理限定当前租户，不自动跨租户路由。",
    "当前范围不包含外部客户查询、外部新建单据或单据回传。"
  ],
  "source_story_ids": [
    "US-018"
  ],
