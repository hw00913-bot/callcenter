{
  "schema_version": "1.0",
  "id": "SC-003",
  "name": "在中台开通供应商坐席",
  "summary": "由管理员在当前租户开通或导入独立电话身份，再按需关联平台账号。",
  "actors": [
    "租户管理员/超级管理员",
    "统一外呼中台",
    "AliCti"
  ],
  "trigger": "租户管理员需要新增一个或多个联络中心坐席",
  "preconditions": [
    "当前租户已启用云联络中心并绑定供应商账号",
    "操作人有坐席维护权限"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "租户管理员/超级管理员",
      "action": "在当前租户申请新建坐席",
      "system_response": "其他导入能力待确认",
      "rule_ids": [
        "BR-003"
      ],
      "input": "当前租户及enterpriseId范围内经授权的业务上下文"
    },
    {
      "step": 2,
      "actor": "统一外呼中台",
      "action": "管理员权限、供应商账号和坐席归属合法？",
      "system_response": "通过才继续；不通过结束本次操作",
      "rule_ids": [
        "BR-003"
      ]
    },
    {
      "step": 3,
      "actor": "统一外呼中台",
      "action": "准备工号、姓名、区号和目标供应商账号",
      "system_response": "cno、name、areaCode；平台账号与坐席独立",
      "rule_ids": [
        "BR-003"
      ],
      "input": "当前租户及enterpriseId范围内经授权的业务上下文"
    },
    {
      "step": 4,
      "actor": "AliCti",
      "action": "按当前供应商账号创建坐席",
      "system_response": "返回坐席信息或明确错误；响应不确定时先核查",
      "rule_ids": [
        "BR-003"
      ],
      "input": "当前租户及enterpriseId范围内经授权的业务上下文"
    },
    {
      "step": 5,
      "actor": "统一外呼中台",
      "action": "核对实际坐席工号及供应商账号归属",
      "system_response": "以enterpriseId和cno定位，不把请求ID当坐席ID",
      "rule_ids": [
        "BR-003"
      ],
      "input": "当前租户及enterpriseId范围内经授权的业务上下文"
    },
    {
      "step": 6,
      "actor": "统一外呼中台",
      "action": "厂商坐席及唯一租户映射已确认？",
      "system_response": "通过才继续；不通过结束本次操作",
      "rule_ids": [
        "BR-003"
      ]
    },
    {
      "step": 7,
      "actor": "统一外呼中台",
      "action": "保存租户独占坐席；关联账号从账号管理完成，技能另行分配",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-003"
      ]
    },
    {
      "step": 8,
      "actor": "租户管理员/超级管理员",
      "action": "查看开通结果及待补充资源",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-003"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-003-2",
      "condition": "管理员权限、供应商账号和坐席归属合法？：不通过",
      "steps": [
        "拒绝越权或重复归属，不新建任何云资源"
      ]
    },
    {
      "id": "ALT-003-6",
      "condition": "厂商坐席及唯一租户映射已确认？：不通过",
      "steps": [
        "失败项保留，未知先查询核对；只对确认失败项重试"
      ]
    }
  ],
  "postconditions": [
    "由管理员在当前租户开通或导入独立电话身份，再按需关联平台账号。"
  ],
  "acceptance_points": [
    "新建坐席不依赖外部人员目录；未明确支持的导入能力显示待确认。",
    "确认enterpriseId/cno实际创建结果并保存唯一租户归属；失败不重复建号。"
  ],
  "source_story_ids": [
    "US-003"
  ],
  "source_refs": [
    "inputs/baseline-reference/scenarios/SC-003.json",
