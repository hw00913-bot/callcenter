      "condition": "校验失败；本路径结束"
    },
    {
      "step": 6,
      "from": "u",
      "to": "ui",
      "message": "选择供应商账号技能分类与目标租户",
      "type": "request",
      "api_id": null,
      "condition": "前置业务条件成立"
    },
    {
      "step": 7,
      "from": "svc",
      "to": "svc",
      "message": "同一供应商账号且映射不冲突？；满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 8,
      "from": "svc",
      "to": "svc",
      "message": "准备本租户独占的技能与队列映射；企业账号内资源唯一归属",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 9,
      "from": "svc",
      "to": "ui",
      "message": "技能/队列创建及隔离契约未明确，显示待确认，不发送虚构创建接口",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 10,
      "from": "svc",
      "to": "ui",
      "message": "物理组创建证据不充分时不进入保存生效分支",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 11,
      "from": "svc",
      "to": "svc",
      "message": "保存模板到租户物理组映射；供应商账号分类可复用；组内ACD不跨租户",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 12,
      "from": "svc",
      "to": "ui",
      "message": "禁止跨供应商账号或多个租户共用同一物理组",
      "type": "error",
      "api_id": null,
      "condition": "同一供应商账号且映射不冲突？：不满足"
    },
    {
      "step": 13,
      "from": "svc",
      "to": "ui",
      "message": "保留同步失败或结果未知，先查询核对再重试",
      "type": "error",
      "api_id": null,
      "condition": "物理组已确认创建且归属正确？：不满足"
    },
    {
      "step": 14,
      "from": "svc",
      "to": "ui",
      "message": "返回已证实结果；未知能力显示待确认，保留数据并可再次核对",
