    {
      "step": 7,
      "from": "svc",
      "to": "svc",
      "message": "在服务时间且允许继续排队？；通过才继续；不通过结束本次操作",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 8,
      "from": "svc",
      "to": "ui",
      "message": "队列/拒接再分配结果无证据时待确认，不模拟转给任意坐席",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 9,
      "from": "svc",
      "to": "svc",
      "message": "在时限内成功分配且坐席接听？；通过才继续；不通过结束本次操作",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 10,
      "from": "svc",
      "to": "svc",
      "message": "自有界面显示当前来电；以本租户手机号查询平台联系档案；按本步骤完成结果继续",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 11,
      "from": "u",
      "to": "ui",
      "message": "有档案则查看，未知号码保留来电号码，不强建线索或工单",
      "type": "request",
      "api_id": null,
      "condition": "前置业务条件成立"
    },
    {
      "step": 12,
      "from": "svc",
      "to": "vendor",
      "message": "查询实际呼入话单并核对当前租户归属",
      "type": "request",
      "api_id": "API-319",
      "condition": "对应操作/呼叫类型，且其前置路径成立"
    },
    {
      "step": 13,
      "from": "vendor",
      "to": "svc",
      "message": "保留系统应答、人工接听、未接和排队原因",
      "type": "response",
      "api_id": "API-319",
      "condition": "对应操作/呼叫类型，且其前置路径成立"
    },
    {
      "step": 14,
      "from": "svc",
      "to": "ui",
      "message": "按已发布非营业或超时提示结束；保留未承接记录",
      "type": "error",
      "api_id": null,
      "condition": "在服务时间且允许继续排队？：不通过"
    },
    {
      "step": 15,
      "from": "svc",
      "to": "ui",
      "message": "队列超时或放弃则结束；不将坐席拒接等同客户整通未接通",
      "type": "error",
      "api_id": null,
      "condition": "在时限内成功分配且坐席接听？：不通过"
    },
    {
      "step": 16,
      "from": "svc",
      "to": "ui",
      "message": "返回已证实结果；未知能力显示待确认，保留数据并可再次核对",
      "type": "response",
      "api_id": null,
      "condition": null
    }
  ],
  "notes": [
