{
  "schema_version": "1.0",
  "id": "SC-016",
  "name": "复用现有智能外呼中台执行 AI 外呼",
  "summary": "保留现有 AI 外呼租户、账号、机器人和第三方厂商链路，不被联络中心改造替换。",
  "actors": [
    "智能外呼管理员/运营",
    "统一外呼中台",
    "既有AI外呼供应商"
  ],
  "trigger": "租户运营需要创建 AI 外呼任务",
  "preconditions": [
    "租户已启用智能外呼能力并具备现有第三方厂商账号、机器人和话术"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "智能外呼管理员/运营",
      "action": "在智能外呼域管理任务及名单",
      "system_response": "AI任务及名单",
      "input": "既有业务场景、话术、租户厂商账号",
      "rule_ids": [
        "BR-016"
      ]
    },
    {
      "step": 2,
      "actor": "统一外呼中台",
      "action": "既有账号租户权限与AI配置有效？",
      "system_response": "满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "input": "前一步操作与当前上下文",
      "rule_ids": [
        "BR-016"
      ]
    },
    {
      "step": 3,
      "actor": "既有AI外呼供应商",
      "action": "按原链路执行AI外呼",
      "system_response": "通话与意向/标签等结果",
      "input": "原任务、机器人、话术、名单",
      "rule_ids": [
        "BR-016"
      ]
    },
    {
      "step": 4,
      "actor": "统一外呼中台",
      "action": "沿用原智能外呼结果和统计",
      "system_response": "通话记录、线索记录、通话/计费/线索统计",
      "input": "厂商结果及原关联",
      "rule_ids": [
        "BR-016"
      ]
    },
    {
      "step": 5,
      "actor": "智能外呼管理员/运营",
      "action": "查看原有列表、详情和全部报表",
      "system_response": "既有能力完整保留，不引入AI转人工",
      "input": "当前租户AI数据",
      "rule_ids": [
        "BR-016"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-016-2",
      "condition": "既有账号租户权限与AI配置有效？：不满足",
      "steps": [
        "沿用原智能外呼校验与错误处理，不使用CCC替代"
      ],
      "continuation": "本次操作结束；修正后由用户重新发起，不自动重试不可重复动作。"
    }
  ],
  "postconditions": [
    "保留现有 AI 外呼租户、账号、机器人和第三方厂商链路，不被联络中心改造替换。"
  ],
  "acceptance_points": [
    "保留现有 AI 外呼租户、账号、机器人和第三方厂商链路，不被联络中心改造替换。",
    "权限或资源条件不满足时明确拦截，不跨租户执行，不伪造成功；具体失败/超时与补偿边界见本场景图及关联接口核验。"
