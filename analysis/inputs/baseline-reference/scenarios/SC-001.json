{
  "schema_version": "1.0",
  "id": "SC-001",
  "name": "超级管理员进入实例并启用租户联络中心能力",
  "summary": "在唯一、明确的品牌实例上下文中，为总部或门店租户安全启用联络中心能力。",
  "actors": [
    "超级管理员",
    "统一外呼中台"
  ],
  "trigger": "超级管理员登录，或需要为租户开通联络中心能力",
  "preconditions": [
    "账号属于系统内置超级管理租户"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "超级管理员",
      "action": "登录并选定客户实例",
      "system_response": "唯一有效实例上下文",
      "input": "内置管理账号；上次实例",
      "rule_ids": [
        "BR-001"
      ]
    },
    {
      "step": 2,
      "actor": "统一外呼中台",
      "action": "当前实例与管理员资格有效？",
      "system_response": "满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "input": "前一步操作与当前上下文",
      "rule_ids": [
        "BR-001"
      ]
    },
    {
      "step": 3,
      "actor": "超级管理员",
      "action": "创建或修改租户并勾选产品能力",
      "system_response": "待保存租户",
      "input": "名称、总部/门店、商用/试用、状态、能力",
      "rule_ids": [
        "BR-001"
      ]
    },
    {
      "step": 4,
      "actor": "统一外呼中台",
      "action": "租户可绑定该实例且必填信息有效？",
      "system_response": "满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "input": "前一步操作与当前上下文",
      "rule_ids": [
        "BR-001"
      ]
    },
    {
      "step": 5,
      "actor": "统一外呼中台",
      "action": "保存租户及产品授权",
      "system_response": "租户启用能力；不自动开坐席",
      "input": "租户配置与当前实例",
      "rule_ids": [
        "BR-001"
      ]
    },
    {
      "step": 6,
      "actor": "超级管理员",
      "action": "查看租户管理结果",
      "system_response": "核对归属、产品权限及状态",
      "input": "已保存租户",
      "rule_ids": [
        "BR-001"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-001-2",
      "condition": "当前实例与管理员资格有效？：不满足",
      "steps": [
        "停止进入实例业务，提示重新选择或核对权限"
      ],
      "continuation": "本次操作结束；修正后由用户重新发起，不自动重试不可重复动作。"
    },
    {
      "id": "ALT-001-4",
      "condition": "租户可绑定该实例且必填信息有效？：不满足",
      "steps": [
        "拒绝保存；已有资源租户不得直接迁移实例"
      ],
      "continuation": "本次操作结束；修正后由用户重新发起，不自动重试不可重复动作。"
    },
    {
      "id": "ALT-001-CANCEL",
      "condition": "执行变更前取消确认",
      "steps": [
        "取消提交：不执行本次变更，保留已有有效数据"
      ]
    }
  ],
  "postconditions": [
    "在唯一、明确的品牌实例上下文中，为总部或门店租户安全启用联络中心能力。"
  ],
