{
  "schema_version": "1.0",
  "id": "SEQ-013",
  "scenario_id": "SC-011",
  "name": "超管授权租户及撤销接口授权时序草稿",
  "status": "product_design_draft",
  "participants": [
    {
      "id": "operator",
      "name": "超级管理员",
      "kind": "actor"
    },
    {
      "id": "frontend",
      "name": "云外呼平台前端",
      "kind": "system"
    },
    {
      "id": "configuration",
      "name": "平台内部配置服务",
      "kind": "system"
    }
  ],
  "messages": [
    {
      "step": 1,
      "from": "operator",
      "to": "frontend",
      "message": "打开指定接口条目的可用租户配置",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 2,
      "from": "frontend",
      "to": "configuration",
      "message": "读取该接口条目的已保存可用租户范围",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 3,
      "from": "configuration",
      "to": "frontend",
      "message": "返回该接口与当前可用租户配置",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 4,
      "from": "frontend",
      "to": "operator",
      "message": "展示该接口的租户勾选配置与本次维护对象",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 5,
      "from": "operator",
      "to": "frontend",
      "message": "取消本次可用租户配置",
      "type": "request",
      "api_id": null,
      "condition": "提交前选择取消；与后续提交分支互斥"
    },
    {
      "step": 6,
      "from": "frontend",
      "to": "operator",
      "message": "结束本次可用租户配置，不提交本次变更",
      "type": "response",
      "api_id": null,
      "condition": "提交前取消分支"
    },
    {
      "step": 7,
      "from": "operator",
      "to": "frontend",
      "message": "调整租户勾选并提交本次接口的可用租户配置",
      "type": "request",
      "api_id": null,
      "condition": "提交分支；一次提交可包含开放与撤销"
    },
    {
      "step": 8,
      "from": "frontend",
      "to": "configuration",
      "message": "提交指定接口条目的本次租户授权范围",
      "type": "request",
      "api_id": null,
      "condition": "提交分支"
    },
    {
      "step": 9,
      "from": "configuration",
      "to": "configuration",
      "message": "尝试保存本次可用租户范围",
      "type": "internal",
      "api_id": null,
      "condition": "提交分支"
    },
    {
      "step": 10,
      "from": "configuration",
      "to": "configuration",
      "message": "撤销生效后停止对应接口与租户的新查询和新选择；保留其历史与字段配置",
      "type": "internal",
      "api_id": null,
      "condition": "授权配置保存成功且包含撤销授权；不含撤销时跳过此步"
    },
    {
      "step": 11,
      "from": "configuration",
      "to": "frontend",
      "message": "返回本次已保存的租户授权范围及其中的开放／撤销结果",
      "type": "response",
      "api_id": null,
      "condition": "授权配置保存成功"
    },
    {
      "step": 12,
      "from": "frontend",
      "to": "operator",
      "message": "展示授权范围保存成功；重新授权仍受启停状态约束，未提交旧值须在填写场景重查确认",
      "type": "response",
      "api_id": null,
      "condition": "授权配置保存成功"
    },
    {
      "step": 13,
      "from": "configuration",
      "to": "frontend",
      "message": "返回本次租户授权配置未保存成功",
      "type": "response",
      "api_id": null,
      "condition": "授权配置保存未成功；与成功分支互斥"
    },
    {
      "step": 14,
      "from": "frontend",
      "to": "operator",
      "message": "提示本次授权配置未完成，不显示授权成功",
      "type": "response",
      "api_id": null,
      "condition": "授权配置保存未成功"
    }
  ],
