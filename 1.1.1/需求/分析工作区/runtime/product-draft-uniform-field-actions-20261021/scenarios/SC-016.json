{
  "schema_version": "1.0",
  "project_version": "1.1.1",
  "id": "SC-016",
  "name": "逻辑删除业务分类",
  "summary": "具备本租户业务配置权限的管理员可确认逻辑删除业务分类，不因历史通话、进行中/话后通话或已有业务引用而禁止。目标从当前配置列表和新业务可选项移除，持久标记已删除，不级联删除字段、接口或业务数据。",
  "actors": [
    "本租户业务配置管理员",
    "云外呼平台"
  ],
  "trigger": "管理员需要停止某分类的新业务选用，同时保留既有业务继续处理。",
  "preconditions": [
    "在本租户具有原分类维护权限。",
    "原分类/字段/refs可可靠读取归档；已有关联历史/通话不是禁删条件。"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "本租户业务配置管理员",
      "action": "在业务分类Tab选择目标并发起逻辑删除。",
      "system_response": "按原本租户权限展示退出新业务选择及旧业务保留说明，不自动提交。",
      "rule_ids": [
        "BR-041"
      ]
    },
    {
      "step": 2,
      "actor": "云外呼平台",
      "action": "核对权限与当前分类/字段/refs归档数据，说明已有使用的保留影响。",
      "system_response": "历史/active/已有名单任务不拦删除；只有无权或无法可靠准备归档时拒绝。",
      "rule_ids": [
        "BR-040",
        "BR-042"
      ]
    },
    {
      "step": 3,
      "actor": "本租户业务配置管理员",
      "action": "明确确认从新业务可选中移除并保留旧业务归档。",
      "system_response": "取消不提交；确认才进入最终校验。",
      "rule_ids": [
        "BR-040"
      ]
    },
    {
      "step": 4,
      "actor": "云外呼平台",
      "action": "重查权限/配置版本，原子保存原分类及fields/refs归档并标记deleted。",
      "system_response": "保存失败保原对象/草稿；不清历史和已有名单任务，不级联字段/接口。",
      "rule_ids": [
        "BR-040",
        "BR-042"
      ]
    },
    {
      "step": 5,
      "actor": "云外呼平台",
      "action": "反馈逻辑删除成功，从当前配置/新业务选择移除。",
      "system_response": "新建/新导入不能再选；历史与既有任务按归档继续，当前通话保持原版。",
      "rule_ids": [
        "BR-042"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-016-USED",
      "condition": "权限无效，或当前分类/字段信息无法可靠读取归档。",
      "steps": [
        "拒绝本次逻辑删除并说明具体权限或归档问题；历史和通话引用本身不作为拒绝条件。"
      ]
    },
    {
      "id": "ALT-016-CANCEL",
      "condition": "用户在确认前取消。",
      "steps": [
        "保留原分类和数据/草稿，不提交逻辑删除。"
      ]
    },
    {
      "id": "ALT-016-FAIL",
      "condition": "权限/目标配置版本变化，或归档和deleted标记未能原子保存。",
      "steps": [
        "明确逻辑删除未完成，保持原配置/业务/草稿；不得只移除新业务入口却丢失归档。"
      ]
    }
  ],
  "postconditions": [
    "分类已deleted并退出当前配置及新建/新导入可选，刷新不复活。",
    "原分类名/字段/结果/refs归档保留，历史和已有名单任务继续，当前通话/话后仍原版。",
    "字段/接口不级联；字段独立快照不阻挡字段库删除，接口来源保护保留，无恢复/清理/迁移UI。"
  ],
  "acceptance_points": [
    "AC-147：具备本租户业务配置权限的管理员可确认逻辑删除业务分类，不因历史通话、进行中/话后通话或已有业务引用而禁止。目标从当前配置列表和新业务可选项移除，持久标记已删除，不级联删除字段、接口或业务数据。",
    "AC-148：删除时归档该分类当时名称、编码、实际全部refs及其依赖闭包所需字段定义/选项，不复制整租户无关字段库存。历史记录仍按当时分类名称、字段和结果展示；删除前已有已导入名单/任务保留原业务分类并继续处理，不清空、迁移或降为未分类。新建/新导入不得再选择或提交已删除分类，不能凭任意已删除ID冒充已有业务上下文。",
    "AC-149：确认提交前校验本租户权限、目标配置版本及归档可可靠读取/保存。取消、权限或配置版本变化、无法可靠归档/写入失败保留原分类、数据与草稿，不宣称成功；已有业务引用本身仅说明保留影响，不是不可删除条件。",
    "AC-150：正在通话及话后仍按开始时整版配置完成；分类归档不改写原业务/通话/历史，新业务不再选已删分类。归档中的字段定义及refs独立供旧业务使用，不再阻止删除当前字段库定义；所需取数接口来源保留及实时授权仍按原规则。本期无恢复/归档清理/迁移UI。"
  ],
