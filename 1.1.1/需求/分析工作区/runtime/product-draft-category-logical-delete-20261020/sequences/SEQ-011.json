{
  "schema_version": "1.0",
  "id": "SEQ-011",
  "scenario_id": "SC-009",
  "name": "超管编辑已有接口条目时序草稿",
  "status": "product_design_draft",
  "participants": [
    {
      "id": "operator",
      "name": "超级管理员",
      "kind": "actor"
    },
    {
      "id": "frontend",
      "name": "云外呼平台前端",
      "kind": "system"
    },
    {
      "id": "configuration",
      "name": "平台内部配置服务",
      "kind": "system"
    }
  ],
  "messages": [
    {
      "step": 1,
      "from": "operator",
      "to": "frontend",
      "message": "打开已明确条目的编辑操作",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 2,
      "from": "frontend",
      "to": "configuration",
      "message": "读取指定条目当前名称、能力绑定和引用状态",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 3,
      "from": "configuration",
      "to": "frontend",
      "message": "返回条目当前配置与已引用能力固定的约束",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 4,
      "from": "frontend",
      "to": "operator",
      "message": "展示可编辑名称；已引用条目的取数能力固定",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 5,
      "from": "operator",
      "to": "frontend",
      "message": "取消本次编辑",
      "type": "request",
      "api_id": null,
      "condition": "提交前选择取消；与后续提交分支互斥"
    },
    {
      "step": 6,
      "from": "frontend",
      "to": "operator",
      "message": "结束本次编辑，不提交本次变更",
      "type": "response",
      "api_id": null,
      "condition": "提交前取消分支"
    },
    {
      "step": 7,
      "from": "operator",
      "to": "frontend",
      "message": "修改接口名称并提交",
      "type": "request",
      "api_id": null,
      "condition": "提交分支；未选择提交前取消"
    },
    {
      "step": 8,
      "from": "frontend",
      "to": "configuration",
      "message": "提交指定条目的名称变更，沿用其稳定内部标识",
      "type": "request",
      "api_id": null,
      "condition": "提交分支"
    },
    {
      "step": 9,
      "from": "configuration",
      "to": "configuration",
      "message": "校验已引用条目未更换取数能力，尝试保存本次名称变更",
      "type": "internal",
      "api_id": null,
      "condition": "提交分支"
    },
    {
      "step": 10,
      "from": "configuration",
      "to": "frontend",
      "message": "返回名称变更保存成功，条目标识与原字段引用保留",
      "type": "response",
      "api_id": null,
      "condition": "校验通过且本次编辑保存成功"
    },
    {
      "step": 11,
      "from": "frontend",
      "to": "operator",
      "message": "展示本次编辑成功，条目及引用关系保留",
      "type": "response",
      "api_id": null,
      "condition": "本次编辑保存成功"
    },
    {
      "step": 12,
      "from": "configuration",
      "to": "frontend",
      "message": "返回本次编辑未完成；已引用条目更换能力的输入不得保存",
      "type": "response",
      "api_id": null,
      "condition": "试图更换已引用能力或本次编辑保存未成功；与保存成功互斥"
    },
    {
      "step": 13,
      "from": "frontend",
      "to": "operator",
      "message": "提示失败原因；更换能力须新增条目后调整字段引用，不显示编辑成功",
      "type": "response",
      "api_id": null,
      "condition": "本次编辑未完成"
    }
  ],
