{
  "schema_version": "1.0",
  "project_version": "1.1.1",
  "id": "SC-014",
  "name": "删除未使用取数接口字典条目",
  "summary": "超级管理员可在“客户管理→业务分类→取数接口字典”第三Tab，对无使用引用的接口条目发起并确认删除；该字典仍为全局维护，租户授权规则不变，非超管不能执行。",
  "actors": [
    "超级管理员",
    "云外呼平台"
  ],
  "trigger": "有权人员需要清理未使用的取数接口字典条目",
  "preconditions": [
    "当前角色及企业/租户范围有效；删除不扩大权限。",
    "只能在未使用且最终确认无引用时删除。"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "超级管理员",
      "action": "进入“客户管理→业务分类→取数接口字典（第三Tab）”，选择目标并发起删除。",
      "system_response": "核对当前对象、角色及租户范围；不自动提交删除。",
      "rule_ids": [
        "BR-041"
      ]
    },
    {
      "step": 2,
      "actor": "云外呼平台",
      "action": "核对目标的实际配置、依赖、业务数据及当前通话引用/来源保留。",
      "system_response": "存在引用或无法确认时给出阻挡位置并结束；无使用时呈现明确删除确认。",
      "rule_ids": [
        "BR-039"
      ]
    },
    {
      "step": 3,
      "actor": "超级管理员",
      "action": "核对影响并明确确认删除。",
      "system_response": "取消不提交；确认才进入最终校验。",
      "rule_ids": [
        "BR-040"
      ]
    },
    {
      "step": 4,
      "actor": "云外呼平台",
      "action": "重查权限及使用引用，尝试仅删除目标配置。",
      "system_response": "并发变化或保存失败保留原对象；不级联、不改草稿/历史/通话版本。",
      "rule_ids": [
        "BR-039",
        "BR-040"
      ]
    },
    {
      "step": 5,
      "actor": "云外呼平台",
      "action": "反馈目标删除成功，刷新当前列表。",
      "system_response": "重新进入/刷新保持删除，其他配置和业务记录不变。",
      "rule_ids": [
        "BR-040"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-014-USED",
      "condition": "存在使用引用、来源保留或引用状态无法可靠确认。",
      "steps": [
        "拒绝删除并列出可理解的位置/原因，不把预置身份当统一禁令，不清理其他对象。"
      ]
    },
    {
      "id": "ALT-014-CANCEL",
      "condition": "用户在确认前取消。",
      "steps": [
        "保留原对象与草稿，不提交删除。"
      ]
    },
    {
      "id": "ALT-014-FAIL",
      "condition": "最终复核发现新引用/权限变化，或删除未能保存。",
      "steps": [
        "明确本次未删除，保持原对象/草稿，不自动重试或绕过引用。"
      ]
    }
  ],
  "postconditions": [
    "成功仅目标持久删除，不级联、不补默认。",
    "失败/取消/引用存在时保持原对象；通话、历史、其他租户/草稿不变。"
  ],
  "acceptance_points": [
    "AC-139：超级管理员可在“客户管理→业务分类→取数接口字典”第三Tab，对无使用引用的接口条目发起并确认删除；该字典仍为全局维护，租户授权规则不变，非超管不能执行。",
    "AC-140：任一当前字段定义引用该接口（含停用/隐藏/撤权租户中的实际配置）、实际已保存业务数据引用，或进行中/话后未保存通话需要保留其数据来源时，拒绝删除并说明租户、字段/记录或通话等位置。未定类型通话按冻结目录中仍可选类别的可见字段及全部依赖闭包保留来源，直至本通结果保存完成；不假称这些库存字段已经填写，不扫孤立的全字段库存。",
    "AC-141：删除确认时再次核对权限、目标及引用；取消、引用新增、状态变化、读取无法确认或保存失败均不宣称删除成功，也不自动清理别的字段/分类/草稿。进行中通话和历史快照保持原样，不用删除冒充停用/撤权。",
    "AC-142：删除成功后仅移除该未使用条目，刷新/重新进入不读回或自动补默认；不级联删除字段或分类。未初始化租户仅在字典可读且默认来源被明确删除时不生成该来源的默认Mapping字段/引用；停用、撤权或读取异常不当作删除，已有持久配置不重新投影。"
  ],
  "source_story_ids": [
    "US-020"
  ],
  "source_acceptance_ids": [
    "AC-139",
    "AC-140",
    "AC-141",
    "AC-142"
  ],
