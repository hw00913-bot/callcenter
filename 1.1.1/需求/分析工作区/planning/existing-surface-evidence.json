    {
      "path": "prototype/js/pages/business-categories.js",
      "line": 42,
      "text": "    return `<div class=\"business-config-links\" role=\"tablist\" aria-label=\"业务分类配置\">${Object.keys(kindNames).map(key=>`<button type=\"button\" class=\"btn ${kind===key?'btn-primary':''}\" role=\"tab\" aria-selected=\"${kind===key}\" onclick=\"BusinessConfiguration.selectKind('${key}')\">${kindNames[key]}</button>`).join('')}</div>`;",
