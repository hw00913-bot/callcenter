  "name": "超管新增业务数据接口条目时序草稿",
  "status": "product_design_draft",
  "participants": [
    {
      "id": "operator",
      "name": "超级管理员",
      "kind": "actor"
    },
    {
      "id": "frontend",
      "name": "云外呼平台前端",
      "kind": "system"
    },
    {
      "id": "configuration",
      "name": "平台内部配置服务",
      "kind": "system"
    }
  ],
  "messages": [
    {
      "step": 1,
      "from": "operator",
      "to": "frontend",
      "message": "发起新增业务数据接口条目",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 2,
      "from": "frontend",
      "to": "configuration",
      "message": "读取已预置的取数能力与可配置租户选项",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 3,
      "from": "configuration",
      "to": "frontend",
      "message": "返回预置能力与租户选项",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 4,
      "from": "frontend",
      "to": "operator",
      "message": "展示接口名称、取数能力、可用租户、启用状态四项配置；内部标识由系统生成",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 5,
      "from": "operator",
      "to": "frontend",
      "message": "取消本次新增",
      "type": "request",
      "api_id": null,
      "condition": "提交前选择取消；与后续提交分支互斥"
    },
    {
      "step": 6,
      "from": "frontend",
      "to": "operator",
      "message": "结束本次新增，不提交本次变更",
      "type": "response",
      "api_id": null,
      "condition": "提交前取消分支"
    },
    {
      "step": 7,
      "from": "operator",
      "to": "frontend",
      "message": "填写名称、选择能力、勾选租户、设置状态并提交",
      "type": "request",
      "api_id": null,
      "condition": "提交分支；未选择提交前取消"
    },
    {
      "step": 8,
      "from": "frontend",
      "to": "configuration",
      "message": "提交本次四项字典配置",
      "type": "request",
      "api_id": null,
      "condition": "提交分支"
    },
    {
      "step": 9,
      "from": "configuration",
      "to": "configuration",
      "message": "校验名称必填/60字/全局不重名；允许同能力不同条目，生成稳定标识并保存四项配置",
      "type": "internal",
      "api_id": null,
      "condition": "提交分支"
    },
    {
      "step": 10,
      "from": "configuration",
      "to": "frontend",
      "message": "返回新增条目保存成功与系统生成的条目标识",
      "type": "response",
      "api_id": null,
      "condition": "本次新增保存成功"
    },
    {
      "step": 11,
      "from": "frontend",
      "to": "operator",
      "message": "展示新增成功；实际使用仍受启停状态与租户授权约束",
      "type": "response",
      "api_id": null,
      "condition": "本次新增保存成功"
    },
    {
      "step": 12,
      "from": "configuration",
      "to": "frontend",
      "message": "返回本次新增未保存成功",
      "type": "response",
      "api_id": null,
      "condition": "本次新增保存未成功；与新增成功互斥"
    },
    {
      "step": 13,
      "from": "frontend",
      "to": "operator",
      "message": "明确提示本次新增未完成，不显示新增成功",
      "type": "response",
      "api_id": null,
      "condition": "本次新增保存未成功"
    }
  ],
