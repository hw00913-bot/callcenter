  ],
  "messages": [
    {
      "step": 1,
      "from": "operator",
      "to": "frontend",
      "message": "打开已明确条目的编辑操作",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 2,
      "from": "frontend",
      "to": "configuration",
      "message": "读取指定条目当前名称、能力绑定和引用状态",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 3,
      "from": "configuration",
      "to": "frontend",
      "message": "返回当前配置与实际及保留引用状态；无引用可换能力，已引用或无法核对则固定",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 4,
      "from": "frontend",
      "to": "operator",
      "message": "展示名称编辑与能力可选/锁定状态及原因",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 5,
      "from": "operator",
      "to": "frontend",
      "message": "取消本次编辑",
      "type": "request",
      "api_id": null,
      "condition": "提交前选择取消；与后续提交分支互斥"
    },
    {
      "step": 6,
      "from": "frontend",
      "to": "operator",
      "message": "结束本次编辑，不提交本次变更",
      "type": "response",
      "api_id": null,
      "condition": "提交前取消分支"
    },
    {
      "step": 7,
      "from": "operator",
      "to": "frontend",
      "message": "修改名称，或在无引用时选择另一能力并提交",
      "type": "request",
      "api_id": null,
      "condition": "提交分支；未选择提交前取消"
    },
    {
      "step": 8,
      "from": "frontend",
      "to": "configuration",
      "message": "沿稳定内部标识提交名称及本次能力选择",
      "type": "request",
      "api_id": null,
      "condition": "提交分支"
    },
    {
      "step": 9,
      "from": "configuration",
      "to": "configuration",
      "message": "重查名称规则和全部引用；无引用才换能力，有新增引用则拒绝换源并保留配置",
      "type": "internal",
      "api_id": null,
      "condition": "提交分支"
    },
    {
      "step": 10,
      "from": "configuration",
      "to": "frontend",
      "message": "返回编辑成功，条目标识及已有引用保持",
      "type": "response",
      "api_id": null,
      "condition": "校验通过且本次编辑保存成功"
    },
    {
      "step": 11,
      "from": "frontend",
      "to": "operator",
      "message": "展示本次编辑成功，条目及引用关系保留",
      "type": "response",
      "api_id": null,
      "condition": "本次编辑保存成功"
    },
    {
      "step": 12,
      "from": "configuration",
      "to": "frontend",
      "message": "返回编辑未完成：名称校验、引用变化/无法核对或保存失败",
      "type": "response",
      "api_id": null,
      "condition": "试图更换已引用能力或本次编辑保存未成功；与保存成功互斥"
    },
    {
      "step": 13,
      "from": "frontend",
      "to": "operator",
      "message": "保留输入并提示失败原因；已引用能力更换需新增条目后调整字段引用",
      "type": "response",
      "api_id": null,
      "condition": "本次编辑未完成"
    }
  ],
