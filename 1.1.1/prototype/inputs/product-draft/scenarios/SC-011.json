{
  "schema_version": "1.0",
  "project_version": "1.1.1",
  "id": "SC-011",
  "name": "超管配置接口可用租户及撤销授权",
  "summary": "管理接口条目与租户之间的使用范围。",
  "actors": [
    "超级管理员",
    "云外呼平台"
  ],
  "trigger": "需要向指定租户开放接口，或取消该接口对某租户的使用授权。",
  "preconditions": [
    "当前操作者具有超管维护业务数据接口字典的权限。",
    "本次配置针对同一个已明确的接口字典条目；超管勾选该条目的可用租户。"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "超级管理员",
      "action": "发起指定接口条目的可用租户配置。",
      "system_response": "平台进入该接口的租户授权维护。",
      "rule_ids": [
        "BR-023"
      ]
    },
    {
      "step": 2,
      "actor": "云外呼平台",
      "action": "呈现该条目的已有可用租户配置。",
      "system_response": "明确本次授权调整所针对的接口与租户范围。",
      "rule_ids": [
        "BR-024",
        "BR-025"
      ]
    },
    {
      "step": 3,
      "actor": "超级管理员",
      "action": "调整可用租户勾选并提交本次配置。",
      "system_response": "一次提交可包含开放及取消某些租户的授权。",
      "rule_ids": [
        "BR-024",
        "BR-025"
      ]
    },
    {
      "step": 4,
      "actor": "云外呼平台",
      "action": "保存本次接口条目的可用租户配置。",
      "system_response": "形成明确的授权范围保存结果。",
      "rule_ids": [
        "BR-024"
      ]
    },
    {
      "step": 5,
      "actor": "云外呼平台",
      "action": "若本次包含撤销授权，在撤销生效后停止该接口对对应租户的新查询和新选择；保留历史数据及字段配置，标记对应引用不可用。",
      "system_response": "仅对应接口与租户：未提交值保留显示但不作有效值；在途结果不新选，选填可清除后保存；其它授权不受影响。",
      "rule_ids": [
        "BR-023",
        "BR-025"
      ]
    },
    {
      "step": 6,
      "actor": "云外呼平台",
      "action": "显示本次可用租户配置保存结果。",
      "system_response": "租户仅可引用已授权条目，成员权限不扩大；重新授权不自动恢复未提交旧值，需在SC-013重查确认。",
      "rule_ids": [
        "BR-024",
        "BR-025",
        "BR-036"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-SC011-CANCEL",
      "condition": "操作者在提交前取消本次可用租户配置。",
      "steps": [
        "结束本次操作，不提交此次授权范围变更。"
      ]
    },
    {
      "id": "ALT-SC011-FAIL",
      "condition": "本次可用租户配置未保存成功。",
      "steps": [
        "平台反馈本次配置未完成，不显示授权范围保存成功。",
        "不据失败提示假定未知超时结果或决定在途请求、未提交值的恢复方式。"
      ]
    },
    {
      "id": "ALT-SC011-NO-REVOKE",
      "condition": "本次成功保存的调整不包含撤销授权。",
      "steps": [
        "保留本次已保存授权范围，跳过撤销影响处理。",
        "直接呈现本次配置结果，租户实际使用仍受条目状态约束。"
      ]
    }
  ],
  "postconditions": [
    "成功路径形成该接口条目的已保存可用租户范围。",
    "若含撤销，生效后停止对应接口与租户的新查询和新选择；历史及配置保留，对应引用标记不可用。",
    "本次授权调整不全局停用接口，不扩大成员字段配置权限，也不取消其它有效授权。",
    "取消或保存失败不呈现本次授权成功；撤销已生效时的在途及未提交值按SRC-148处理。"
  ],
  "acceptance_points": [
    "AC-107：超管可以勾选并保存接口条目的可用租户。",
    "AC-108：租户新增字段引用时仅可选择已向本租户开放的条目，不自动取得字段配置权限。",
    "AC-122：撤销生效后限制对应接口与租户的新查询和新选择，作用范围不扩散。",
    "AC-123：历史及原引用配置保留；未提交值显示不可用不有效提交，在途不新选；选填可清除后保存，不禁用整个表单。"
  ],
  "source_story_ids": [
    "US-014"
  ],
  "source_acceptance_ids": [
    "AC-107",
    "AC-108",
    "AC-122",
    "AC-123"
  ],
  "source_refs": [
    "inputs/user-stories.md#SRC-128",
    "inputs/user-stories.md#SRC-139",
    "inputs/user-stories.md#SRC-141",
    "inputs/user-stories.md#SRC-135",
    "inputs/user-stories.md#SRC-148",
    "inputs/user-stories.md#SRC-149"
  ],
  "open_item_ids": [
    "ISSUE-11105"
  ],
  "notes": [
    "撤销只影响对应接口与租户，不扩大成员字段权限或取消其它租户授权。",
    "撤权的在途及未提交值按SRC-148；重新授权后旧值在SC-013重查并人工确认，真实鉴权契约仍待核验。"
  ],
