        "BR-032",
        "BR-036"
      ]
    },
    {
      "step": 11,
      "actor": "云外呼平台",
      "action": "各本次意向字段分别保存编码及当时名称；原导入值和原计划到店字段保留",
      "system_response": null,
      "rule_ids": [
