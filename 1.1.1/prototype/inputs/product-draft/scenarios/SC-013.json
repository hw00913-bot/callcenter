  "alternate_flows": [
    {
      "id": "ALT-01301",
      "condition": "条目不可用或租户授权已撤销",
      "steps": [
        "仅对应接口／租户停止新查选；历史配置保留。",
        "未提交值保留显示但不作有效值提交，在途结果不再提供新选择；选填可手动清除后保存，必填沿原规则。"
      ]
    },
    {
      "id": "ALT-01302",
      "condition": "所有关联车系字段均未选择",
      "steps": [
        "提示请先选择至少一个车系，不发起门店查询。",
        "若清空了原有全部车系，原门店保留显示并待重选；不因查询前置条件将字段统一必填，保存仍按原规则。"
      ]
    },
    {
      "id": "ALT-01303",
      "condition": "车系查询失败且造成本次需校验的必填无法完成",
      "steps": [
        "说明失败并保留已填草稿供后续重试，完成前补齐有效必填。",
        "本图为单次尝试，重试可在草稿上下文重新进入；不承诺自动重试或特定持久化。"
      ]
    },
    {
      "id": "ALT-01304",
      "condition": "门店查询失败／部分失败且造成本次需校验的必填无法完成",
      "steps": [
        "保留已填内容，说明失败或查询未完整，查全后才允许新的门店选择。",
        "失败不当作成功空集合，也不证明旧门店失配；当前有效必填缺失时不能完成保存。"
      ]
    },
    {
      "id": "ALT-01305",
      "condition": "查询失败但不造成本次需校验的必填无法完成",
      "steps": [
        "不因一次失败一律禁存，仍按当前条件下的有效值与原保存规则判断。",
        "部分失败时暂停新的门店选择，保留输入供重试，不把旧条件验证结果当成新条件的有效依据。"
      ]
    },
    {
      "id": "ALT-01306",
      "condition": "原有效门店不在新的完整并集中",
      "steps": [
        "保留显示并标记待重选；不作为有效已选值提交或回传。",
        "可以选择当前候选恢复有效；是否必填仍由分类和原通话条件决定。"
      ]
    },
    {
      "id": "ALT-01307",
      "condition": "旧门店待重选或来源恢复后，按当前条件重新查询并匹配",
      "steps": [
        "当前条件查全并匹配时，旧值仍保持待确认，不自动恢复有效。",
        "客服再次明确确认或选择当前有效候选才恢复；失败、部分失败、不匹配均不能直接恢复。"
      ]
    },
    {
      "id": "ALT-01308",
      "condition": "完整查询成功但结果为空",
      "steps": [
        "提示暂无匹配门店，不提供自定义门店补齐。",
        "选填可留空或清除本次无效值后按原规则提交；必填缺失继续阻止完成。",
        "搜索词无结果或当前分页未出现旧门店不能直接判关系失配。"
      ]
    },
    {
      "id": "ALT-01309",
      "condition": "客服暂不提交",
      "steps": [
        "保留当前编辑，不产生正式保存结果；不新增独立草稿页。"
      ]
    },
    {
      "id": "ALT-01310",
      "condition": "必填缺失、已填值无效或原有保存条件不满足",
      "steps": [
        "说明具体问题并保留输入；修正后可再次提交。",
        "明确已结束外呼客户未接时沿v1.1.0条件必填豁免，已填值仍校验；未知、呼入或仅坐席未接不能直接套用。"
      ]
    },
    {
      "id": "ALT-01311",
      "condition": "正式保存失败",
      "steps": [
        "保留本次输入和原状态，不虚构成功；可后续重试。"
      ]
    },
    {
      "id": "ALT-01312",
      "condition": "本轮无需检索，保留已有有效车系或选填留空",
      "steps": [
        "已有有效车系可复用；选填未选时可继续至无车系查询提示及统一保存校验，不强制重新检索。",
        "不恢复失效值，也不把原始意向未经确认带入。"
      ]
    },
    {
      "id": "ALT-01313",
      "condition": "关联车系已有选择但无有效查询编码",
      "steps": [
        "不以无效编码查询或推断全部门店；编码有效性由实际接口契约核验。",
        "保留输入并提示核对，完成保存仍按已填值有效性与分类必填判断。"
      ]
    }
  ],
  "postconditions": [
    "成功路径按每个本次意向字段保存有效编码与当时名称，历史名称保持，不覆盖原导入值。",
    "失配旧门店保留显示并待重选，不作有效值提交。",
    "失败分支按适用条件保留输入或草稿；未决分支不伪装为已定策略。"
  ],
