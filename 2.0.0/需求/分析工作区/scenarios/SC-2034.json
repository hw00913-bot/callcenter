{
  "schema_version": "1.0",
  "id": "SC-2034",
  "name": "超管按品牌租户分类监管业务数据",
  "status": "proposed_flow",
  "summary": "监管资格过滤同一台账及轨迹，不冒用业务租户身份，不自动授代处理权。",
  "actors": [
    "平台超级管理员",
    "D联络云"
  ],
  "trigger": "超管需要查看所管理品牌/租户/分类业务情况",
  "preconditions": [
    "已登录且具有本次数据查看资格。",
    "监管和业务共享同一记录，权限分别核对。",
    "沿用 AI 生产身份和稳定租户/对象标识；直接访问与菜单采用同一当前操作授权校验，不按名称、手机号或品牌关系合并身份或授权。",
    "按当前平台管理/品牌配置/监管职责及实际对象范围验权；不以业务租户成员、本人电话坐席或同时开通 AI 与云呼叫作为配置/监管前提，不因此获得代处理或其他数据访问权。",
    "监管和业务查看分别按实际授权及历史截止核验；不以本人坐席或双模块为只读前提，不授代处理权。",
    "业务中心整合已确认的分类、规则、导入批次、业务台账、分配及记录处理入口，复用同一业务记录和原执行/详情跳转；不复制客户档案、任务或专业配置，不改变当前负责租户、原动作资格、固定版本和历史可见边界。"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "平台超级管理员",
      "action": "进入业务中心的统一业务数据工作区。",
      "system_response": "按登录身份选监管或业务视角。",
      "rule_ids": [
        "BR-2041",
        "BR-2045",
        "BR-2052",
        "BR-2054"
      ]
    },
    {
      "step": 2,
      "actor": "D联络云",
      "action": "核定本次可见品牌、租户、分类及历史范围。",
      "system_response": "共享配置不赋予全品牌数据权。 按本操作管理/品牌/监管职责校验；不要求业务成员、电话坐席或双模块开通，不授代执行权。",
      "rule_ids": [
        "BR-2041",
        "BR-2045",
        "BR-2052",
        "BR-2054"
      ]
    },
    {
      "step": 3,
      "actor": "平台超级管理员",
      "action": "按有权范围筛选分类、租户或导入批次并查询。",
      "system_response": "菜单与直接访问执行同一权限。",
      "rule_ids": [
        "BR-2041",
        "BR-2045",
        "BR-2052",
        "BR-2054"
      ]
    },
    {
      "step": 4,
      "actor": "D联络云",
      "action": "读取同一台账和有权批次，区分新模型和存量。",
      "system_response": "读取同一原台账及有权批次；新模型按BASE/ROUTE/单模板和各字段定义/选项/结果快照区分，存量仍原查询和原处理，不补建实例或迁移。读取失败/关联待核不以空态代替。",
      "rule_ids": [
        "BR-2041",
        "BR-2045",
        "BR-2052",
        "BR-2054"
      ]
    },
    {
      "step": 5,
      "actor": "平台超级管理员",
      "action": "查看查询结果并选择一条记录打开详情。",
      "system_response": "没有记录时展示真实空状态。",
      "rule_ids": [
        "BR-2041",
        "BR-2045",
        "BR-2052",
        "BR-2054"
      ]
    },
    {
      "step": 6,
      "actor": "D联络云",
      "action": "重新核定详情权限，按分类快照、当前归属/历史截止和原版本展示。",
      "system_response": "只读监管当前授权品牌/租户交集内的同一记录和真实轨迹；展示固定单模板、分类字段、意向/人工指派/目标状态，逐路径依据仅在实际可见范围内。不代HQ管理员选店，不启动/分配/转交/补录，不扩大源录音、存量或截止历史范围。",
      "rule_ids": [
        "BR-2041",
        "BR-2045",
        "BR-2052",
        "BR-2054"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-2034-DENY",
      "condition": "无权查询或伪造直接链接",
      "steps": [
        "拒绝访问，不能跨范围泄露记录。"
      ]
    },
    {
      "id": "ALT-2034-READ",
      "condition": "读取失败或结果待核",
      "steps": [
        "显示失败/待核，不把读取失败展示成没有记录。"
      ]
    },
    {
      "id": "ALT-2034-EMPTY",
      "condition": "成功查询但没有匹配记录",
      "steps": [
        "展示真实空状态，可调整条件另次查询。"
      ]
    },
    {
      "id": "ALT-2034-DETAIL",
      "condition": "打开详情时资格变化或读取失败",
      "steps": [
        "详情再次鉴权和读取，不展示旧缓存冒充有权当前详情。",
        "详情打开时再次核范围、当前身份及原快照；失权或无法可靠读取不展示过期缓存，不依品牌共用推全品牌权。"
      ]
    }
  ],
  "postconditions": [
    "按实际权限和历史快照展示真实结果，不改变归属、执行、模板或旧数据模型。"
  ],
  "acceptance_points": [
    "AC-2129：超管具有所管理品牌/租户/分类的监管查看视角，菜单、列表、详情与直接访问资格一致；监管查看不自动赋予业务代处理权限。",
    "AC-2130：监管查询和业务处理读取同一记录及实际轨迹，不需要冒用业务租户身份或建立第二份线索表。"
  ],
