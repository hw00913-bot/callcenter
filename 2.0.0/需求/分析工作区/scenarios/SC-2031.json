{
  "schema_version": "1.0",
  "id": "SC-2031",
  "name": "租户内分配业务记录至坐席或任务",
  "status": "proposed_flow",
  "summary": "核本租户归属、节点/记录版本、方式和共同资源后分配执行责任；原批次多选逐行复核，任一行失败全批不写。分配不改租户、不自动呼叫。",
  "actors": [
    "本租户具备分配权限的人员",
    "D联络云"
  ],
  "trigger": "当前负责租户需要将记录安排给坐席或已有任务",
  "preconditions": [
    "当前记录是新模板机制记录且处于允许分配的节点。",
    "旧数据仍走原分配和原处理；当前方案沿用租户管理员分配资格。",
    "沿用 AI 生产身份和稳定租户/对象标识；直接访问与菜单采用同一当前操作授权校验，不按名称、手机号或品牌关系合并身份或授权。",
    "业务中心整合已确认的分类、规则、导入批次、业务台账、分配及记录处理入口，复用同一业务记录和原执行/详情跳转；不复制客户档案、任务或专业配置，不改变当前负责租户、原动作资格、固定版本和历史可见边界。"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "本租户具备分配权限的人员",
      "action": "从业务中心台账、批次或详情选择一条记录或原批次多选记录，发起本租户执行分配。",
      "system_response": "不另建客户副本。",
      "rule_ids": [
        "BR-2043",
        "BR-2047",
        "BR-2048",
        "BR-2049",
        "BR-2052"
      ]
    },
    {
      "step": 2,
      "actor": "D联络云",
      "action": "展示当前节点、负责租户和可用坐席/任务。",
      "system_response": "只展示当前负责租户、本次节点允许方式及共同合法坐席/任务；门店目标指派仍仅SC-2026同次转交，不由本分配承载。单条和批次均不是自动启动。",
      "rule_ids": [
        "BR-2043",
        "BR-2047",
        "BR-2048",
        "BR-2049",
        "BR-2052"
      ]
    },
    {
      "step": 3,
      "actor": "本租户具备分配权限的人员",
      "action": "选择本租户共同合法坐席或已有任务，核对本次单条或多条名单并确认。",
      "system_response": "只安排执行责任，不等于启动处理。",
      "rule_ids": [
        "BR-2043",
        "BR-2047",
        "BR-2048",
        "BR-2049",
        "BR-2052"
      ]
    },
    {
      "step": 4,
      "actor": "D联络云",
      "action": "提交逐条重核当前owner、节点/记录及安排版本、原分配资格、所选方式和共同资源，并确认无在途并行；所有行校验完成后才进入同次保存。",
      "system_response": "任一行过期、无权、已转交、节点/方式不符或共同资源不可用，全批均不写且逐行反馈原因；不是先写合法行。只核本次安排和资源，不强制双模块；实际起呼另核所选方式及本租户禁呼。",
      "rule_ids": [
        "BR-2043",
        "BR-2047",
        "BR-2048",
        "BR-2049",
        "BR-2052"
      ]
    },
    {
      "step": 5,
      "actor": "D联络云",
      "action": "在同次请求中一致保存全部所选记录的本租户执行安排与轨迹；不改变owner、单模板版本或节点指针。",
      "system_response": "共同资源和所有行版本通过才整批提交；失败无半分配，响应未知先核同次结果，重复请求不重复分配。任务仍待当前有权人员主动启动。",
      "rule_ids": [
        "BR-2043",
        "BR-2047",
        "BR-2048",
        "BR-2049",
        "BR-2052"
      ]
    },
    {
      "step": 6,
      "actor": "D联络云",
      "action": "反馈分配结果，人员再按节点启动既有处理。",
      "system_response": "跨租户需求改用合法转交节点，不能用分配替代。",
      "rule_ids": [
        "BR-2043",
        "BR-2047",
        "BR-2048",
        "BR-2049",
        "BR-2052"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-2031-CANCEL",
      "condition": "提交前取消本次操作",
      "steps": [
        "不提交本次请求，不改变记录或配置。"
      ]
    },
    {
      "id": "ALT-2031-INVALID",
      "condition": "单条或所选批次任一行的原资格、owner/节点/记录版本、方式或共同资源不满足。",
      "steps": [
        "逐条复核后反馈本次原因；任一行失败则所有行均未写入，不产生部分成功或半分配。",
        "保原执行安排及归属；清除旧目标/过期选择后可由仍有权人员另次发起，不转作跨租户或自动呼叫。"
      ]
    },
    {
      "id": "ALT-2031-UNKNOWN",
      "condition": "读写失败或本次结果不能确定",
      "steps": [
        "不展示成功；区分明确失败和结果待核。",
        "结果待核先核对同次请求的实际结果，不能用新请求重复创建或推进。",
        "批量请求也按同次请求和所选记录集合核对真实结果；不因未知另建第二次分配或把未确认行冒充成功。"
      ]
    }
  ],
  "postconditions": [
    "租户内分配完成，等待人员启动",
    "取消、校验不通过或未确认成功时，不伪造本次业务成功。",
    "分配不解禁、不切租户、不换实例版本；停用人员不能以旧分配新增操作。"
  ],
  "acceptance_points": [
    "AC-2118：租户内分配坐席或加入任务不改变负责租户；跨租户归属转交作为不同业务动作执行并留痕。",
    "AC-2119：分配时核对当前归属、人员资格、分类节点允许方式、记录/安排版本及本租户任务/坐席资源；过期或无权不改变记录。复用原批次多选分配时逐条复核，共同资源合法后同次提交，任一行失败全批不写，不以分配代替租户转交或自动启动。"
  ],
