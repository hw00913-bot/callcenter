{
  "schema_version": "1.0",
  "id": "SC-2004",
  "name": "维护已有公共租户资料及品牌归属",
  "status": "proposed_flow",
  "summary": "基础资料共用，品牌归属合法且有变更留痕",
  "actors": [
    "有租户资料权人员／有归属权限超管",
    "D联络云"
  ],
  "trigger": "补齐已有未关联租户的首次品牌归属，或维护已有租户资料与合法归属",
  "preconditions": [
    "维护对象为 AI 生产身份基准下的已有租户；新建租户及同次品牌关联另由 SC-2036 办理。",
    "基础资料按原独立权限及租户范围维护；品牌、总部/门店身份及业务门店编码仅有权超管维护，租户管理员只读本租户归属。",
    "已有历史且未绑定品牌允许首次绑定；绑定后有线索的品牌与总部/门店身份锁定。同原关系重提不视为更换，不迁移或初始化旧线索。",
    "存量未关联租户继续原功能、标待补关联；普通资料维护不强制先补品牌。管理配置不要求业务成员、本人坐席或双模块，不授业务数据权。",
    "入口由系统管理承接原账号、成员、租户或品牌的相应功能，仍沿原对象权限、管理范围和稳定PAGE；该原管理功能的切离保护、同窗口返回及同次登录记忆继续按SC-2002，不因入口归位新增管理权。",
    "每品牌总部关联唯一性不因总部停用而释放；有效转交目标另核，不以停用允许第二总部。是否已有线索无法可靠核定时不能按无历史放行。",
    "storeCode沿原品牌—门店关联维护，保留前导零及版本，品牌内唯一；补码不解除既有brand/HQ-STORE锁定、不迁移历史或改客户意向。"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "有租户资料权人员／有归属权限超管",
      "action": "从系统管理的原有权入口打开已有租户，选择本次基础资料或品牌归属维护",
      "system_response": "定位同一稳定租户；本场景不创建新租户。",
      "rule_ids": [
        "BR-2001",
        "BR-2011"
      ]
    },
    {
      "step": 2,
      "actor": "D联络云",
      "action": "按操作核资料维护范围或品牌归属超管职责",
      "system_response": "普通资料权不能夹带品牌、总部/门店身份和业务编码改动；无业务成员或双模块不因此拒绝合法管理。",
      "rule_ids": [
        "BR-2003",
        "BR-2012"
      ]
    },
    {
      "step": 3,
      "actor": "有租户资料权人员／有归属权限超管",
      "action": "维护获权字段；归属操作核品牌、总部/门店身份及门店编码后提交",
      "system_response": "普通资料不动原归属；超管可为未绑定租户首次选择品牌和身份，门店可登记字符串 storeCode；名称不是路由键。",
      "rule_ids": [
        "BR-2011",
        "BR-2039"
      ]
    },
    {
      "step": 4,
      "actor": "D联络云",
      "action": "提交时复核权限、单品牌、唯一总部、历史锁定及门店编码唯一映射",
      "system_response": "已有历史未绑定可首次绑定；有历史且已绑定禁止更换品牌或身份。同原归属重提不误判；普通资料可保持待补关联。填写门店编码须品牌内唯一且指向独立门店，不按名称寻址。 历史是否存在待核时不当无历史；停用总部仍占唯一总部关联。storeCode保前导零、品牌内唯一及映射版本，普通资料权不能夹带补码。",
      "rule_ids": [
        "BR-2011",
        "BR-2012",
        "BR-2039"
      ]
    },
    {
      "step": 5,
      "actor": "D联络云",
      "action": "可靠保存本次获权资料或合法归属变化并留审计",
      "system_response": "留前后值、人员、时间；普通资料不能夹带改归属，首次绑定不迁移旧历史，不回盖模块专属资源。失败/结果不明不报成功。 门店映射变更只影响之后合法核验，不回写历史转交目标或人工指派来源。",
      "rule_ids": [
        "BR-2011",
        "BR-2012"
      ]
    },
    {
      "step": 6,
      "actor": "D联络云",
      "action": "反馈结果，由 AI 与云呼叫引用同一租户基础资料",
      "system_response": "账号、电话坐席、供应商账号、机器人分别映射；品牌关系不自动共享名单、线索或触发转交；未绑定租户保留原功能。",
      "rule_ids": [
        "BR-2001",
        "BR-2012"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-2004-AUTH",
      "condition": "对象范围或本次操作资格不成立。",
      "steps": [
        "拒绝写入，按原范围只读；资料权不扩大为归属维护权。"
      ]
    },
    {
      "id": "ALT-2004-CANCEL",
      "condition": "提交前取消。",
      "steps": [
        "本次不提交、不保存，原记录保持。"
      ]
    },
    {
      "id": "ALT-2004-INVALID",
      "condition": "唯一总部、单品牌、历史锁定、资料或门店编码映射不符。",
      "steps": [
        "保留输入及原记录，不因已有历史而拒绝未绑定租户首次关联。",
        "门店编码必须本品牌唯一且对应独立门店；不能按名称替代或自动扩大关联范围。",
        "历史/品牌关系或映射版本无法可靠核定时保留原资料；停用总部不能作为绑定第二总部的依据，门店码补齐不改原身份或历史。"
      ]
    },
    {
      "id": "ALT-2004-UNKNOWN",
      "condition": "保存失败或同次结果无法确认。",
      "steps": [
        "不展示成功；先核同次结果，不用新请求重复保存或覆盖最新记录。"
      ]
    }
  ],
  "postconditions": [
    "两模块共用同一已有租户基础资料，AI 身份及历史保留；本场景不创建新租户。",
    "首次合法绑定可保存，有线索绑定后品牌/身份锁定，不初始化历史线索；归属/门店编码变化留痕。",
    "资料维护与归属权限分离，品牌配置不产生全量业务数据权，待补关联不影响原功能。",
    "取消、校验不通过、失败或待核不宣称成功。"
  ],
  "acceptance_points": [
    "AC-2016：两模块共用同一业务租户及基础资料，AI生产身份及历史关系优先延续。",
    "AC-2017：各模块供应商资源、专属配置及业务数据按原规则管理；账号、电话坐席、供应商账号和机器人分别映射。",
    "AC-2018：新建业务租户须关联品牌；存量未关联租户保留原有功能并标记待补关联。",
    "AC-2036：新建业务租户品牌必填；存量未关联租户保留原有功能。已有历史线索但无品牌的租户允许首次绑定，绑定后有线索时禁止更换品牌及总部/门店身份；不补品牌、初始化轮次或迁移旧线索。",
    "AC-2037：品牌关联变更保留前后信息、操作人和时间；品牌相同不自动共享线索/名单、授予总部品牌全量查看或触发转交。跨租户线索仅按独立的本次转交规则办理，普通租户资料编辑不得绕过归属与身份锁定。",
    "AC-2035：关联成功的每个租户只对应一个接入品牌。",
    "AC-2081：同一接入品牌可关联多个租户。",
    "AC-2082：每品牌对应一个总部租户及多个独立门店租户。",
    "AC-2083：租户所属品牌由平台超级管理员统一维护。"
  ],
