{
  "schema_version": "1.0",
  "id": "SC-2003",
  "name": "退出统一系统身份",
  "summary": "合法退出，两模块受保护访问需重新认证",
  "actors": [
    "当前登录账号",
    "退出前保护",
    "统一身份及两工作区会话"
  ],
  "trigger": "结束登录使用",
  "preconditions": [
    "账号处于登录状态；退出保护属于 US-2002 的设计候选，具体会话失效机制待 ISSUE-2001/2002。"
  ],
  "expected_outcome": "合法退出，两模块受保护访问需重新认证",
  "exception_scope": "在途电话、未保存内容、两模块会话失效点待核",
  "source_story_ids": [
    "US-2002"
  ],
  "source_acceptance_ids": [
    "AC-2005",
    "AC-2006"
  ],
  "source_refs": [
    "inputs/source-index.json#SRC-2002",
    "inputs/source-index.json#SRC-2007",
    "inputs/source-index.json#SRC-2040",
    "inputs/source-index.json#SRC-2086",
    "inputs/source-index.json#SRC-2088",
    "inputs/source-index.json#SRC-2094"
  ],
  "scope": "in_scope",
  "status": "proposed_flow",
  "notes": "G1仅确认场景范围；统一退出及保护细节仍是设计候选。图中“两模块退出确认”表达目标结果，未定义令牌、接口、广播、超时或具体退出时点；未新增退出审批。 退出统一身份属于切离本人电话现场，按SRC-2040沿原收尾离线；同Cloud页面间保留原电话条不等于可以略过统一退出保护。 本轮SRC-2086仅确认37场景及三项整合修订；当前为S3流程草案，不表示G2/G3批准、生产实现或原型修改。",
  "main_flow": [
    {
      "step": 1,
      "actor": "当前登录账号",
      "action": "请求退出统一系统",
      "system_response": "启动本次退出前检查。",
      "rule_ids": []
    },
    {
      "step": 2,
      "actor": "退出前保护",
      "action": "检查本人电话及话后事项",
      "system_response": "退出统一身份前沿原规则完成本人通话、必要话后并确认电话离线；本人确无会话不依据他人坐席状态阻拦，状态未知/离线失败保留现场。",
      "rule_ids": []
    },
    {
      "step": 3,
      "actor": "当前登录账号",
      "action": "处理普通未保存输入",
      "system_response": "无未保存输入或用户成功保存／明确放弃后继续；取消或保存失败则结束本次退出。",
      "rule_ids": []
    },
    {
      "step": 4,
      "actor": "统一身份及两工作区会话",
      "action": "执行统一退出目标",
      "system_response": "以同一身份覆盖AI及云呼叫受保护访问；实际失效机制不在此臆造。",
      "rule_ids": []
    },
    {
      "step": 5,
      "actor": "统一身份及两工作区会话",
      "action": "按实际结果反馈",
      "system_response": "仅在两模块退出均可确认时显示完成，再次访问受保护内容须重新登录。",
      "rule_ids": []
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-2003-01",
      "condition": "仍有电话或话后事项待处理",
      "steps": [
        "保留当前现场并提示先处理，不直接丢失输入或默认挂断；完成后用户重新发起退出。"
      ]
    },
    {
      "id": "ALT-2003-02",
      "condition": "普通未保存内容选择保存",
      "steps": [
        "按原流程保存，成功再继续退出。"
      ]
    },
    {
      "id": "ALT-2003-03",
      "condition": "普通未保存内容选择放弃",
      "steps": [
        "放弃明确选定的未保存内容后继续。"
      ]
    },
    {
      "id": "ALT-2003-04",
      "condition": "用户取消退出",
      "steps": [
        "保留当前登录及输入，结束本次请求。"
      ]
    },
    {
      "id": "ALT-2003-05",
      "condition": "退出前保存失败",
      "steps": [
        "保留输入并反馈保存失败，不继续退出。"
      ]
    },
    {
      "id": "ALT-2003-06",
      "condition": "退出明确失败",
      "steps": [
        "反馈未完成；不把仍有效的实际会话表述为已失效。"
      ]
    },
    {
      "id": "ALT-2003-07",
      "condition": "部分会话退出或结果无法确认",
      "steps": [
        "按实际已知结果反馈，不能声称两模块统一退出完成；剩余会话失效和恢复处理由 ISSUE-2001/2002 核验。"
      ]
    }
  ],
  "postconditions": [
    "成功退出后的业务目标是两模块受保护访问均要求重新登录；具体失效点未冻结。",
    "失败、取消或结果不明时如实反馈，不因前端跳转就宣称会话已全部失效。"
  ],
  "acceptance_points": [
    "AC-2005：统一退出系统身份及两模块会话，再次访问受保护页面需要登录；实际会话失效机制待核验。",
    "AC-2006：退出前处理在途电话及未保存内容，提示和异常细节沿后续流程评审，不直接丢失未保存输入。"
  ],
