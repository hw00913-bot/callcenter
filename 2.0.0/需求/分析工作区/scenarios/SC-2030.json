{
  "schema_version": "1.0",
  "id": "SC-2030",
  "name": "按业务分类导入并定位业务数据",
  "status": "proposed_flow",
  "summary": "分类字段/编码校验后导入，固定当时BASE/ROUTE及单一模板/条件快照，同台账定位；跨分类可同码，线索品牌内唯一，不按号码合并。",
  "actors": [
    "本租户具备导入权限的人员",
    "D联络云"
  ],
  "trigger": "需要导入某业务分类的新记录",
  "preconditions": [
    "沿用租户导入资格，当前方案由租户管理员在本租户导入。",
    "本次新模板输入分类已有一个有效兼容模板保存版本及可核BASE/字段与ROUTE版本；没有备用或接续映射。",
    "存量继续原查询和原处理，不因再次提交自动迁入。",
    "沿用 AI 生产身份和稳定租户/对象标识；直接访问与菜单采用同一当前操作授权校验，不按名称、手机号或品牌关系合并身份或授权。",
    "业务中心整合已确认的分类、规则、导入批次、业务台账、分配及记录处理入口，复用同一业务记录和原执行/详情跳转；不复制客户档案、任务或专业配置，不改变当前负责租户、原动作资格、固定版本和历史可见边界。"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "本租户具备导入权限的人员",
      "action": "从业务中心业务数据工作区按原本租户导入权限发起本次导入。",
      "system_response": "核当前租户及品牌；配置管理权不自动授导入或跨租户数据权，非线索仅本租户处理。",
      "rule_ids": [
        "BR-2040",
        "BR-2041",
        "BR-2043",
        "BR-2045",
        "BR-2046",
        "BR-2053",
        "BR-2054"
      ]
    },
    {
      "step": 2,
      "actor": "D联络云",
      "action": "展示有权分类、业务编码名称、各字段/必填/选项及当前BASE/ROUTE和单模板版本。",
      "system_response": "线索保原意向门店编码/名称，编码字符串保前导零；意向不变导入即转交指令。各条件字段定义、选项及版本独立，未额外指定单一标签来源。",
      "rule_ids": [
        "BR-2040",
        "BR-2041",
        "BR-2043",
        "BR-2045",
        "BR-2046",
        "BR-2053",
        "BR-2054"
      ]
    },
    {
      "step": 3,
      "actor": "本租户具备导入权限的人员",
      "action": "选择分类并提交数据，按原预览逐行核对后确认。",
      "system_response": "同手机号不同编码仍独立记录；分类间可同码，普通记录按品牌+分类+编码核重，线索在品牌内唯一，跨媒体/门店不得复制同码线索。",
      "rule_ids": [
        "BR-2040",
        "BR-2041",
        "BR-2043",
        "BR-2045",
        "BR-2046",
        "BR-2053",
        "BR-2054"
      ]
    },
    {
      "step": 4,
      "actor": "D联络云",
      "action": "复核本次导入资格、当前BASE/字段与ROUTE版本及有效兼容单模板；逐行校验编码、字段并核重复。",
      "system_response": "整次资格/配置冲突拒请求；行重复/错误分别记明，不覆盖已有字段/归属/模板/历史，有合格行仍可按原逐行规则导入。不把分配批次原子规则套给导入。",
      "rule_ids": [
        "BR-2040",
        "BR-2041",
        "BR-2043",
        "BR-2045",
        "BR-2046",
        "BR-2053",
        "BR-2054"
      ]
    },
    {
      "step": 5,
      "actor": "D联络云",
      "action": "保存合格新记录及实际批次逐行结果，固定BASE/字段、ROUTE、唯一模板及路径条件快照并初始化明确起始节点。",
      "system_response": "conditionFieldDefinitions按每个fieldId固定，定义/选项/版本独立；原意向值保留，无意向或目标映射待核不造门店副本，也不阻本来合法导入。只初始化，不呼叫/推进；旧记录/旧批次不初始化迁移或追改。",
      "rule_ids": [
        "BR-2040",
        "BR-2041",
        "BR-2043",
        "BR-2045",
        "BR-2046",
        "BR-2053",
        "BR-2054"
      ]
    },
    {
      "step": 6,
      "actor": "D联络云",
      "action": "返回逐条成功、重复、失败、待核及相应数量和有权定位。",
      "system_response": "没有合格新行也只反馈实际批次结果，不虚报创建。本版AI标签仅整合配置、映射和结果展示；不新增AI标准标签向业务字段写入及由此新增自动流转。原供应商池/场景映射/标准关联、原始及映射结果保留，未匹配保原值且不回退首项；既有业务字段条件、人工保存和其他原有流转不变。仅限本版，不作未来永久限制。",
      "rule_ids": [
        "BR-2040",
        "BR-2041",
        "BR-2043",
        "BR-2045",
        "BR-2046",
        "BR-2053",
        "BR-2054"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-2030-CANCEL",
      "condition": "提交前取消本次操作",
      "steps": [
        "不提交本次请求，不改变记录或配置。"
      ]
    },
    {
      "id": "ALT-2030-INVALID",
      "condition": "资格、配置、当前版本或本次业务条件不满足",
      "steps": [
        "导入无权或配置已变/不齐备\n拒绝整次请求并说明原因",
        "反馈具体原因；当前数据保持原实际状态。"
      ]
    },
    {
      "id": "ALT-2030-UNKNOWN",
      "condition": "读写失败或本次结果不能确定",
      "steps": [
        "不展示成功；区分明确失败和结果待核。",
        "结果待核先核对同次请求的实际结果，不能用新请求重复创建或推进。"
      ]
    },
    {
      "id": "ALT-2030-ROWS",
      "condition": "部分或全部行重复、字段错误或不能确认为新数据",
      "steps": [
        "逐行记录重复或失败原因，不覆盖既有归属、字段、模板和历史。",
        "有合格新行时只保存合格新记录；无新行时只保存实际批次结果。",
        "批次结果明确列出成功、重复、失败及待核，不能把导入完成等同所有行创建成功。"
      ]
    }
  ],
  "postconditions": [
    "按逐行实际结果反馈成功、重复、失败及待核；整次资格/配置失败拒请求，行错误不覆盖原记录。",
    "仅合格新记录固定BASE/字段、ROUTE和唯一模板/路径条件快照并初始化起点，不自动呼叫或转交。",
    "旧实例/批次保持原模型和历史，不因再次导入迁移；无意向/待核目标不凭空复制门店记录。"
  ],
  "acceptance_points": [
    "AC-2115：导入前选择有权业务分类，字段、业务编码名称和必填校验随分类配置变化，至少用线索类和另一分类验收。",
    "AC-2116：业务记录在同品牌、同业务分类内编码唯一，跨分类可以同码；线索分类保留品牌内线索编码唯一。不以手机号归并，平台记录ID稳定。",
    "AC-2117：导入结果能在统一台账定位并继续分配/处理；同条业务重复接收不得覆盖当前归属及既有历史，冲突给出明确处理结果。",
    "AC-2098：总部当前线索缺失意向门店时，沿用同一记录标记目标门店待指派，保留原记录ID、品牌编码、批次和历史，总部继续负责；不复制线索、不新增模板实例、不将其等同于坐席或任务未分配。",
    "AC-2108：分类可先保留为未关联模板；仅有关联的有效兼容模板才能接收新数据。分类字段变更破坏模板条件兼容时保引用、标需复核并拦新输入。新记录固定当时基础、路由和单一模板/路径条件快照；既有实例及历史不追改。"
  ],
