{
  "schema_version": "1.0",
  "id": "SC-2029",
  "name": "维护品牌共用流转模板及只读详情和受保护删除",
  "status": "proposed_flow",
  "summary": "新建/修改形成不可变保存版本；独立详情只读展示精确版本名称、起始节点、职责、方式、路径和条件；独立删除仅在无当前/历史分类、记录/批次及待核配置引用时可靠完成。",
  "actors": [
    "平台超管或本品牌租户管理员",
    "D联络云"
  ],
  "trigger": "有权管理人员发起模板创建/修改、只读详情或受保护删除中的一次独立原操作",
  "preconditions": [
    "有权平台超管或本品牌租户管理员按本次创建/修改、查看或删除操作分别核权限与品牌范围；不以模板配置权推得历史查看或删除权。",
    "处理能力限当前已有AI、预外呼、人工；任务与坐席资源实际使用时仍须核对。",
    "沿用 AI 生产身份和稳定租户/对象标识；直接访问与菜单采用同一当前操作授权校验，不按名称、手机号或品牌关系合并身份或授权。",
    "按当前平台管理/品牌配置/监管职责及实际对象范围验权；不以业务租户成员、本人电话坐席或同时开通 AI 与云呼叫作为配置/监管前提，不因此获得代处理或其他数据访问权。",
    "业务中心整合已确认的分类、规则、导入批次、业务台账、分配及记录处理入口，复用同一业务记录和原执行/详情跳转；不复制客户档案、任务或专业配置，不改变当前负责租户、原动作资格、固定版本和历史可见边界。",
    "新建仅有空名称、未指定起点及零节点；新增节点为空，不预植业务内容或列表首项为起点。显式选定起始节点后才校验保存。",
    "模板版本不可变；独立详情核当前有权精确保存版本，历史只读；独立删除需完整可靠证明无当前/历史分类、记录/批次及待核配置引用，不能清引用/删历史凑可删。"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "平台超管或本品牌租户管理员",
      "action": "从业务中心原模板入口独立选择新建/修改、只读详情或受保护删除中的一次操作。",
      "system_response": "按此次操作分别读取资格、品牌与精确对象/版本；三个互斥分支各自形成结果，不因同一SC合成一次必须全做。",
      "rule_ids": [
        "BR-2042",
        "BR-2043",
        "BR-2045",
        "BR-2047",
        "BR-2049"
      ]
    },
    {
      "step": 2,
      "actor": "D联络云",
      "action": "新建/修改路径展示空白新模板或精确原版本及已有配置能力。",
      "system_response": "新建为空名称/未定起点/零节点，新增节点空白；原版本和历史只读保留。配置不要求实际执行资源、本人坐席、业务成员或双模块。",
      "rule_ids": [
        "BR-2042",
        "BR-2043",
        "BR-2045",
        "BR-2047",
        "BR-2049"
      ]
    },
    {
      "step": 3,
      "actor": "平台超管或本品牌租户管理员",
      "action": "配置节点、明确起点、职责及允许方式、稳定edgeId路径和可选ALL/ANY条件。",
      "system_response": "多选条件直接用各自fieldId/optionId及containsAny/containsAll，通话状态IN合法多选；无条件无额外门槛。线索仅原总部/门店方向，非线索仅租户内。编辑节点/路径/条件时保留原滚动、输入、展开及条件草稿，禁用再启用条件保留本次草稿，不新增草稿管理。",
      "rule_ids": [
        "BR-2042",
        "BR-2043",
        "BR-2045",
        "BR-2047",
        "BR-2049"
      ]
    },
    {
      "step": 4,
      "actor": "D联络云",
      "action": "核本次配置权、原版本、显式起点、结束可达、节点职责/已有方式能力、合法方向和每条路径条件。",
      "system_response": "核edgeId稳定唯一、ALL/ANY、合法算子和非空候选；每字段定义/选项分别验证，不用单一标签来源。实际资源/成员资格仅实际执行时另核。总部下发不得任意门店兜底或店店直转，目标在本次真实转交时解析。",
      "rule_ids": [
        "BR-2042",
        "BR-2043",
        "BR-2045",
        "BR-2047",
        "BR-2049"
      ]
    },
    {
      "step": 5,
      "actor": "D联络云",
      "action": "仅为本次新建或修改可靠保存新版本。",
      "system_response": "原版本、记录/批次快照及历史引用保持；没有发布、自动执行、备用切换；本保存不写任何分类ROUTE/BASE或tagFieldId。",
      "rule_ids": [
        "BR-2042",
        "BR-2043",
        "BR-2045",
        "BR-2047",
        "BR-2049"
      ]
    },
    {
      "step": 6,
      "actor": "D联络云",
      "action": "反馈新建/修改的实际保存版本及可供分类独立关联的节点路径。",
      "system_response": "SC-2037另次关联一个模板保存版本；满足条件仍须人员选路确认，保存不自动转交/起呼。只读详情及保护删除走各自备选分支。",
      "rule_ids": [
        "BR-2042",
        "BR-2043",
        "BR-2045",
        "BR-2047",
        "BR-2049"
      ]
    }
  ],
