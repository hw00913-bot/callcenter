  "scope": "in_scope",
  "status": "proposed_flow",
  "notes": "G1确认范围，S3流程候选。账号创建与授权不是已确认的原子事务，结果分别反馈；真实稳定ID、角色码、建号上限与权限撤销生效契约继续 ISSUE-2001/2002，未设计自动合并身份或新增权限码。 缺少生产资料或尚未完成设计核验不是业务运行时校验条件；创建规则的具体内容仅按 ISSUE-2001 核实后落实。 原电话坐席、分机和供应商账号是专业资源，不因公共系统账号统一而合并；原专业CRUD保留，仅全局账号/租户成员基础写入归公共。 本轮SRC-2086仅确认37场景及三项整合修订；当前为S3流程草案，不表示G2/G3批准、生产实现或原型修改。 新增分类/模板的配置查看、监管和本租户业务处理按各自动作资格区分；品牌配置或列表查看不要求同时开通两种业务模块，不冒用租户身份，不授予跨租户记录、拨号、转交或成员授权。",
  "main_flow": [
    {
      "step": 1,
      "actor": "有成员管理权限的租户管理员",
      "action": "从系统管理的原有权入口选择新建人员或已有本租户成员",
      "system_response": "只处理当前租户访问关系，不扩展跨租户建号或超管身份。",
      "rule_ids": []
    },
    {
      "step": 2,
      "actor": "公共账号与本租户成员管理",
      "action": "校验管理员与目标范围",
      "system_response": "确认管理员有本租户成员操作权限，目标人员关系稳定且可核实。",
      "rule_ids": []
    },
    {
      "step": 3,
      "actor": "公共账号与本租户成员管理",
      "action": "建立或使用本租户成员记录",
      "system_response": "新增沿AI既有合法能力；已有成员复用以稳定标识和明确关系为前提，不按同名或手机号自动合并。",
      "rule_ids": []
    },
    {
      "step": 4,
      "actor": "有成员管理权限的租户管理员",
      "action": "分别分配AI和云呼叫业务权限",
      "system_response": "沿用AI生产既有授权，为云呼叫独立分配允许权限；两边权限可以不同。",
      "rule_ids": []
    },
    {
      "step": 5,
      "actor": "AI／云呼叫授权控制",
      "action": "校验模块与角色范围",
      "system_response": "仅允许本租户已开通模块及管理员可分配业务角色；不自动赋予公共管理或全局权限。",
      "rule_ids": []
    },
    {
      "step": 6,
      "actor": "AI／云呼叫授权控制",
      "action": "保存授权并反馈结果",
      "system_response": "公共账号与成员是唯一基础维护入口；原AI/Cloud内部创建/编辑/授权入口同样转本场景。AI/云呼叫仍分别授权，六入口只组织菜单，不把同区页面合成权限包；人员与授权结果分别反馈。",
      "rule_ids": []
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-2007-01",
      "condition": "管理员无权、目标越租户或要求全局身份",
      "steps": [
        "拒绝本次操作，不产生越权成员或角色。"
      ]
    },
    {
      "id": "ALT-2007-02",
      "condition": "目标为已核实的本租户既有成员",
      "steps": [
        "使用稳定成员关系直接维护工作区授权，保留AI既有授权基准。"
      ]
    },
    {
      "id": "ALT-2007-03",
      "condition": "已有账号拟复用但稳定身份／成员关系校验不通过",
      "steps": [
        "反馈实际身份关系校验结果，保留输入；不得因同名或同手机号自动合并及改写历史。"
      ]
    },
    {
      "id": "ALT-2007-04",
      "condition": "新建身份冲突或实际创建规则校验不通过",
      "steps": [
        "反馈实际校验不符合项，保留输入，不创建新身份或越过既有规则。"
      ]
    },
    {
      "id": "ALT-2007-05",
      "condition": "本租户建号失败",
      "steps": [
        "反馈创建失败，不继续向不存在或未确认成员写入权限。"
      ]
    },
    {
      "id": "ALT-2007-06",
      "condition": "授权包含未开通模块或超出允许业务角色",
      "steps": [
        "反馈不符合项，保留原授权；已成功创建的账号与本次授权失败分别展示。"
      ]
    },
    {
      "id": "ALT-2007-07",
      "condition": "账号已建立或既有成员可用，但权限保存失败",
      "steps": [
        "如实展示人员记录和授权各自结果；不声称已获全部工作区权限，不默认回滚已成功的建号。"
      ]
    }
  ],
  "postconditions": [
    "成功授权后同一成员在当前租户可取得不同的AI／云呼叫操作权限。",
    "AI存量身份、历史关系及授权基准保留；失败不产生未经授权的使用权。"
  ],
  "acceptance_points": [
    "AC-2022：公共账号管理按全已有功能原则承接AI文档所述的本租户建号能力；实际生产授权和上限仍待核验，不自动扩展为跨租户建号或授予超管身份。",
    "AC-2023：身份冲突及已有账号复用须核对稳定标识后处理，不能因同名或同手机号自动合并、改写历史归属。",
    "AC-2024：租户管理员只在本租户已开通模块及允许业务角色范围内维护成员使用和操作权限。",
    "AC-2025：同一成员在AI和云呼叫可有不同操作权限，沿用AI生产既有授权并单独分配云呼叫权限。",
    "AC-2026：菜单、直接路由和业务操作使用相应授权，具体生产权限码及撤权生效时间待核验。"
  ],
