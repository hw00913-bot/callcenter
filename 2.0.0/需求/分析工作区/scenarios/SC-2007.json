  "id": "SC-2007",
  "name": "创建本租户账号并分配工作区权限",
  "summary": "本租户成员获得允许模块的分别授权",
  "actors": [
    "有成员管理权限的租户管理员",
    "公共账号与本租户成员管理",
    "AI／云呼叫授权控制"
  ],
  "trigger": "租户管理员增加/授权成员",
  "preconditions": [
    "租户管理员具本租户成员管理权限，所需工作区由超管开通。",
    "本租户建号按AI已有能力承接，生产创建上限、成员关系及真实授权仍待 ISSUE-2001。",
    "入口由系统管理承接原账号、成员、租户或品牌的相应功能，仍沿原对象权限、管理范围和稳定PAGE；该原管理功能的切离保护、同窗口返回及同次登录记忆继续按SC-2002，不因入口归位新增管理权。"
  ],
  "expected_outcome": "本租户成员获得允许模块的分别授权",
  "exception_scope": "账号身份冲突、授权上限、越租户/越级授权、撤权时点待核",
