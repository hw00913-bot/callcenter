  "scope": "in_scope",
  "status": "proposed_flow",
  "notes": "SRC-2086已确认本轮37场景范围；本文件仅为S3业务流程草案，未冻结、不证明生产能力已实现。每次发起一个已有业务操作，失败或取消可结束本次操作、保留原状态后重新发起；异步执行未确认不得据此终止真实在途任务。 承接最终v1.1.0预外呼范围；当前原型中的已演示重呼/异常补提交、失败下载与实际供应商规则仍须在ISSUE-2008按最终基线对账，不以此稿批准其生产契约。任务所用坐席/外呼组不同于呼入队列；人工与IVR不继承预测主子批或失败额度。已接收未拨禁呼待ISSUE-2005；供应商真实回执待ISSUE-2006。原来源接口及后台执行为既有子流程，未增加DCC完整业务。 技术资料缺证仅记录在本文件notes及既有ISSUE，不新增名为待核的产品状态；运行时按原实际成功/失败/未知结果表达。共享后继采用同义分支节点展开以保持原条件和步骤，不增加业务操作。 六入口仅重组入口，原任务页面/向导/详情/名单交互沿用；云呼叫原页面间含云报表保留原电话现场/检查，进入AI原功能或原公共管理功能或换租户前本人收尾离线沿SC-2002，后台任务不因区域导航自动停止。 本轮SRC-2086仅确认37场景及三项整合修订；当前为S3流程草案，不表示G2/G3批准、生产实现或原型修改。 新模板引用已有处理方式时，必须先满足当前记录、节点、负责租户及本次动作资格，再沿本场景和SC-2015原专业规则办理；分配、条件命中、人工确认节点或切备用不自动启动电话，不改变当前负责租户，不绕过串行执行与公共禁呼。原独立任务/通话仍保留原处理，不强制迁为模板记录。",
  "main_flow": [
    {
      "step": 1,
      "actor": "有相应预外呼权限的人员",
      "action": "选择当前租户既有任务的一次执行操作，或由该任务原规则触发一次尝试。",
      "system_response": "新建/编辑、名单导入、执行控制、查询/下载分别是独立操作分支。",
      "rule_ids": []
    },
    {
      "step": 2,
      "actor": "云呼叫预外呼模块",
      "action": "校验当前任务、来源锁定、授权及原任务坐席/外呼组资源。",
      "system_response": "沿最终v1.1.0的准确供应商任务映射和归属，不用队列编号代替坐席/外呼组，不复用AI任务。 人员交互校验当前操作者；已受理租户任务不因创建人员停用自动停止，执行仍须满足本租户及原任务资源条件。 新模板安排另须对应可核对的当前记录、节点及负责租户，不按同手机号或最近任务猜配；分配安排不等于已启动。",
      "rule_ids": []
    },
    {
      "step": 3,
      "actor": "云呼叫预外呼模块",
      "action": "对本次初呼、正常重呼或异常补提交引用SC-2015。",
      "system_response": "公共禁呼命中不得以restrict tel补提交规则绕过；原失败分类及累计额度继续独立。",
      "rule_ids": []
    },
    {
      "step": 4,
      "actor": "AliCti预外呼服务",
      "action": "处理经校验的本次预测任务尝试。",
      "system_response": "按原配置分配接听坐席；本地提交不等于全部逐条受理或已完成呼叫。",
      "rule_ids": []
    },
    {
      "step": 5,
      "actor": "云呼叫预外呼模块",
      "action": "关联本次准确任务、客户、批次与实际供应商结果。",
      "system_response": "本地保存、供应商导入和实际呼叫分开；保留本次原来源、原业务类型和结果依据。",
      "rule_ids": []
    },
    {
      "step": 6,
      "actor": "云呼叫预外呼模块",
      "action": "按原结果决定本次完成或后续原规则尝试。",
      "system_response": "正常任务重呼和异常补提交分别处理；后续每次尝试重新进入SC-2015，不因换工作区停止后台任务。",
      "rule_ids": []
    },
    {
      "step": 7,
      "actor": "有相应预外呼权限的人员",
      "action": "从原任务记录入口查看本次结果。",
      "system_response": "结果查询、失败下载按各自原权限和成功条件办理，不把本次查看变成新增提交。",
      "rule_ids": []
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-2019-CONFIG",
      "condition": "本次选择新建/编辑任务",
      "steps": [
        "按原向导保存任务配置，保留来源选择/锁定和实际供应商任务映射。",
        "接听资源仍用任务所选坐席或外呼组；配置成功不自动证明电话执行成功。"
      ]
    },
    {
      "id": "ALT-2019-IMPORT",
      "condition": "本次选择原任务客户导入",
      "steps": [
        "沿原手工或接口来源导入；保留单号批次、priority与原业务类型等最终规则。",
        "本地校验/保存与供应商导入分别显示，部分失败或未知不归为全部成功；可供后续原失败下载。"
      ]
    },
    {
      "id": "ALT-2019-CONTROL",
      "condition": "本次选择暂停/结束等原控制",
      "steps": [
        "按原状态和权限提交控制，准确展示回执；已发起通话按原规则继续，不由工作区切换代替任务控制。"
      ]
    },
    {
      "id": "ALT-2019-QUERY",
      "condition": "本次选择任务/结果查询或下载",
      "steps": [
        "读取当前租户准确任务记录；列表、详情、导出和失败下载分别沿已有操作。",
        "失败下载只沿最终v1.1.0的可信下载及对应清理规则，不以点击按钮当下载成功。"
      ]
    },
    {
      "id": "ALT-2019-CANCEL",
      "condition": "本次提交前取消",
      "steps": [
        "保留或放弃本次未提交草稿，既有任务与后台执行不被自动终止。"
      ]
    },
    {
      "id": "ALT-2019-AUTH",
      "condition": "任务/授权/资源/准确映射不满足原要求",
      "steps": [
        "不发起本次尝试；明确缺项，保留已存在任务。"
      ]
    },
    {
      "id": "ALT-2019-BLOCK",
      "condition": "公共禁呼命中或本次检查失败/未知",
      "steps": [
        "引用SC-2015；命中时拦截，检查失败或未知时停止本次新增提交；已提交远端未拨的处理能力仍逐供应商核验。"
      ]
    },
    {
      "id": "ALT-2019-UNKNOWN",
      "condition": "供应商受理/执行/逐条结果未知或关联不唯一",
      "steps": [
        "保留真实响应及实际失败/未知结果，不按最近同号猜配，也不自动重复提交。"
      ]
    },
    {
      "id": "ALT-2019-RETRY",
      "condition": "原最终规则决定可重呼或异常补提交",
      "steps": [
        "区分正常重呼与异常补提交，保留原来源、触发批次和共享额度。",
        "生成或保留原计划后结束本次处理，下一次独立尝试重新执行授权、资源和SC-2015检查。"
      ]
    },
    {
      "id": "ALT-2019-OP-FAIL",
      "condition": "配置/导入/控制/查询或下载本次失败",
      "steps": [
        "沿该原操作的错误、部分成功与未知语义保留输入/证据；不把错误变成新任务或额外次数。"
      ]
    }
  ],
  "postconditions": [
    "任务配置、名单导入、任务执行/控制、结果查询和下载分别形成原有结果，不合成一个新增通用任务。",
    "本次与后续尝试保留原业务来源、任务/批次关系和原失败额度；每次外呼受SC-2015约束。",
    "本地/供应商状态及未知结果保持可分辨，切换工作区不等于暂停或结束任务。",
    "人员停用前系统已受理的本租户任务仍在原任务条件满足时继续；停用者不能再操作，其他已有权人员可按原权限管理，不自动转交。业务政策已确认，已受理边界/执行主体与资源条件仍按真实契约核验。"
  ],
  "acceptance_points": [
    "AC-2068：承接v1.1.0最终范围的预外呼任务、导入、任务所用坐席／外呼组及其他资源、正常重呼、异常补提交及结果查询/下载，原执行规则保留。",
    "AC-2069：公共禁呼检查接入不改变原供应商失败分类及额度，不将预外呼策略套用于人工或IVR。"
  ],
