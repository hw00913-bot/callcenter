{
  "schema_version": "1.0",
  "id": "SC-2019",
  "name": "在整合入口管理原云呼叫预外呼任务",
  "summary": "原任务、导入、结果、重呼及补提交功能可用",
  "actors": [
    "有相应预外呼权限的人员",
    "云呼叫预外呼模块",
    "AliCti预外呼服务"
  ],
  "trigger": "运营执行批量预外呼",
  "preconditions": [
    "当前实际业务租户、所选呼叫方式权限及该方式专业执行资源合法；不要求同时开通或拥有另一模块权限。原方式的查询、配置及实际执行按各自操作资格区分。",
    "六入口按功能职责承接原专业页面、任务、表单和资源；只重组入口并复用现有操作，实际方式权限、供应商规则、电话现场及原联系限制不随中心名称改变，不新增业务动作或自动执行。"
  ],
  "expected_outcome": "原任务、导入、结果、重呼及补提交功能可用",
  "exception_scope": "原来源/坐席组/额度保留，接入公共禁呼",
