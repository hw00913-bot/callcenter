  "notes": "SRC-2086已确认本轮37场景范围；本文件仅为S3业务流程草案，未冻结、不证明生产能力已实现。每次发起一个已有业务操作，失败或取消可结束本次操作、保留原状态后重新发起；异步执行未确认不得据此终止真实在途任务。 资源列表、用途分配和本地mock只作盘点（SRC-2008）；实际供应商外呼授权、IVR任务/名单契约与最终范围按ISSUE-2008核对。远端待拨禁呼待ISSUE-2005，真实回执待ISSUE-2006。原IVR若有重呼仍仅按其原契约，不由本流程新增重试、预测失败额度或转人工引擎。 技术资料缺证仅记录在本文件notes及既有ISSUE，不新增名为待核的产品状态；运行时按原实际成功/失败/未知结果表达。共享后继采用同义分支节点展开以保持原条件和步骤，不增加业务操作。 六入口仅重组入口，原任务页面/向导/详情/名单交互沿用；云呼叫原页面间含云报表保留原电话现场/检查，进入AI原功能或原公共管理功能或换租户前本人收尾离线沿SC-2002，后台任务不因区域导航自动停止。 本轮SRC-2086仅确认37场景及三项整合修订；当前为S3流程草案，不表示G2/G3批准、生产实现或原型修改。 新模板引用已有处理方式时，必须先满足当前记录、节点、负责租户及本次动作资格，再沿本场景和SC-2015原专业规则办理；分配、条件命中、人工确认节点或切备用不自动启动电话，不改变当前负责租户，不绕过串行执行与公共禁呼。原独立任务/通话仍保留原处理，不强制迁为模板记录。 IVR保留原任务能力；不从模板“现有方式处理”推导新增IVR节点、模板转人工引擎或供应商执行能力。",
  "main_flow": [
    {
      "step": 1,
      "actor": "有相应IVR权限的人员",
      "action": "选择当前租户已有IVR任务的本次执行操作。",
      "system_response": "新建/编辑、名单处理、控制和结果查看仍按原独立子流程，不变成每次都重建任务。",
      "rule_ids": []
    },
    {
      "step": 2,
      "actor": "云呼叫IVR模块",
      "action": "校验任务、授权及原外呼语音流程/外显等资源。",
      "system_response": "资源按租户、供应商账号和外呼用途匹配；本地流程ID或呼入用途不自动成为可执行IVR资源。 人员交互校验当前操作者；已受理租户任务不因创建人员停用自动停止，执行仍须满足本租户及原任务资源条件。",
      "rule_ids": []
    },
    {
      "step": 3,
      "actor": "云呼叫IVR模块",
      "action": "对本次发起及原有后续尝试引用SC-2015。",
      "system_response": "公共禁呼检查不改变原IVR执行策略，也不套用预测坐席组或失败补提交额度。",
      "rule_ids": []
    },
    {
      "step": 4,
      "actor": "AliCti自动外呼服务",
      "action": "按原IVR任务及语音流程执行本次自动触达。",
      "system_response": "平台按真实受理和结果表达状态，不把资源列表存在认作已成功执行。",
      "rule_ids": []
    },
    {
      "step": 5,
      "actor": "云呼叫IVR模块",
      "action": "将实际结果关联本次任务和客户。",
      "system_response": "保留原IVR结果语义和原名单范围；未知或关联失败保留实际结果并停止本次新增提交。",
      "rule_ids": []
    },
    {
      "step": 6,
      "actor": "有相应IVR权限的人员",
      "action": "在原任务详情或记录入口查看执行结果。",
      "system_response": "列表、详情、已有导出等按原独立操作承接；切工作区不自动停止后台任务。",
      "rule_ids": []
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-2020-CONFIG",
      "condition": "选择本次新建/编辑任务配置",
      "steps": [
        "沿原自动外呼向导维护语音流程及既有资源参数，合法保存后结束本次配置。",
        "保留原名单处理子流程；不新增预测坐席分配或把呼入规则当IVR任务。"
      ]
    },
    {
      "id": "ALT-2020-LIST",
      "condition": "选择原名单处理操作",
      "steps": [
        "只承接IVR原有名单导入/选择和结果反馈，不移植预测单号主子批及失败预算。",
        "原方式的具体契约按最终基线核验。"
      ]
    },
    {
      "id": "ALT-2020-CONTROL",
      "condition": "选择原任务控制",
      "steps": [
        "沿原任务状态允许的启动以外控制操作办理，按真实回执更新。",
        "已发起通话与后台任务按原规则处理，工作区切换不是控制命令。"
      ]
    },
    {
      "id": "ALT-2020-QUERY",
      "condition": "选择原查询/详情/导出",
      "steps": [
        "在当前租户按原任务/客户关系读取和展示结果；按已存在操作完成导出。"
      ]
    },
    {
      "id": "ALT-2020-CANCEL",
      "condition": "提交前取消本次操作",
      "steps": [
        "沿原规则处理输入，不向供应商发出本次新增执行或控制。"
      ]
    },
    {
      "id": "ALT-2020-RESOURCE",
      "condition": "任务或资源用途/归属/实际可用性不满足",
      "steps": [
        "提示实际配置缺项或读取失败/未知，不将本地ID、其他账号或呼入流程自动替换。"
      ]
    },
    {
      "id": "ALT-2020-BLOCK",
      "condition": "命中公共禁呼或本次检查失败/未知",
      "steps": [
        "沿SC-2015阻止本次外呼；检查失败或未知时保留实际结果并停止本次新增提交。"
      ]
    },
    {
      "id": "ALT-2020-UNKNOWN",
      "condition": "原供应商失败或执行结果未知",
      "steps": [
        "保留真实失败原因和状态，不假报成功，也不追加预测失败补提交。"
      ]
    },
    {
      "id": "ALT-2020-OP-FAIL",
      "condition": "原配置/名单/控制/查询操作失败",
      "steps": [
        "保留原输入、已生效状态与实际结果；结束本次操作后按原方式重新发起。"
      ]
    }
  ],
  "postconditions": [
    "IVR任务和语音资源沿原用途与供应商账号范围承接，不与人工/预测任务混用。",
    "本次原操作结果有明确成功、实际失败或未知结果；公共禁呼由SC-2015统一约束。",
    "IVR后台任务不因工作区切换自动暂停；没有新增统一策略引擎。",
    "人员停用前系统已受理的本租户任务仍在原任务条件满足时继续；停用者不能再操作，其他已有权人员可按原权限管理，不自动转交。业务政策已确认，已受理边界/执行主体与资源条件仍按真实契约核验。"
  ],
  "acceptance_points": [
    "AC-2070：承接既有IVR外呼任务、语音流程资源及结果处理，与人工/预外呼各自执行方式区分。",
    "AC-2071：资源必须归属对应租户、供应商账号及外呼用途；具体校验沿原最终基线，不把本地或呼入流程ID直接当可执行外呼资源。"
  ],
