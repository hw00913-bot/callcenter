{
  "schema_version": "1.0",
  "id": "SC-2032",
  "name": "人员按模板节点启动处理并确认推进",
  "status": "proposed_flow",
  "summary": "固定单模板路径按各规则实际fieldId/optionId当前有效已保存值分别评估匹配/未匹配/待核，多条符合人工选一条，提交重核。启动核整记录最近原段；转交另核结束且不再呼叫，不自动推进或起呼。",
  "actors": [
    "当前负责租户有权业务人员",
    "D联络云"
  ],
  "trigger": "当前节点满足准入，需要确认路径或主动启动处理",
  "preconditions": [
    "新模板机制记录，版本和当前节点明确。",
    "操作人员具备当前负责租户及本条记录资格。",
    "沿用 AI 生产身份和稳定租户/对象标识；直接访问与菜单采用同一当前操作授权校验，不按名称、手机号或品牌关系合并身份或授权。",
    "处理启动、人工推进/转交分别核所选动作准入。未来门店待指派或后续出口条件未匹配/待核，不阻当前节点原本合法的处理启动。",
    "处理启动只要求当前方式模块/执行权/资源及本租户公共禁呼，不套双模块；配置/监管和单纯转交不因此取得或被要求实际起呼资格。",
    "业务中心整合已确认的分类、规则、导入批次、业务台账、分配及记录处理入口，复用同一业务记录和原执行/详情跳转；不复制客户档案、任务或专业配置，不改变当前负责租户、原动作资格、固定版本和历史可见边界。"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "当前负责租户有权业务人员",
      "action": "从业务中心打开当前有权业务记录和明确的当前节点。",
      "system_response": "定位同一记录及当前负责租户/轮次；配置共享不授记录访问，非线索不扩跨租户流转。",
      "rule_ids": [
        "BR-2041",
        "BR-2052"
      ]
    },
    {
      "step": 2,
      "actor": "D联络云",
      "action": "展示记录固定BASE/字段、ROUTE及唯一模板版本、节点/edgeId路径，并区分受理、执行结束、结果保存、归属和节点状态。",
      "system_response": "通话条件只取当前负责租户当前轮次最近实际结束call；每规则依自身fieldId/optionId取对应当前有效已保存值/来源/定义和值版本，conditionFieldDefinitions固定，各字段独立。逐路径显示MATCHED/UNMATCHED/PENDING及原因，后改分类/路由不追改实例。",
      "rule_ids": [
        "BR-2045",
        "BR-2049"
      ]
    },
    {
      "step": 3,
      "actor": "当前负责租户有权业务人员",
      "action": "人员明确选择本次启动允许方式，或选择一条合法匹配路径确认推进/转交。",
      "system_response": "多条匹配必须人工选一，不默认第一条。启动不提前要求未来门店已指定或出口条件匹配；只有实际总部下发才核意向锚定/无意向HQ ADMIN同次选有效门店。",
      "rule_ids": [
        "BR-2043",
        "BR-2047"
      ]
    },
    {
      "step": 4,
      "actor": "D联络云",
      "action": "按实际动作重核当前归属/节点/资格。启动须整条记录最近执行段已结束且结果保存，跨owner/round不豁免，仅全记录从未执行无前段；另核本次方式模块/成员权/执行资源及本租户公共禁呼。",
      "system_response": "推进/转交重核所选固定edgeId和各字段事实/来源/版本的ALL/ANY三态。转交独立核执行结束且确认不再呼叫，不额外套全前段结果保存；只有路径实际引用字段须有可靠已保存值。通话范围当前owner/round最近结束，绝不回退旧call；已核缺值为UNMATCHED，读取/定义/来源/终态冲突为PENDING。ALL任一false则未匹配，否则有unknown待核；ANY任一true则匹配，否则有unknown待核。配置/值过期重新核，不信预览。",
      "rule_ids": [
        "BR-2048",
        "BR-2049"
      ]
    },
    {
      "step": 5,
      "actor": "D联络云",
      "action": "仅办理人员本次所选合法启动，或保存本次节点推进/转交。",
      "system_response": "启动登记独立执行段并复用SC-2025；本租户分配SC-2031，线索转交SC-2026/27。成功转交才换归属并清旧assignedAccountId，目标按原权另分配；合法回流才增轮次，节点切换本身不增轮次，不自动起呼。",
      "rule_ids": [
        "BR-2043",
        "BR-2051"
      ]
    },
    {
      "step": 6,
      "actor": "D联络云",
      "action": "反馈本次实际受理/执行段或推进结果；结束与结果保存仍按原段独立归档。",
      "system_response": "受理成功不等于执行结束或结果已保存。迟到结果归原segment，逐字段省略保留、显式[]仅清本字段，旧段结果不盖较新值/已存人工结果；旧manual未存段仅有原权依原固定表单首次补录，不读下游字段。停用仅既有接通通话有限收尾。未知先核同次结果，后续动作仍由人员发起。",
      "rule_ids": [
        "BR-2049",
        "BR-2051"
      ]
    }
  ],
