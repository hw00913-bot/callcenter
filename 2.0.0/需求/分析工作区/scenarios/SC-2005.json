{
  "schema_version": "1.0",
  "id": "SC-2005",
  "name": "维护品牌基础资料",
  "status": "proposed_flow",
  "summary": "公共管理有可引用品牌资料",
  "actors": [
    "平台超级管理员",
    "D联络云"
  ],
  "trigger": "平台有权人员维护品牌",
  "preconditions": [
    "操作由平台超级管理员发起。",
    "资料对象为本平台品牌档案；登记新增档案与维护已有档案均由超管处理。",
    "品牌名称必填、备注选填，系统标识区分重名；不增加人工品牌CODE必填或历史迁移。",
    "沿用 AI 生产身份和稳定租户/对象标识；直接访问与菜单采用同一当前操作授权校验，不按名称、手机号或品牌关系合并身份或授权。",
    "按当前平台管理/品牌配置/监管职责及实际对象范围验权；不以业务租户成员、本人电话坐席或同时开通 AI 与云呼叫作为配置/监管前提，不因此获得代处理或其他数据访问权。",
    "入口由系统管理承接原账号、成员、租户或品牌的相应功能，仍沿原对象权限、管理范围和稳定PAGE；该原管理功能的切离保护、同窗口返回及同次登录记忆继续按SC-2002，不因入口归位新增管理权。"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "平台超级管理员",
      "action": "从系统管理的原有权入口进入本平台品牌档案的本次登记或维护。",
      "system_response": "D联络云受理超管本次操作。",
      "rule_ids": [
        "BR-2025"
      ]
    },
    {
      "step": 2,
      "actor": "D联络云",
      "action": "按本次登记或维护展示对应的品牌档案填写内容。",
      "system_response": "登记新增档案或维护已有档案均按名称必填、备注选填与系统标识区分重名的原确认规则。",
      "rule_ids": [
        "BR-2025"
      ]
    },
    {
      "step": 3,
      "actor": "平台超级管理员",
      "action": "填写本次新增品牌档案资料，或调整已有档案资料，并确认提交。",
      "system_response": "D联络云接收本次档案登记或维护内容。",
      "rule_ids": [
        "BR-2025"
      ]
    },
    {
      "step": 4,
      "actor": "D联络云",
      "action": "核对超管操作身份及本次品牌档案是否满足保存条件。",
      "system_response": "形成通过或未通过结论；名称必填、备注选填，以系统标识区分重名。 按本操作管理/品牌/监管职责校验；不要求业务成员、电话坐席或双模块开通，不授代执行权。 同名品牌允许存在，稳定系统标识区分；资料读取失败或维护权无法确认时不保存，不用名称归并。",
      "rule_ids": [
        "BR-2025"
      ]
    },
    {
      "step": 5,
      "actor": "D联络云",
      "action": "在校验通过后保存本次登记或维护的本平台品牌档案。",
      "system_response": "形成本次档案保存的明确结果。",
      "rule_ids": [
        "BR-2025"
      ]
    },
    {
      "step": 6,
      "actor": "D联络云",
      "action": "在保存成功后反馈本次品牌档案登记或维护结果。",
      "system_response": "超管取得成功结果，本平台品牌档案可供租户品牌归属关联使用。 不自动开通租户模块、创建成员/坐席或取得品牌业务全量权；关联租户列表沿原有权基础资料交集。",
      "rule_ids": [
        "BR-2025"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-2005-CANCEL",
      "condition": "超管在提交前取消本次品牌档案登记或维护。",
      "steps": [
        "超管选择取消，不提交本次品牌档案资料。",
        "平台结束本次操作且不保存本次登记或维护内容。",
        "本次操作结束，不增加自动重试。"
      ],
      "status": "draft_detail"
    },
    {
      "id": "ALT-2005-INVALID",
      "condition": "本次品牌档案操作主体或资料未通过保存前校验。",
      "steps": [
        "平台反馈未通过结论及可定位原因，不保存本次变更。",
        "超管结束本次操作；需要修正时另次提交。"
      ],
      "status": "draft_detail"
    },
    {
      "id": "ALT-2005-SAVE-FAILED",
      "condition": "平台未能成功保存本次登记或维护的品牌档案。",
      "steps": [
        "平台反馈本次保存未成功，不展示成功结果。",
        "超管结束本次操作；后续重新核对实际资料后另次发起。",
        "响应未知只核对同次登记/修改实际结果，不盲目重复新建；失败保输入，不修改租户归属。"
      ],
      "status": "draft_detail"
    }
  ],
  "postconditions": [
    "保存成功时，本次新增登记或维护后的本平台品牌档案由超管统一维护，可供租户品牌归属关联使用。",
    "取消或保存前校验失败时，本次档案登记或维护内容未保存。",
    "保存未成功时不反馈登记或维护成功；具体失败恢复细则尚未冻结。"
  ],
  "acceptance_points": [
    "AC-2034：租户管理员只读本租户品牌归属；不因共享品牌而拥有其他租户权限。",
    "AC-2033：接入品牌资料由平台超级管理员统一维护。"
  ],
