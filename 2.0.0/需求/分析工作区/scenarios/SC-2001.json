{
  "schema_version": "1.0",
  "id": "SC-2001",
  "name": "登录并进入合法业务入口",
  "summary": "账号认证后选择/恢复合法租户，并进入六入口中的有权原入口",
  "actors": [
    "登录账号",
    "统一身份与租户访问控制",
    "合法入口解析与六入口导航"
  ],
  "trigger": "首次或后续登录",
  "preconditions": [
    "使用AI现有生产身份与租户关系作为存量基准；具体认证和云呼叫映射契约待 ISSUE-2001 核验。",
    "先验证账号再取得有权租户；单租户直进，多租户首次选择，后续恢复上次仍有权租户。仅合法平台资源/公共管理范围者沿原有权入口，不强制进入业务租户。",
    "六入口为工作台、业务中心、客户中心、呼叫中心、报表中心、系统管理；登录首次优先和后续恢复沿原稳定PAGE映射，不依六入口排序重算。原公共管理功能已分散承接，原管理范围及原顺序保留。"
  ],
  "expected_outcome": "账号认证后选择/恢复合法租户，并进入六入口中的有权原入口",
  "exception_scope": "认证失败、租户关系读取/映射异常、无合法租户、选择取消/失权、原入口失效及模块权限不足分别反馈",
  "source_story_ids": [
    "US-2001"
  ],
  "source_acceptance_ids": [
    "AC-2001",
    "AC-2002",
    "AC-2003",
    "AC-2004"
  ],
