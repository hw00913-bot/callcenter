  "scope": "in_scope",
  "status": "proposed_flow",
  "notes": "G1已确认场景范围；S3流程候选。认证机制、租户/成员稳定标识仍待核验，图中身份系统代表业务责任而非已选技术架构；默认子页、无业务权限落点是待页面评审的候选。 具体默认子页与无工作区权限的落地页面是设计缺口，仅记在 ISSUE-2009，不作为运行时失败原因。 SRC-2035～2041的合法租户与首次窄人群入口规则保留；展示按SRC-2088更新为六入口，替代原切换器，AI/云呼叫模块独立开通和操作授权仍保留。首次PAGE-2204仅适用SRC-2039条件，不形成历史失效回退优先级；原角色与入口盘点不等于生产角色码或授权证明。 结构修正保留全部原节点和异常ID：业务单租户、合法历史、多租户手动选择及独立平台范围在统一进入复核处汇合，不增加额外确认弹窗；业务、专业资源/财务、公共入口分层解析。仅Cloud首次同样适用SRC-2039窄条件，历史失效不套用首次优先。 本轮SRC-2086仅确认37场景及三项整合修订；当前为S3流程草案，不表示G2/G3批准、生产实现或原型修改。 新增分类/模板的配置查看、监管和本租户业务处理按各自动作资格区分；品牌配置或列表查看不要求同时开通两种业务模块，不冒用租户身份，不授予跨租户记录、拨号、转交或成员授权。",
  "main_flow": [
    {
      "step": 1,
      "actor": "登录账号",
      "action": "提交现有合法登录凭据",
      "system_response": "D联络云沿AI生产既有认证能力验证系统身份，不要求分别填写两套凭据；认证成功后才读取合法访问范围。",
      "rule_ids": []
    },
    {
      "step": 2,
      "actor": "统一身份与租户访问控制",
      "action": "核验身份关系并选择/恢复合法租户",
      "system_response": "仅以稳定身份取得有权范围。业务单租户自动选定，多租户首次选择；后续恢复上次仍合法租户，原租户失效时重新选择。单租户、合法历史与原独立平台范围自动继续，不额外增加确认弹窗；仅多租户手动选择可取消。进入前重验，失败不猜默认租户或按名称合并身份。",
      "rule_ids": []
    },
    {
      "step": 3,
      "actor": "统一身份与租户访问控制",
      "action": "求得当前合法范围内原业务、专业与管理功能的可用入口",
      "system_response": "分别结合租户模块开通、成员及操作权限，按原合法入口意图区分业务模块、供应商资源/AI服务财务等独立专业入口与原公共管理功能；这些功能映射到六入口，不由入口名称重新划分权限。没有业务模块权限不等于没有原专业入口；入口可见不代表区内全权。",
      "rule_ids": []
    },
    {
      "step": 4,
      "actor": "合法入口解析与六入口导航",
      "action": "解析首次或后续有权入口",
      "system_response": "首次只要有云呼叫访问权（含仅云呼叫）即解析其有权原入口；原综合概览、无明确本人作业/监管默认且同时有导入分配和云报表权时优先导入与分配，其他原意图沿用。仅AI首次沿AI原入口意图；后续恢复该账号该合法范围上次位置，历史失效按原合法入口意图重新解析，不套首次导入分配优先。原专业资源/财务入口独立承接，不要求同时有业务模块或公共资料管理权。 原稳定PAGE及访问记录映射至新入口；不按六入口展示顺序重算首次优先级或后续恢复位置。",
      "rule_ids": []
    },
    {
      "step": 5,
      "actor": "合法入口解析与六入口导航",
      "action": "确认目标入口",
      "system_response": "既有页面失效时按原合法入口意图和当前权限重新解析，不回到已取消概览，不把首次导入分配优先扩为历史失效兜底。仅原公共管理权限时沿原管理入口顺序选择首个有权稳定PAGE并映射至现入口，无权与读取失败分开反馈。",
      "rule_ids": []
    },
    {
      "step": 6,
      "actor": "合法入口解析与六入口导航",
      "action": "读取目标原业务页面",
      "system_response": "在工作台/业务中心/客户中心/呼叫中心/报表中心/系统管理展示有权菜单和最新内容；账号与选定合法范围保持一致，不新增统一首页，不自动电话上线。",
      "rule_ids": []
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-2001-01",
      "condition": "认证未通过",
      "steps": [
        "反馈认证失败，不进入受保护业务入口；用户重新发起登录另算一次操作。"
      ]
    },
    {
      "id": "ALT-2001-02",
      "condition": "账号/租户身份关系读取失败、未知或映射不可确认",
      "steps": [
        "明确提示本次读取/映射未完成，允许重试或核对关系；不把读取失败当无权限，不猜默认租户、不按同名/手机号自动合并。"
      ]
    },
    {
      "id": "ALT-2001-03",
      "condition": "仅一个工作区有权",
      "steps": [
        "选择唯一合法模块后，仍按该模块的首次/后续合法访问记录解析；仅云呼叫首次同样适用已确认窄人群导入分配规则，仅AI首次沿AI原有权入口。"
      ]
    },
    {
      "id": "ALT-2001-04",
      "condition": "没有可用业务工作区",
      "steps": [
        "无业务模块入口但有原供应商资源/AI服务财务等专业入口时，按原合法入口意图进入其有权页面，不强制业务租户或公共管理员身份。",
        "仅有原公共管理页面权限时，沿原管理入口顺序选择首个有权稳定PAGE并映射至现入口，再校验目标页与读取结果；不按六入口排序重算落点。无任何有权入口时明确提示并允许退出，不自动赋权。"
      ]
    },
    {
      "id": "ALT-2001-05",
      "condition": "历史工作区记录缺失或失效",
      "steps": [
        "按原合法入口意图与当前可达页面重新解析；不使用失效历史授权，不回退已取消概览，不套用仅首次窄人群的导入分配优先级。"
      ]
    },
    {
      "id": "ALT-2001-06",
      "condition": "目标子页面失效、失权或已无合法入口",
      "steps": [
        "反馈目标页不可用；仍有合法入口时回退该入口，已无合法入口时明确反馈，不恢复无权页面。"
      ]
    },
    {
      "id": "ALT-2001-07",
      "condition": "读取工作区失败",
      "steps": [
        "显示本次进入未完成，允许用户重新发起；不以缓存数据伪装读取成功。"
      ]
    },
    {
      "id": "ALT-2001-08",
      "condition": "上次租户已失效，或选择/恢复后租户授权变化",
      "steps": [
        "不恢复失权租户；仍有其他合法租户时由用户重新选择，已无合法范围时明确反馈。不得静默任选租户或携带原租户对象继续。"
      ]
    },
    {
      "id": "ALT-2001-09",
      "condition": "多租户选择时取消进入",
      "steps": [
        "结束本次租户进入，保持在有权租户选择/退出入口，不进入受保护的租户业务页面。"
      ]
    },
    {
      "id": "ALT-2001-10",
      "condition": "没有可用业务租户且没有合法平台/公共访问范围",
      "steps": [
        "明确提示暂无可用权限并提供退出；不创建默认租户或通过旧历史绕过授权。"
      ]
    }
  ],
  "postconditions": [
    "成功时同一身份进入已确认合法租户或独立平台管理范围中的获授权原功能；后续恢复合法租户及位置，不新增统一首页或自动电话上线。",
    "失败或权限不足时不取得未经授权的业务访问；保留原生产身份及历史归属。"
  ],
  "acceptance_points": [
    "AC-2001：一次登录后，先按真实授权确定合法租户；单租户直接进入，多租户首次选择，后续恢复上次仍合法租户。当前租户有权AI/云呼叫功能共用认证，无需再次填写另一套系统凭证。",
    "AC-2002：以AI生产账号/租户及历史归属为存量基准，云呼叫映射接入。",
    "AC-2003：首次登录在已开通且有权时优先原云呼叫合法入口；原默认综合概览、无明确本人作业／监管默认入口且同时有导入与分配和云报表权限的人群，首次进入导入与分配。后续恢复上次合法位置；单一模块按其合法入口进入。本次首次选择不新增历史失效兜底优先级。",
    "AC-2004：本版不新增统一首页。取消独立运营概览，原入口按有权内容归位；没有业务入口但有公共管理权时，沿原公共管理入口顺序选择首个有权稳定PAGE，并映射至其现入口。"
  ],
