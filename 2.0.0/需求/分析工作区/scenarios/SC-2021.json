{
  "schema_version": "1.0",
  "id": "SC-2021",
  "name": "使用云呼叫其余既有资源与查询入口",
  "summary": "资源/记录/报表及必要应用接口范围不遗漏",
  "actors": [
    "具备所选云呼叫操作权限的人员",
    "云呼叫模块",
    "原供应商资源服务",
    "原接入业务系统"
  ],
  "trigger": "按角色配置既有资源或查询结果",
  "preconditions": [
    "按原资源配置、监管、报表、记录或应用接入操作分别核验主体及合法对象范围；不以两模块均开通、业务租户成员或本人电话坐席作为统一门槛。",
    "实际业务执行及外部应用接入仍须核对对应业务租户、来源/应用授权、方式和资源；配置/监管权不代替租户处理资格。",
    "客户中心直接承接原客户档案稳定PAGE-2203及原查看/作业权限：以既有租户/专业身份/号码范围归集联系资料，保留每条业务、批次、任务和通话的独立身份，不新增customer-domain角色、独立客户主档或客户数据模型。"
  ],
  "expected_outcome": "资源/记录/报表及必要应用接口范围不遗漏",
  "exception_scope": "复用最终v1.2及其已明确继承的原资源/查询/必要应用能力，不扩完整DCC/CRM或未确认接口；客户中心仅归原号码档案和有权联系历史。",
  "source_story_ids": [
    "US-2027"
  ],
  "source_acceptance_ids": [
    "AC-2072",
    "AC-2073"
  ],
