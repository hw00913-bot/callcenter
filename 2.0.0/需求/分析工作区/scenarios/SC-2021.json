  "scope": "in_scope",
  "status": "proposed_flow",
  "notes": "SRC-2094实际G1已批准当前38US/134AC/36SC范围；本文件按SRC-2090最终c847及SRC-2093重建S3产品流程候选。仅做模型、原生几何及PlantUML源码编译，不表示G2/G3、真实接口/生产能力、原型实施或最终图形渲染通过。原稳定身份、当前授权、电话现场及已确认历史边界保持。",
  "main_flow": [
    {
      "step": 1,
      "actor": "具备所选云呼叫操作权限的人员",
      "action": "从六入口中对应实际功能的有权原入口选择本次已有资源或查询操作。",
      "system_response": "复用原页面、控件、弹窗和操作顺序；资源配置、记录/报表/审计、异常处理和应用接入仍为独立原操作，不新增运营概览或统一管理功能。",
      "rule_ids": []
    },
    {
      "step": 2,
      "actor": "云呼叫模块",
      "action": "校验本次操作和目标租户/供应商资源范围。",
      "system_response": "入口可见不代表区内全权；账号/租户/品牌资料由系统管理原唯一入口承接，分类/字段由业务中心同一主配置承接，原名单由客户中心“联系限制”唯一入口承接。电话坐席、供应商账号及专业资源继续按原对象授权，不与登录账号或公共品牌混同。资源配置或监管合法范围不要求冒用租户或同时开通两模块，实际发起业务另验相应租户及方式资格；模板/分类管理与记录业务处理分开。",
      "rule_ids": []
    },
    {
      "step": 3,
      "actor": "云呼叫模块",
      "action": "将本次选择交对应原模块子流程。",
      "system_response": "原能力按最终v1.2及其明确继承范围对账，进入对应原详情/抽屉；不将旧菜单数当功能数。原Cloud号码档案、名单作业及云报表迁位仍保原电话现场；转AI、原管理功能、不能保现场或换租户沿SC-2002，同中心也按实际功能保护。",
      "rule_ids": []
    },
    {
      "step": 4,
      "actor": "云呼叫模块",
      "action": "读取本次原号码档案、联系历史、业务记录、报表或审计查询结果。",
      "system_response": "号码档案按原tenantId/enterpriseId/规范号码范围归集；业务/线索仍各保稳定编码和原ID，不能因同号拼接跨租户或不同线索历史。复用有权来源、关联业务/批次、原话后字段和联系历史；通话、七类报表及审计保持原口径，时长未知不当0或虚构通话。",
      "rule_ids": []
    },
    {
      "step": 5,
      "actor": "具备所选云呼叫操作权限的人员",
      "action": "查看列表或打开具体详情，若本次选择已有导出则按原规则完成。",
      "system_response": "查询、详情、导出是可分别发起的操作，不要求每次都导出；无数据是合法查询结果。 原继续联系、话后及限定旧任务缺失恢复只跳原合法操作和原guard；本次查询不产生客户主档、CRM生命周期、统一待办或通用回收。",
      "rule_ids": []
    },
    {
      "step": 6,
      "actor": "云呼叫模块",
      "action": "呈现本次操作结果及必要错误。",
      "system_response": "查询/导出失败不改变原业务状态；资源或业务回传状态按实际回执区分，不假报成功。",
      "rule_ids": []
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-2021-RESOURCE",
      "condition": "选择已有资源维护操作",
      "steps": [
        "坐席、技能、外呼组、队列、号码、号码池、分机、时间条件、AliCti账号按其原维护子流程办理。",
        "各对象允许的新增/修改/启停/关联动作逐项沿最终基线，不凭菜单补齐全套CRUD；需要供应商同步时区分本地保存与实际同步。"
      ]
    },
    {
      "id": "ALT-2021-INBOUND",
      "condition": "选择呼入服务规则维护",
      "steps": [
        "保留原条件、优先级和接听去向，按原权限及资源用途保存。",
        "正常呼入不被公共外呼禁呼拒接，不新增IVR外呼或跨租户路由能力。"
      ]
    },
    {
      "id": "ALT-2021-FIELDS",
      "condition": "选择云呼叫业务字段配置",
      "steps": [
        "分类基础、字段顺序/显示/必填及原取数配置只由SC-2010唯一主配置维护；原云字段页仅复用或跳转，不养第二份可编辑分类。独立路由由SC-2037关联一个模板版本，无独立标签来源控件、不提交tagFieldId。",
        "原模块专业参数及已核实旧配置按原权限继续；旧目录/批次保稳定身份及固定字段快照，不按同名或手机号迁移。逐字段条件只用准确fieldId和选项，不新增取数字典或行业联动。"
      ]
    },
    {
      "id": "ALT-2021-ISSUES",
      "condition": "选择既有通话数据异常处理",
      "steps": [
        "按原异常对象执行一次查看/核对等已有操作，保留原始证据和状态。",
        "未知不生成假话单，失败不新增外呼尝试。"
      ]
    },
    {
      "id": "ALT-2021-APP",
      "condition": "选择既有应用接入配置",
      "steps": [
        "有原应用接入管理权限者维护既有应用/租户授权与回调配置，沿最终v1.1.0范围。",
        "不是v1.1.1业务数据接口字典，不自动开放新的取数能力。"
      ]
    },
    {
      "id": "ALT-2021-BUSINESS",
      "condition": "原接入业务系统发起既有导入/结果交付子流程",
      "steps": [
        "DCC/天网等仅沿最终v1.1.0的应用身份、租户、来源和人工/预外呼方式办理。",
        "准确结果按原应用回传；未配置、鉴权失败、交付失败或未知沿原规则，不能改走其他应用或因回传失败重复外呼。"
      ]
    },
    {
      "id": "ALT-2021-EXPORT",
      "condition": "本次选择原有导出操作",
      "steps": [
        "按原授权、筛选和记录快照导出；下载失败/未知不显示成功或擅自清理。"
      ]
    },
    {
      "id": "ALT-2021-AUTH",
      "condition": "所选操作或对象无权/映射缺失",
      "steps": [
        "说明原因，不进入其他租户或猜配供应商账号。",
        "原名单/联系历史与源通话各自验权；入口、品牌或号码相同不增加对象范围，不通过档案绕过原权限。"
      ]
    },
    {
      "id": "ALT-2021-CANCEL",
      "condition": "提交前取消本次维护",
      "steps": [
        "原生效配置不变；后台任务继续按原规则。"
      ]
    },
    {
      "id": "ALT-2021-FAIL",
      "condition": "查询、配置保存、同步或业务交付失败/未知",
      "steps": [
        "保留原状态、输入或实际失败证据；只沿原操作重试，不新增补偿/重呼能力。"
      ]
    }
  ],
  "postconditions": [
    "本次原资源维护或查询操作保持自身独立结果、权限及对象归属；没有新增一个包办全部动作的正式FUNC。",
    "必要DCC/天网旧接口仍按最终v1.1.0承接，不扩为完整DCC或独立v1.1.1新取数接口；本轮已批准的品牌模板/同品牌流转由各自专门场景办理，不在本承接包重复实现或禁止。",
    "账号/租户/品牌、分类/字段、黑名单分别由系统管理、业务中心、客户中心承接原唯一主维护；专业页面内部按钮和直接路由同样遵守，不绕回旧基础CRUD。专业资源、电话坐席、原统计/执行语义保留。"
  ],
  "acceptance_points": [
    "AC-2072：承接云呼叫v1.1.0最终范围的坐席／供应商资源、呼入配置、记录、七类原报表及必要DCC导入／回传／应用接入。原综合概览的统计、任务、监管、租户及号码片段归既有目标，来源查看权不授目标整页、导出或写入；不合并AI／Cloud指标或账务。 继续复用原导入分配、批次详情、字段与取数字典、人工结果“待继续跟进/已完成”、原完成回传及按tenantId+enterpriseId+规范号码和原权限归集的联系历史。原任务确已缺失、无通话且未处理中时，沿原有权管理员手工恢复待分配；不扩大为客户公海或自动回收，不用手机号合并业务记录。",
    "AC-2073：必要接口承接本身不扩业务范围；v1.2同品牌总部/门店线索流转按SRC-2081本次明确要求独立纳入，完整DCC业务、通用自动规则引擎及独立v1.1.1新接口需求不自动加入本版。"
  ],
