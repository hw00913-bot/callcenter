  "scope": "in_scope",
  "status": "proposed_flow",
  "notes": "SRC-2086已确认本轮37场景范围；本文件仅为S3业务流程草案，未冻结、不证明生产能力已实现。每次发起一个已有业务操作，失败或取消可结束本次操作、保留原状态后重新发起；异步执行未确认不得据此终止真实在途任务。 人工接口分配、振铃早填、完成沟通快照、继续跟进与自动呼叫排他按最终v1.1.0基线逐项对账（ISSUE-2008），当前原型与候选条目不能代替生产已实现。电话在途与离线契约待ISSUE-2012；身份与坐席映射待ISSUE-2001；拒联保存/入库一致性待ISSUE-2007。图中电话状态事件描述一次电话结束过程，不要求用户等待整个预外呼任务结束。 技术资料缺证仅记录在本文件notes及既有ISSUE，不新增名为待核的产品状态；运行时按原实际成功/失败/未知结果表达。共享后继采用同义分支节点展开以保持原条件和步骤，不增加业务操作。 SRC-2040确认电话边界按原Cloud现场而非顶层区域；原名单发起电话能力不被强制迁走。监管查看不是本人通话，监管者无需因他人在线退出电话，也不由名称推定监管权。 本轮SRC-2086仅确认37场景及三项整合修订；当前为S3流程草案，不表示G2/G3批准、生产实现或原型修改。 新模板引用已有处理方式时，必须先满足当前记录、节点、负责租户及本次动作资格，再沿本场景和SC-2015原专业规则办理；分配、条件命中、人工确认节点或切备用不自动启动电话，不改变当前负责租户，不绕过串行执行与公共禁呼。原独立任务/通话仍保留原处理，不强制迁为模板记录。",
  "main_flow": [
    {
      "step": 1,
      "actor": "有云呼叫坐席权限的成员",
      "action": "进入本人坐席工作台并按原方式准备电话。",
      "system_response": "从坐席工作台本人作业或原名单“联系客户”等入口复用原电话/客户交互，校验本人账号、当前租户、坐席与原资源关系；进入不自动上线或拨号。 若由模板处理入口进入，先核当前记录/节点及负责租户和本次人工方式资格；不因节点确认自动拨号或创建坐席。",
      "rule_ids": []
    },
    {
      "step": 2,
      "actor": "云呼叫模块",
      "action": "区分本人主动外呼与收到的呼入/预外呼接听事件。",
      "system_response": "人工接口线索按原指定坐席关系承接；接听事件使用本次准确坐席及通话关系，不按最近同号猜配。",
      "rule_ids": []
    },
    {
      "step": 3,
      "actor": "有云呼叫坐席权限的成员",
      "action": "主动选择本人有权联系的客户并发起预览外呼。",
      "system_response": "先引用SC-2015检查当前租户公共禁呼，再沿原电话流程发起。",
      "rule_ids": []
    },
    {
      "step": 4,
      "actor": "AliCti电话服务",
      "action": "按原电话方式执行本次呼叫并返回实际状态。",
      "system_response": "拨号/振铃/接通/结束等按该方式契约表达；客户端动作不伪造客户接通。",
      "rule_ids": []
    },
    {
      "step": 5,
      "actor": "有云呼叫坐席权限的成员",
      "action": "在原允许阶段填写本次跟进信息，通话结束后提交保存。",
      "system_response": "人工/预外呼振铃早填及未接通条件按v1.1.0最终基线；呼入仍沿原有规则，不套用本轮外呼新增必填条件。",
      "rule_ids": []
    },
    {
      "step": 6,
      "actor": "云呼叫模块",
      "action": "复核本次通话结束状态、归属与业务字段后保存。",
      "system_response": "成功前保留草稿和原名单；原businessType与来源快照不因公共分类或后续同号记录改变。",
      "rule_ids": []
    },
    {
      "step": 7,
      "actor": "云呼叫模块",
      "action": "按已保存处理结果交原跟进/回传子流程。",
      "system_response": "拒联引用SC-2013；继续跟进沿原坐席承接且核对与预测任务排他；其他结果和接口回调沿原来源与最终规则。 模板后继由相应流程再次人工确认，不把话后保存或标签命中当成自动推进指令。",
      "rule_ids": []
    },
    {
      "step": 8,
      "actor": "有云呼叫坐席权限的成员",
      "action": "查看本次结果；需要切离原电话现场时再沿SC-2002收尾离线。",
      "system_response": "同Cloud页面含云报表保留原电话条/检查；进入AI原功能或原公共管理功能、不能保留原现场或切租户先完成本人必要话后并确认离线。返回不自动上线；保存失败不假报完成。",
      "rule_ids": []
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-2018-AUTH",
      "condition": "坐席/租户/资源或电话状态不满足原条件",
      "steps": [
        "说明实际缺项或电话状态未知，不拨号，也不自动改绑账号或分机。"
      ]
    },
    {
      "id": "ALT-2018-INCOMING",
      "condition": "本次是呼入或预外呼接听事件",
      "steps": [
        "供应商沿原路由将来电送达本坐席；按原接听/拒接/未接流程处理。",
        "公共外呼禁呼不用于拒接正常呼入；预外呼已发起阶段与后续重呼检查仍归SC-2015。"
      ]
    },
    {
      "id": "ALT-2018-BLOCK",
      "condition": "主动外呼命中公共禁呼或本次检查失败/未知",
      "steps": [
        "沿SC-2015拦截；检查失败或未知时停止本次新增提交，本次不拨号；不取消其他无关业务。"
      ]
    },
    {
      "id": "ALT-2018-CALL-UNKNOWN",
      "condition": "电话执行失败或无法确认本次状态",
      "steps": [
        "展示真实失败/未知并保留现场，等待原电话核对流程；不伪造结束、接通或重复拨号。"
      ]
    },
    {
      "id": "ALT-2018-CANCEL",
      "condition": "发起拨号或提交保存前取消",
      "steps": [
        "未拨号时按原流程取消；已经在途的通话不能因页面取消被强制结束。",
        "跟进输入保留/放弃仍按原页面规则，本次不标记已处理。"
      ]
    },
    {
      "id": "ALT-2018-SAVE",
      "condition": "通话未结束、归属变化、字段校验或保存失败",
      "steps": [
        "保留本次草稿和原客户状态；本次保存结束，可修正后重新提交。",
        "未保存不触发完成沟通回调或新增公共拒联。"
      ]
    },
    {
      "id": "ALT-2018-DECLINE",
      "condition": "成功保存客户拒绝联系",
      "steps": [
        "引用SC-2013形成当前租户公共禁呼，保留通话来源。",
        "公共入库失败/待恢复不显示全链路成功，按ISSUE-2007处理。"
      ]
    },
    {
      "id": "ALT-2018-FOLLOW",
      "condition": "成功保存继续跟进",
      "steps": [
        "沿v1.1.0最终规则留待联系；人工保持原分配坐席，预外呼后续由当前坐席人工处理。",
        "保留原预测来源；未核实停止/排他能力时不宣称已停止原自动呼叫。"
      ]
    },
    {
      "id": "ALT-2018-UNANSWERED",
      "condition": "实际通话终态为未接通",
      "steps": [
        "按呼叫方向与实际客户/坐席接听证据选择原表单校验。",
        "坐席未接不等于客户未接，人工选择状态不覆盖客观话单。"
      ]
    }
  ],
  "postconditions": [
    "人工、呼入和预外呼接听均保留原坐席、客户与通话关联，不创建统一跨模块任务。",
    "成功保存与未保存/失败可区分；拒联、继续跟进和完成沟通回传沿相应原规则。",
    "页面切换不自动终止其他后台任务；电话离线保护引用SC-2002。"
  ],
  "acceptance_points": [
    "AC-2066：承接云呼叫最终v1.1.0范围内的人工工作台、主动外呼、呼入接听、跟进与保存结果，沿各自原规则。",
    "AC-2067：当前核对口径包括人工接口线索指定坐席、振铃填写和后续人工跟进；最终以v1.1.0确认基线逐项对账，不在v2改写其需求。"
  ],
