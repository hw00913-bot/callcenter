      {
        "id": "N-VIEW",
        "lane_id": "operator",
        "type": "action",
        "order": 18,
        "label": "查看结果供下次人工启动",
        "step_ref": 6
      },
      {
        "id": "N-SUCCESS",
        "lane_id": "operator",
        "type": "end",
        "order": 19,
        "label": "本段结束且结果保存"
      },
      {
        "id": "V2-GUARD",
        "lane_id": "platform",
        "type": "decision",
        "order": 9,
        "label": "本次方式执行权/资源/模块\n及本租户禁呼均明确通过？"
      },
      {
        "id": "V2-DENIED",
        "lane_id": "platform",
        "type": "end",
        "order": 20,
        "label": "本次不启动；保留原段及记录"
      },
      {
        "id": "N-ENTRY-KIND",
        "lane_id": "platform",
        "type": "decision",
        "label": "本次为新段启动\n还是原人工段首次补录？",
