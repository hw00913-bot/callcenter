      },
      {
        "id": "N-ORIGINAL-OPEN",
        "lane_id": "operator",
        "type": "action",
        "label": "定位已结束未保存原人工段\n打开原段固定表单",
        "order": 21,
        "step_ref": 5
      },
      {
        "id": "N-ORIGINAL-CHECK",
        "lane_id": "platform",
        "type": "action",
        "label": "核原租户/轮/段/固定表单\n结束未存、原资格/资源及待核请求",
        "order": 22
      },
      {
        "id": "N-ORIGINAL-ALLOWED",
        "lane_id": "platform",
        "type": "decision",
        "label": "原段及当前原操作资格\n均可靠且允许首次补录？",
        "order": 23
      },
      {
        "id": "N-ORIGINAL-DENIED",
        "lane_id": "platform",
        "type": "end",
        "label": "拒绝原段补录\n不读下游值，不改原结果",
        "order": 24
      },
      {
        "id": "N-ORIGINAL-FILL",
        "lane_id": "operator",
        "type": "action",
        "label": "仅填写原固定表单\n不展示下游当前业务字段",
        "order": 25
      },
      {
        "id": "N-ORIGINAL-SUBMIT",
        "lane_id": "operator",
        "type": "decision",
        "label": "确认本次原段补录？",
        "order": 26
      },
      {
        "id": "N-ORIGINAL-CANCEL",
        "lane_id": "operator",
        "type": "end",
        "label": "取消本次补录\n原段及当前归属不变",
        "order": 27
      },
      {
        "id": "N-ORIGINAL-RECHECK",
        "lane_id": "platform",
        "type": "action",
        "label": "提交复核原段/记录版本\n原资格/结束未存及同次状态",
        "order": 28
      },
      {
        "id": "N-ORIGINAL-VALID",
        "lane_id": "platform",
        "type": "decision",
        "label": "提交时仍合法且未保存？",
        "order": 29
      },
      {
        "id": "N-ORIGINAL-STALE",
        "lane_id": "platform",
        "type": "end",
        "label": "拒绝过期/已保存或失权提交\n不重写已保存结果",
        "order": 30
      },
      {
        "id": "N-ORIGINAL-SAVE",
        "lane_id": "platform",
        "type": "action",
        "label": "仅首次保存原段结果及快照\n不改新owner/轮/节点和当前值",
        "order": 31,
        "step_ref": 5
      },
      {
        "id": "N-ORIGINAL-SAVED",
        "lane_id": "platform",
        "type": "decision",
        "label": "原段保存明确成功？",
        "order": 32
      },
      {
        "id": "N-ORIGINAL-FAILED",
        "lane_id": "platform",
        "type": "end",
        "label": "原段保存失败/未知\n保输入，先核同次结果",
        "order": 33
      },
      {
        "id": "N-ORIGINAL-VIEW",
        "lane_id": "operator",
        "type": "action",
        "label": "查看有权原段已保存快照",
        "order": 34,
        "step_ref": 6
      },
      {
        "id": "N-ORIGINAL-DONE",
        "lane_id": "operator",
        "type": "end",
        "label": "本次原段补录完成\n未重新执行或推进",
        "order": 35
      }
