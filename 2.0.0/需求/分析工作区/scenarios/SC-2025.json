      },
      {
        "id": "N-RECORD",
        "lane_id": "platform",
        "type": "action",
        "order": 15,
        "label": "按准确原段归档结果快照\n业务字段沿既有可信保存来源\n旧段不覆盖当前较新值",
        "step_ref": 5
      },
      {
        "id": "N-RECORDED",
        "lane_id": "platform",
        "type": "decision",
        "order": 16,
        "label": "本段结果已保存？"
      },
      {
        "id": "N-RECORD-FAIL",
        "lane_id": "platform",
        "type": "end",
        "order": 17,
        "label": "未记录成功；待核对"
