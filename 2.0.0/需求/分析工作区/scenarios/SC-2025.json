{
  "schema_version": "1.0",
  "id": "SC-2025",
  "name": "当前负责租户开展一轮多方式培育",
  "summary": "由人按原方式权限及本租户禁呼串行启动；核整条记录最近原段已结束且保存，换owner/round不豁免。原有权人可首次补录已结束未保存人工段，锁原段固定表单，不读下游字段或改新归属/当前值。",
  "status": "proposed_flow",
  "actors": [
    "当前负责或原人工段有权人员",
    "D联络云",
    "AI/预外呼执行系统（能力待核）"
  ],
  "trigger": "当前负责租户主动启动一次跟进，或原有权人员补录已结束未保存的原人工段",
  "preconditions": [
    "主动新段要求记录当前归属本租户；原人工段补录只沿原租户/轮次/执行段及当前仍有效的原人员资格办理，不借补录取得新owner权限。",
    "同一品牌内线索编码跨媒体及门店统一唯一，按编码识别同一条业务线索，不使用手机号判同。",
    "下一方式检查整条记录最近执行段已结束且结果保存；换owner或round不豁免，只有整条记录从未有段才无前段。转交另按结束且不再呼叫，不统一追加结果先保存。",
    "每次选择和启动均由当前负责租户业务人员完成，其他段由人员另次选择启动，不采用自动条件衔接。",
    "具体执行权限沿现有平台权限及S4身份契约核对，转交授权不自动增加各方式执行权；真实模块、资源及执行完成/结果保存状态仍须核验。",
    "AI/预外呼的真实进入、执行完成、回传及结果关联能力由S4核验，不将需求草案当作生产能力证明。",
    "同条线索再次回到总部或同一门店时沿用原线索编码，新增培育轮次且保留历轮结果。",
    "沿用 AI 生产身份和稳定租户/对象标识；直接访问与菜单采用同一当前操作授权校验，不按名称、手机号或品牌关系合并身份或授权。",
    "新模板记录须固定节点允许该方式，旧记录走原处理。实际启动仅核本次方式模块、操作权、资源及本租户公共禁呼，不要求双模块。",
    "业务中心整合已确认的分类、规则、导入批次、业务台账、分配及记录处理入口，复用同一业务记录和原执行/详情跳转；不复制客户档案、任务或专业配置，不改变当前负责租户、原动作资格、固定版本和历史可见边界。"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "当前负责或原人工段有权人员",
      "action": "根据本线索培育目标，按需安排本轮AI、预外呼、人工的组合及顺序，选择本次执行段方式。",
      "system_response": "同条线索各段按顺序开展；每次选择由业务人员完成，其他段由人员另次选择启动，不增加独立发布或自动条件衔接。",
      "rule_ids": [
        "BR-2029",
        "BR-2031",
        "BR-2036",
        "BR-2038"
      ]
    },
    {
      "step": 2,
      "actor": "当前负责或原人工段有权人员",
      "action": "由业务人员主动发起本次选定方式，进入本段启动条件核对。",
      "system_response": "发起前可取消；发起请求不代表已执行，前段未结束或结果未保存不得进入下一段。",
      "rule_ids": [
        "BR-2029",
        "BR-2036",
        "BR-2038"
      ]
    },
    {
      "step": 3,
      "actor": "D联络云",
      "action": "按品牌唯一线索编码核对当前身份、资格、前段结束及保存状态，并反馈准入结论或未满足原因。",
      "system_response": "核整条记录最近原执行段，换租户/轮次不豁免；仅整条记录从未有段才免前段。实际启动另核本次方式模块、成员执行权、资源、本租户公共禁呼及专项；未知或禁呼均不启动，不要求双模块。",
      "rule_ids": [
        "BR-2029",
        "BR-2031",
        "BR-2035",
        "BR-2038"
      ]
    },
    {
      "step": 4,
      "actor": "D联络云",
      "action": "承接业务人员本次选定并主动启动的跟进方式。",
      "system_response": "仅在前段结束并保存结果后承接本次人员主动启动；AI/预外呼由对应执行系统承担，人工由业务人员完成。后续段另次选择启动，不自动衔接，同条线索不并行执行。",
      "rule_ids": [
        "BR-2029",
        "BR-2031",
        "BR-2036",
        "BR-2038"
      ]
    },
    {
      "step": 5,
      "actor": "D联络云",
      "action": "将已结束的本次或准确原人工段结果，保存到其原租户、原轮次、原节点和固定表单快照。",
      "system_response": "原段身份/受理/实际结束及当前资格可靠才保存；首次补录锁原记录/轮/段/节点运行及固定表单，版本过期、已保存或原资格不符则拒绝。原始AI/预外呼结果与通话事实准确归原段；业务多选字段仅沿既有可信保存来源逐fieldId/optionId维护，省略保原值、显式空集合只清对应字段。旧轮/旧段或转出后补录不读下游字段、不改新owner/node/round及当前有效值；本版AI标签仅整合配置、映射和结果展示；不新增AI标准标签向业务字段写入及由此新增自动流转。原供应商池/场景映射/标准关联、原始及映射结果保留，未匹配保原值且不回退首项；既有业务字段条件、人工保存和其他原有流转不变。仅限本版，不作未来永久限制。",
      "rule_ids": [
        "BR-2029",
        "BR-2030",
        "BR-2032",
        "BR-2035",
        "BR-2038"
      ]
    },
    {
      "step": 6,
      "actor": "当前负责或原人工段有权人员",
      "action": "查看本段已结束且已保存的结果，作为下一次人员选择启动的前提。",
      "system_response": "已结束且结果可靠保存才完成本段结果责任；后续新段仍由当前有权人员另次启动，检查整记录最近原段。补录不重新执行、转交或改接收方当前值。",
      "rule_ids": [
        "BR-2029",
        "BR-2036",
        "BR-2038"
      ]
    }
  ],
