{
  "schema_version": "1.0",
  "id": "SC-2036",
  "name": "创建业务租户并同次关联品牌",
  "status": "proposed_flow",
  "summary": "选择品牌及总部/门店身份，同次可靠保存与查询恢复；唯一总部和既有引用受保护，异常不留半记录。",
  "actors": [
    "平台超级管理员",
    "D联络云"
  ],
  "trigger": "超管创建新业务租户",
  "preconditions": [
    "超管有创建租户资格，品牌档案已存在。",
    "沿用原租户字段、账号开通、唯一总部和历史引用保护。",
    "沿用 AI 生产身份和稳定租户/对象标识；直接访问与菜单采用同一当前操作授权校验，不按名称、手机号或品牌关系合并身份或授权。",
    "按当前平台管理/品牌配置/监管职责及实际对象范围验权；不以业务租户成员、本人电话坐席或同时开通 AI 与云呼叫作为配置/监管前提，不因此获得代处理或其他数据访问权。",
    "入口由系统管理承接原账号、成员、租户或品牌的相应功能，仍沿原对象权限、管理范围和稳定PAGE；该原管理功能的切离保护、同窗口返回及同次登录记忆继续按SC-2002，不因入口归位新增管理权。"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "平台超级管理员",
      "action": "从系统管理的原有权入口打开创建租户。",
      "system_response": "不是创建后再补做品牌关联。",
      "rule_ids": [
        "BR-2025",
        "BR-2011",
        "BR-2026",
        "BR-2039",
        "BR-2055"
      ]
    },
    {
      "step": 2,
      "actor": "D联络云",
      "action": "展示租户必要字段和品牌、总部/门店身份选择。",
      "system_response": "品牌/身份本次必填；门店可登记业务storeCode，逐步配置不伪造映射；填写后本品牌内唯一，名称不是路由键。",
      "rule_ids": [
        "BR-2025",
        "BR-2011",
        "BR-2026",
        "BR-2039",
        "BR-2055"
      ]
    },
    {
      "step": 3,
      "actor": "平台超级管理员",
      "action": "填写租户资料、品牌和总部/门店身份；门店按已有外部业务编码登记storeCode，确认同次提交。",
      "system_response": "同次提交完整创建意图。",
      "rule_ids": [
        "BR-2025",
        "BR-2011",
        "BR-2026",
        "BR-2039",
        "BR-2055"
      ]
    },
    {
      "step": 4,
      "actor": "D联络云",
      "action": "核对权限、必填、租户ID可用性、单品牌及唯一总部约束。",
      "system_response": "原账号/开通/历史引用ID保护保留；登记门店业务编码时另核本品牌内唯一及门店身份，不另建映射源。 按本操作管理/品牌/监管职责校验；不要求业务成员、电话坐席或双模块开通，不授代执行权。 总部停用不释放唯一关联；门店码保前导零，品牌内唯一及可靠映射版本。资格、历史引用或唯一性无法可靠核定时不创建。",
      "rule_ids": [
        "BR-2025",
        "BR-2011",
        "BR-2026",
        "BR-2039",
        "BR-2055"
      ]
    },
    {
      "step": 5,
      "actor": "D联络云",
      "action": "同次可靠保存租户及原品牌关联，门店填写的storeCode随该关联保存。",
      "system_response": "失败不留半条租户或孤立关联；重试核对同次创建结果。",
      "rule_ids": [
        "BR-2025",
        "BR-2011",
        "BR-2026",
        "BR-2039",
        "BR-2055"
      ]
    },
    {
      "step": 6,
      "actor": "D联络云",
      "action": "展示成功记录并可从租户列表持续查询恢复。",
      "system_response": "重新进入或打开页面仍为同一租户和品牌关联。 不自动开通模块、分配成员或创建坐席/任务；关联不共享品牌业务数据，storeCode来源仍唯一原关联，不回填客户意向或迁移历史。",
      "rule_ids": [
        "BR-2025",
        "BR-2011",
        "BR-2026",
        "BR-2039",
        "BR-2055"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-2036-CANCEL",
      "condition": "提交前取消本次操作",
      "steps": [
        "不提交本次请求，不改变记录或配置。"
      ]
    },
    {
      "id": "ALT-2036-INVALID",
      "condition": "资格、配置、当前版本或本次业务条件不满足",
      "steps": [
        "必填缺失、ID冲突或唯一总部不符\n拒绝创建，保留历史引用",
        "反馈具体原因；当前数据保持原实际状态。"
      ]
    },
    {
      "id": "ALT-2036-UNKNOWN",
      "condition": "读写失败或本次结果不能确定",
      "steps": [
        "不展示成功；区分明确失败和结果待核。",
        "结果待核先核对同次请求的实际结果，不能用新请求重复创建或推进。"
      ]
    }
  ],
  "postconditions": [
    "新租户及品牌关联可持续查询",
    "取消、校验不通过或未确认成功时，不伪造本次业务成功。"
  ],
  "acceptance_points": [
    "AC-2016：两模块共用同一业务租户及基础资料，AI生产身份及历史关系优先延续。",
    "AC-2017：各模块供应商资源、专属配置及业务数据按原规则管理；账号、电话坐席、供应商账号和机器人分别映射。",
    "AC-2018：新建业务租户须关联品牌；存量未关联租户保留原有功能并标记待补关联。",
    "AC-2035：关联成功的每个租户只对应一个接入品牌。",
    "AC-2081：同一接入品牌可关联多个租户。",
    "AC-2082：每品牌对应一个总部租户及多个独立门店租户。",
    "AC-2095：超管创建业务租户时选择本平台品牌及总部/门店身份，租户和关联同次保存，遵守单品牌及唯一总部。",
    "AC-2096：明确保存后能定位及持久查询记录；保存异常保留填写且无孤立租户或关联，旧会话与历史身份兼容不覆盖既有引用。"
  ],
