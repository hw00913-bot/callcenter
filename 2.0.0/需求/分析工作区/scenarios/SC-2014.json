  "scope": "in_scope",
  "status": "proposed_flow",
  "notes": "G1已确认AI拒联仅人工确认入库及授权运营新增；本图是S3产品流程建议。来源查看权和名单新增权均独立校验，真实角色/操作码待ISSUE-2001；“运营新增权不含解除权”不排除同一人员另获合法公共管理员权限后按SC-2016办理。来源/历史证据及已有名单有效状态待ISSUE-2004核实，本图不迁入Mock。供应商回执按ISSUE-2006核验，本地成功不等于全部远端成功。失败/取消均终止本次，后续处理是另一次发起。 本轮SRC-2086仅确认37场景及三项整合修订；当前为S3流程草案，不表示G2/G3批准、生产实现或原型修改。 品牌分类/模板共用不共享本租户公共禁呼或授予其他租户名单/来源通话权限；节点确认、条件命中、记录标签变化或切备用均不构成新增或解除公共禁呼的依据，也不赋予禁呼豁免。",
  "main_flow": [
    {
      "step": 1,
      "actor": "有权管理员或单独获新增权的运营",
      "action": "从客户中心“联系限制”的原唯一名单入口发起本租户AI拒联人工确认",
      "system_response": "本版不以AI意向等级、拒接或挂机自动新增公共拒联。 品牌记录标签、模板条件匹配或节点处理结果不能替代有权人员对来源通话中明确拒联的核实。",
      "rule_ids": []
    },
    {
      "step": 2,
      "actor": "公共禁呼管理系统",
      "action": "校验本租户公共禁呼新增权及来源通话查看权",
      "system_response": "管理员或运营均须具备对应权限，不因新增权自动获得来源查看权或解除权。",
      "rule_ids": []
    },
    {
      "step": 3,
      "actor": "AI通话记录模块",
      "action": "读取有权查看的本租户来源通话",
      "system_response": "保留实际来源关系，不以同名、意向等级或供应商失败状态替代拒联证据。",
      "rule_ids": []
    },
    {
      "step": 4,
      "actor": "有权管理员或单独获新增权的运营",
      "action": "查看来源通话并人工确认客户拒绝后续联系",
      "system_response": "不能明确拒联则本次不新增；可取消本次操作。",
      "rule_ids": []
    },
    {
      "step": 5,
      "actor": "有权管理员或单独获新增权的运营",
      "action": "提交已人工确认的本租户号码及来源",
      "system_response": "公共管理系统再次校验本次权限、租户、号码及来源关系。",
      "rule_ids": []
    },
    {
      "step": 6,
      "actor": "公共禁呼管理系统",
      "action": "保存公共明确拒联及来源、人工确认记录",
      "system_response": "长期有效并覆盖AI、人工、预外呼、IVR外呼；正常呼入继续。",
      "rule_ids": []
    },
    {
      "step": 7,
      "actor": "公共禁呼管理系统",
      "action": "返回本次实际保存结果",
      "system_response": "只有记录明确生效才提示加入完成；供应商远端结果分别表达。",
      "rule_ids": []
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-2014-AUTH",
      "condition": "缺本租户新增权、来源查看权，或提交时权限已失效",
      "steps": [
        "拒绝本次操作；不泄露来源，不新增公共拒联。"
      ]
    },
    {
      "id": "ALT-2014-SOURCEFAIL",
      "condition": "来源通话读取失败或来源不属于本租户",
      "steps": [
        "保留合法输入但不形成确认和入库成功结论。",
        "本次结束，来源恢复后可另行发起。"
      ]
    },
    {
      "id": "ALT-2014-NOREFUSAL",
      "condition": "未能确认客户明确拒绝后续联系",
      "steps": [
        "不将无意向、拒接、挂机、混合意向等级或供应商拦截结果转成公共拒联。",
        "结束本次人工确认，不改变名单。"
      ]
    },
    {
      "id": "ALT-2014-CANCEL",
      "condition": "已查看来源但取消本次新增",
      "steps": [
        "不保存本次公共拒联，保留原名单。"
      ]
    },
    {
      "id": "ALT-2014-INVALID",
      "condition": "提交号码、租户或来源关系未通过校验",
      "steps": [
        "显示具体反馈，保留合法输入，名单不变。"
      ]
    },
    {
      "id": "ALT-2014-SAVEFAIL",
      "condition": "公共拒联未明确保存生效",
      "steps": [
        "不提示加入完成，保留输入与来源引用及原可确认名单。",
        "再次处理须先读取实际结果后新一次发起。"
      ]
    }
  ],
  "postconditions": [
    "成功形成当前租户有人工来源依据的长期公共拒联；本次新增权不扩展为来源查看权或公共解除权。",
    "无权、无法确认、取消及失败均不触发AI结果自动入库，不虚报四类外呼远端拦截成功。"
  ],
  "acceptance_points": [
    "AC-2054：有权管理员及单独获公共禁呼新增授权的运营，需有权查看本租户来源通话并确认拒联后从客户中心“联系限制”的原公共名单入口加入。",
    "AC-2055：保留来源及人工确认记录，长期有效、四类外呼拦截；运营新增权不包含解除权。",
    "AC-2056：本版不自动按AI结果入库；无意向、拒接、挂机、混合意向等级及供应商拦截结果不直接认定明确拒联。"
  ],
