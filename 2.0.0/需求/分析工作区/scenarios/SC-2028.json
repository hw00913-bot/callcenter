{
  "schema_version": "1.0",
  "id": "SC-2028",
  "name": "接收方查看线索基本信息及历轮结果",
  "summary": "查看基本资料及有权历史快照；原转出方只看截止历史，不泄露下游新标签、通话或录音。",
  "status": "proposed_flow",
  "actors": [
    "本线索有权查看人员",
    "D联络云"
  ],
  "trigger": "接收租户需要接续了解上游跟进",
  "preconditions": [
    "线索已成功发生归属转交，无需接收方另行确认接收。",
    "请求人员属于该线索当前接收租户，或该线索已转出原负责租户的有权人员；具体查看权限沿现有平台权限及S4身份契约核对，转交授权不自动增加查看权。",
    "同条线索再次回总部或同门店时沿用原线索并新增轮次、保留历轮；当前身份优先于历史已转出身份。",
    "同一品牌线索编码跨媒体、门店统一唯一；查看与历轮关联均按编码，不因手机号相同判同或拼接历史。",
    "结果时间/转出事件及租户身份需能判定访问范围；真实字段、接口及关联变更由本版接口/执行待核项、本版接口/执行待核项继续核验。",
    "沿用 AI 生产身份和稳定租户/对象标识；直接访问与菜单采用同一当前操作授权校验，不按名称、手机号或品牌关系合并身份或授权。",
    "按实际数据查看范围验权，不要求另开未使用的外呼模块或本人坐席，不因此授启动/分配/转交权。",
    "业务中心整合已确认的分类、规则、导入批次、业务台账、分配及记录处理入口，复用同一业务记录和原执行/详情跳转；不复制客户档案、任务或专业配置，不改变当前负责租户、原动作资格、固定版本和历史可见边界。"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "本线索有权查看人员",
      "action": "当前接收租户人员以同品牌统一唯一编码选择转入线索，准备查看基本信息及历轮结果。",
      "system_response": "本次查看的身份及范围由平台核定；已转出方路径见备选流程。",
      "rule_ids": [
        "BR-2030",
        "BR-2034",
        "BR-2035"
      ]
    },
    {
      "step": 2,
      "actor": "D联络云",
      "action": "按同品牌统一唯一线索编码核对请求租户、查看资格及当前/已转出身份。",
      "system_response": "再次收回按当前接收身份处理；具体查看权限沿现有平台权限及S4身份契约核对，转交授权不自动增加查看权，品牌关系也不授予全量数据权。 重新核当前成员/范围；仅具转交、品牌配置或监管资格不自动获得本次记录、来源通话或录音权，失权不展示旧缓存。",
      "rule_ids": [
        "BR-2030",
        "BR-2032",
        "BR-2034",
        "BR-2035"
      ]
    },
    {
      "step": 3,
      "actor": "D联络云",
      "action": "按该线索编码为当前有权接收方取得基本信息与此前各轮跟进结果。",
      "system_response": "历轮与转交事件按同条编码关联，当前有权方可区分客户意向和人工指派；同码往返不拼接同手机号其他线索。 基础及业务多选字段按各自保存定义/选项和值快照展示，不按最新配置、同名字段或同号其他线索重解释。",
      "rule_ids": [
        "BR-2030",
        "BR-2032",
        "BR-2035"
      ]
    },
    {
      "step": 4,
      "actor": "D联络云",
      "action": "向当前有权接收方呈现基本信息及历轮结果。",
      "system_response": "当前有权方按资料范围看基本及历轮；旧转出方按原转出截止、发生时间及准确原段裁剪，过滤下游当前字段、条件依据、目标/指派和录音。迟到结果只归原段，不能把入库时间当发生时间。原人工未保存段只提供原段授权入口另循SC-2025，不在本查询授下游读取或结果改写权。",
      "rule_ids": [
        "BR-2030",
        "BR-2031",
        "BR-2034"
      ]
    },
    {
      "step": 5,
      "actor": "本线索有权查看人员",
      "action": "阅读有权范围内的结果。",
      "system_response": "当前接收方可据此接续培育，继续培育由SC-2025表达；本次查看不改变归属。",
      "rule_ids": [
        "BR-2030",
        "BR-2034"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-2028-CANCEL",
      "condition": "查看者在提交查看前取消或离开。",
      "steps": [
        "结束本次查看意图，不改变线索归属及已有结果。"
      ],
      "status": "analysis_draft"
    },
    {
      "id": "ALT-2028-PERMISSION",
      "condition": "请求人员不属于本线索当前接收方或有权已转出方。",
      "steps": [
        "不通过本次请求展示线索资料。",
        "具体查看权限沿现有平台权限及S4身份契约核对，转交授权不自动增加查看权；总部身份不提供品牌所有线索访问权。"
      ],
      "status": "analysis_draft"
    },
    {
      "id": "ALT-2028-SOURCE",
      "condition": "请求租户已转出该线索，且当前尚未再次收回。",
      "steps": [
        "按该租户转出事件的截止时点核定历史结果范围。",
        "仅取得并呈现转出前已发生的历史结果；不增加原负责租户对接收方后续结果的查看权。",
        "原未保存人工段补录入口仅带原tenant/round/segment/固定表单引用，不携带下游当前字段；另由SC-2025核当前原操作资格。"
      ],
      "source_refs": [
        "inputs/source-index.json#SRC-2085",
        "inputs/source-index.json#SRC-2086"
      ],
      "rule_ids": [
        "BR-2034"
      ]
    },
    {
      "id": "ALT-2028-FUTURE",
      "condition": "已转出方的请求包含转出之后发生的后续结果。",
      "steps": [
        "过滤其转出后结果。",
        "仅向其呈现转出前已发生的历史结果；不将无后续访问权误判为完全没有历史查看权。"
      ],
      "source_refs": [
        "inputs/source-index.json#SRC-2085",
        "inputs/source-index.json#SRC-2086"
      ],
      "rule_ids": [
        "BR-2034"
      ]
    },
    {
      "id": "ALT-2028-LOAD",
      "condition": "本次有权范围内的资料无法完整取得，或身份/截止范围无法可靠判定。",
      "steps": [
        "明确本次未能完整取得有权范围内资料，不以空列表或成功提示替代未知结果。",
        "字段、结果身份、转出截止及恢复方式继续核对，不在当前草案承诺自动补齐或外部接口重试。",
        "截止、发生时间、原段或字段定义/值快照不可核时不按空或0补齐，不用最新字段定义重解释历史。"
      ],
      "status": "analysis_draft"
    }
  ],
  "postconditions": [
    "当前有权接收方成功查看该线索基本信息和历轮跟进结果；再次收回该线索时按当前接收身份查看此前历轮。",
    "已转出方成功分支只展示其转出前已发生的历史结果，转出后的结果不展示。",
    "查看不改变归属，不增加接收确认环节。",
    "本场景不扩大为总部可查看同品牌所有线索，亦不补写已转出方基本信息的额外字段范围。",
    "失败或取消不构成本次有权资料完整展示成功。",
    "历轮及截止历史按同品牌跨媒体、门店统一唯一线索编码关联，手机号相同不能作为同条线索判断依据。"
  ],
