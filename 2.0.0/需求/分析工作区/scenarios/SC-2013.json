{
  "schema_version": "1.0",
  "id": "SC-2013",
  "name": "人工保存拒联结果自动进入公共禁呼",
  "summary": "长期公共禁呼留存来源，不需管理员复核",
  "actors": [
    "有权处理本次通话的坐席",
    "云呼叫话后处理模块",
    "公共禁呼管理系统"
  ],
  "trigger": "坐席在当前通话处理中选择客户拒绝联系，并发起本次保存",
  "preconditions": [
    "坐席有权处理当前租户本次通话，当前结果确为客户拒绝后续联系。",
    "保存与公共入库的实际一致性及恢复机制尚待ISSUE-2007核验；本图不假定已有技术实现。",
    "原公共名单主入口归客户中心“联系限制”，仍为同一份本租户名单及原操作资格；入口迁位不改变公共拒联和专项范围、期限、四类外呼检查或正常呼入规则，不在客户档案复制名单或增加禁呼豁免。进入该原管理功能仍沿SC-2002保护和记忆。"
  ],
  "expected_outcome": "长期公共禁呼留存来源，不需管理员复核",
  "exception_scope": "未保存不入库；保存/入库失败一致性待核",
  "source_story_ids": [
    "US-2019"
  ],
  "source_acceptance_ids": [
    "AC-2051",
    "AC-2052",
    "AC-2053"
  ],
  "source_refs": [
    "inputs/source-index.json#SRC-2002",
    "inputs/source-index.json#SRC-2007",
