    "inputs/source-index.json#SRC-2085",
    "inputs/source-index.json#SRC-2088",
    "inputs/source-index.json#SRC-2094"
  ],
  "scope": "in_scope",
  "status": "proposed_flow",
  "notes": "G1已确认人工保存拒联后自动公共入库；本图是S3业务完成条件及失败反馈建议，不证明生产已具备一致性。逻辑上分别检查保存与公共入库结果，不据泳道步骤指定数据库事务、调用次数、补偿接口或恢复按钮；实际原子性/恢复方式保留ISSUE-2007。失败保留可确认事实并结束本次，重试是重新核对后新一次发起，不增加管理员复核。四模式与供应商已接收未拨目标见SC-2015及ISSUE-2005，本地入库不冒充逐供应商远端拦截回执（ISSUE-2006）。 本轮SRC-2086仅确认37场景及三项整合修订；当前为S3流程草案，不表示G2/G3批准、生产实现或原型修改。 品牌分类/模板共用不共享本租户公共禁呼或授予其他租户名单/来源通话权限；节点确认、条件命中、记录标签变化或切备用均不构成新增或解除公共禁呼的依据，也不赋予禁呼豁免。",
  "main_flow": [
    {
      "step": 1,
      "actor": "有权处理本次通话的坐席",
      "action": "在本次通话处理结果中选择客户拒绝联系并发起保存",
      "system_response": "仅选择未保存不产生公共禁呼完成事实。",
      "rule_ids": []
    },
    {
      "step": 2,
      "actor": "云呼叫话后处理模块",
      "action": "校验当前租户、本次通话处理权限及结果内容",
      "system_response": "无权或校验失败时保留合法输入，不写入本次结果或新名单。",
      "rule_ids": []
    },
    {
      "step": 3,
      "actor": "云呼叫话后处理模块",
      "action": "保存本次客户拒联处理结果并确认实际保存结果",
      "system_response": "只有明确保存成功才进入自动公共入库的成功主线。",
      "rule_ids": []
    },
    {
      "step": 4,
      "actor": "公共禁呼管理系统",
      "action": "自动形成当前租户公共明确拒联记录",
      "system_response": "保留来源通话、操作人和时间；长期有效，无需管理员再次复核。",
      "rule_ids": []
    },
    {
      "step": 5,
      "actor": "公共禁呼管理系统",
      "action": "确认公共禁呼记录已在本地实际生效",
      "system_response": "AI、人工、预外呼、IVR外呼统一适用；不限制正常呼入，供应商回执另按实际结果表达。",
      "rule_ids": []
    },
    {
      "step": 6,
      "actor": "云呼叫话后处理模块",
      "action": "向坐席返回已保存且公共禁呼已在本地生效的结果",
      "system_response": "仅在话后保存与本地公共入库均确认成功时展示本地处理完成；逐供应商远端拦截结果按实际回执另列，不据本地入库虚报远端成功。",
      "rule_ids": []
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-2013-CANCEL",
      "condition": "坐席在本次保存前取消",
      "steps": [
        "保持原通话记录及名单，结束本次处理。"
      ]
    },
    {
      "id": "ALT-2013-INVALID",
      "condition": "通话处理权限、租户或必需内容校验未通过",
      "steps": [
        "反馈具体原因并保留合法输入，不发起本次写入。"
      ]
    },
    {
      "id": "ALT-2013-SAVEFAIL",
      "condition": "话后拒联结果未明确保存成功",
      "steps": [
        "保留输入与已有通话事实，不新增成功入库结论。",
        "结束本次处理，另一次发起须核对实际保存状态。"
      ]
    },
    {
      "id": "ALT-2013-ENTRYFAIL",
      "condition": "话后结果已保存，但公共禁呼入库失败或生效结果不明",
      "steps": [
        "保留已经确认保存的通话事实及本次必要输入，不虚报整体完成或禁呼成功。",
        "提示本次处理未全部完成；恢复另行发起并核对旧结果，不要求管理员再次审批。"
      ]
    }
  ],
  "postconditions": [
    "整体成功以客户拒联结果保存和当前租户长期公共禁呼实际生效两项均明确为条件，保留来源及审计。",
    "取消或保存失败不产生虚假的入库成功；入库失败不抹除已确认保存的通话事实，也不将本次显示为整体成功。"
  ],
  "acceptance_points": [
    "AC-2051：坐席成功保存客户拒绝联系处理结果后，自动加入本租户公共禁呼，无需管理员再次确认。",
    "AC-2052：保留来源通话、操作人和时间，四类外呼禁呼且长期有效，正常呼入继续接听。",
    "AC-2053：仅选择而未保存成功不算完成入库；保存与入库一致性、失败恢复须在流程与接口阶段解决，不能虚报整体成功。"
  ],
