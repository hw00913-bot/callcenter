  "scope": "in_scope",
  "status": "proposed_flow",
  "notes": "G1范围确认、S3流程候选。电话状态枚举为待核验业务分支，未声称真实离线契约已验证；原页失效回退及状态保存细节待页面评审。无需常驻跨工作区电话控件，不扩大为云呼叫内部所有切页强制离线。 电话放行条件按在途、话后、离线同时满足设计，已离线不能绕过待保存话后；初始状态未知保留独立失败出口。 SRC-2040已确认沿原Cloud电话现场：同Cloud跨区域含云报表保留原电话条/检查；进入AI原功能或原公共管理功能、不能保留原现场的页面或显式换租户先收尾离线。只看监管且本人确无会话不按他人坐席状态阻拦。六入口不等于六个业务模块，真实电话契约仍未关闭；返回不自动上线。 结构化补核：先识别是否保留原Cloud电话现场，再有条件执行原内部检查或本人切离保护；无需切离分支经过共同判断不代表退出电话，只有确需切离且本人在线才执行offline。普通导航/显式换租户先各自确定目标范围，再共同复核授权后恢复其独立位置；失败终止本次，不撤销已完成保存或离线。 本轮SRC-2086仅确认37场景及三项整合修订；当前为S3流程草案，不表示G2/G3批准、生产实现或原型修改。 新增分类/模板的配置查看、监管和本租户业务处理按各自动作资格区分；品牌配置或列表查看不要求同时开通两种业务模块，不冒用租户身份，不授予跨租户记录、拨号、转交或成员授权。",
  "main_flow": [
    {
      "step": 1,
      "actor": "当前租户成员／本人电话坐席",
      "action": "选择目标原入口或显式切换租户",
      "system_response": "识别来源/目标区域、实际模块、合法租户范围及本人原Cloud电话现场；普通区域导航保持租户，显式租户切换单独办理。",
      "rule_ids": []
    },
    {
      "step": 2,
      "actor": "区域/模块及租户切换控制",
      "action": "核验目标可用性",
      "system_response": "核验目标模块、成员及所选页面/操作权限；原公共管理功能和原平台资源权限分别校验，不由区域或模块角色自动赋予。",
      "rule_ids": []
    },
    {
      "step": 3,
      "actor": "当前租户成员／本人电话坐席",
      "action": "按原电话现场边界处理导航保护",
      "system_response": "同租户原Cloud现场页面间（含迁位后的客户档案、名单作业及云报表）保留原电话条和原检查，不因中心名称变化一律离线；进入AI原功能、原公共管理功能、不能保留原现场的页面或显式换租户前，先完成本人通话和必要话后并确认离线。保护按实际功能判断，同一新中心内换到AI或原管理功能仍适用。仅看监管且本人确无会话按查看权及表单规则，不以他人通话阻拦；状态未知不视为离线。",
      "rule_ids": []
    },
    {
      "step": 4,
      "actor": "当前页面表单",
      "action": "处理普通未保存内容",
      "system_response": "按原流程提供保存、放弃、取消切换；仅在无未处理输入时继续。",
      "rule_ids": []
    },
    {
      "step": 5,
      "actor": "区域/模块及租户切换控制",
      "action": "记录离开位置",
      "system_response": "按账号、来源租户及原业务入口隔离记录稳定PAGE、子视图和筛选；原公共管理功能即使分散至业务中心、客户中心和系统管理，仍沿同窗口返回来源功能、同次登录恢复上次合法管理页和筛选。显式换租户不携带原租户对象、筛选、草稿和电话在线状态。",
      "rule_ids": []
    },
    {
      "step": 6,
      "actor": "目标原业务入口",
      "action": "恢复工作位置",
      "system_response": "普通导航保持当前合法范围；显式换租户采用已选目标租户。重验对应范围与操作权限后，恢复该账号该租户自己的合法原页面和筛选；首次/失效的原公共管理页沿原管理入口顺序映射至首个有权页，其他失效位置按原合法入口意图回退，不借首次窄规则作历史兜底。 原PAGE迁位只改变展示归属，不按六入口排序重算原入口回退和记忆。",
      "rule_ids": []
    },
    {
      "step": 7,
      "actor": "目标原业务入口",
      "action": "复核访问并刷新业务数据",
      "system_response": "目标权限与最新数据读取成功后展示对应区域菜单和原内容；普通导航账号租户不变，显式换租户仅在目标授权确认后改变。返回不自动电话上线或拨号；后台任务按原规则。",
      "rule_ids": []
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-2002-01",
      "condition": "目标模块未开通、原操作无权或目标租户访问失效",
      "steps": [
        "拒绝本次切换并保留仍有权的来源位置，不改变权限或静默切换其他租户。"
      ]
    },
    {
      "id": "ALT-2002-02",
      "condition": "切离原Cloud电话现场且状态可确认，本人存在拨号、振铃或通话",
      "steps": [
        "本次切换不执行；先沿原电话流程处理在途呼叫、保存话后并离线，再由用户重新发起，不自动挂断。"
      ]
    },
    {
      "id": "ALT-2002-03",
      "condition": "切离原Cloud电话现场且状态可确认、无在途通话，但话后未保存",
      "steps": [
        "先保存话后记录；成功后再次确认本人电话已离线或确无需电话坐席，在线时先退出电话坐席，状态不能确认时不切换。"
      ]
    },
    {
      "id": "ALT-2002-04",
      "condition": "切离原Cloud电话现场且状态可确认、无在途通话和待保存话后，但本人电话在线",
      "steps": [
        "先退出本人电话坐席，系统登录保持。"
      ]
    },
    {
      "id": "ALT-2002-05",
      "condition": "话后保存失败",
      "steps": [
        "保留输入及来源工作区，不继续切换。"
      ]
    },
    {
      "id": "ALT-2002-06",
      "condition": "初始电话／话后状态不能确认，或保存话后后的电话状态不能确认，或电话离线失败",
      "steps": [
        "不把忙碌检查或已离线的单一标记当作全部可离开条件；状态不能确认时提示未完成并停留原工作区，保留话后输入。"
      ]
    },
    {
      "id": "ALT-2002-07",
      "condition": "普通表单选择保存",
      "steps": [
        "沿原表单流程保存，成功后继续，失败进入保留输入分支。"
      ]
    },
    {
      "id": "ALT-2002-08",
      "condition": "普通表单选择放弃",
      "steps": [
        "只丢弃用户明确放弃的未保存普通表单内容，继续切换。"
      ]
    },
    {
      "id": "ALT-2002-09",
      "condition": "普通表单选择取消",
      "steps": [
        "结束本次切换，保留普通表单内容。"
      ]
    },
    {
      "id": "ALT-2002-10",
      "condition": "普通表单保存失败",
      "steps": [
        "停留原页并保留输入，用户重新操作另算一次切换。"
      ]
    },
    {
      "id": "ALT-2002-11",
      "condition": "目标没有历史位置或原位置失效",
      "steps": [
        "不给旧页面隐式权限，反馈失效位置并回退当前有权入口。"
      ]
    },
    {
      "id": "ALT-2002-12",
      "condition": "切换时权限变化、无合法目标或数据读取失败",
      "steps": [
        "明确反馈未完成，保留仍可访问的原位置；已成功保存内容或已确认的电话离线不回滚成未保存／在线。"
      ]
    },
    {
      "id": "ALT-2002-13",
      "condition": "同租户原Cloud页面间导航，包括迁位后的客户档案、名单作业及云呼叫报表",
      "steps": [
        "保留同一原电话条、电话现场和原检查；允许时继续本次导航，原检查未放行时保留原现场。不能保留原电话现场的目标按切离分支处理，不一律按顶层菜单强制离线。 原公共管理功能分散迁位不改变其切离保护；即使同一新中心内切到AI或原管理功能，也按实际目标功能核验。"
      ]
    },
    {
      "id": "ALT-2002-14",
      "condition": "仅看监管/报表且本人确无电话会话",
      "steps": [
        "校验所选查看权限并按普通表单规则导航；不要求监督者有本人坐席，不依据被查看坐席在线/通话状态阻拦，也不因此授予监管权限。"
      ]
    },
    {
      "id": "ALT-2002-15",
      "condition": "用户显式切换合法业务租户",
      "steps": [
        "先按本场景完成本人电话/必要话后离线及普通表单保护，再重验目标租户和操作权限，恢复目标租户自己的合法位置。",
        "目标失权或读取失败时明确反馈，不带原租户对象、筛选、草稿或电话在线状态继续；不撤销已成功保存/离线事实。"
      ]
    }
  ],
  "postconditions": [
    "成功时展示目标区域内获授权原页面和最新内容；普通区域/模块导航保持账号与租户，显式换租户单独重验后只使用目标租户上下文。",
    "同原Cloud现场内部导航保留原电话条与检查；成功切离原电话现场时本人通话/必要话后完成且已确认离线。返回原位置不自动上线。",
    "后台AI、预外呼、IVR任务沿原规则运行，电话坐席退出引起的可用坐席变化沿原任务规则。",
    "失败或取消只结束本次切换，不抹除已保存业务事实；输入按相应保护分支保留。"
  ],
  "acceptance_points": [
    "AC-2007：统一界面采用工作台、业务中心、客户中心、呼叫中心、报表中心、系统管理六个顶层导航入口；进入已有权页面时保持当前账号与租户，侧栏及内容对应所在区域；AI和云呼叫仍为独立业务模块。",
    "AC-2008：六入口不新增许可开关或统一业务成员门槛。AI/云呼叫业务操作按对应租户模块、成员及操作权校验，公共管理、报表、原摘要片段、专业财务和平台资源依各自真实权限判断，互不自动授予。",
    "AC-2009：失效位置重新解析当前合法入口；仅原公共管理身份沿原管理入口顺序和稳定PAGE映射进入首个有权管理页；仍有独立财务／资源／报表权者按对应原入口处理；无任何合法入口提示受限，身份或租户读取失败提供失败反馈并重试，不当作无权。",
    "AC-2010：同账号同租户返回时恢复其原合法业务位置、对应视图及列表筛选，重新校验权限并读取最新业务数据；原公共管理功能迁位后仍同窗口返回来源功能，同次登录内恢复其上次合法管理页和筛选。",
    "AC-2011：位置按账号、租户与原业务域隔离；菜单区域只承接实际页面／视图。公共管理记忆限同次登录，其他位置时效沿既有规则；失权回退合法入口，不保存跨租户对象或未提交草稿，不恢复电话在线。",
    "AC-2012：沿用原云呼叫电话现场范围：原Cloud页面之间（含迁位后的客户档案、名单作业及云报表）保留原电话条及原检查；本人电话在线时进入AI原功能、原公共管理功能或切换租户前，先完成当前通话和必要话后并确认本人电话坐席离线，系统账号可继续登录；保护按实际功能判断，不按中心名称判断。",
    "AC-2013：普通未保存表单按原流程提示保存、放弃或取消切换；保存失败保留输入并停留原页。",
    "AC-2014：AI、预外呼、IVR后台任务按原规则运行；电话坐席退出造成的可用坐席变化沿原任务规则。",
    "AC-2015：拨号、振铃、通话、必要话后未保存、离线失败及状态未知均须保留保护分支。顶栏区域变化不自动扩大原Cloud内部离线要求；原名单联系客户等电话交互继续复用。仅看监管且本人无电话会话，不按他人坐席状态拦截；不新增跨AI／公共的常驻电话控件。"
  ],
