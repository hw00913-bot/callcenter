  "messages": [
    {
      "step": 1,
      "from": "super",
      "to": "ui",
      "message": "选择有权租户及拟开通的一个模块，AI/云呼叫分开，不捆绑。",
      "type": "request",
      "api_id": null,
      "condition": "本次原模块开通操作",
      "source_step_refs": [
        1
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 2,
      "from": "ui",
      "to": "perm",
      "message": "核超管的本次模块开通权和目标租户，不从管理入口可见或租管角色推权。",
      "type": "request",
      "api_id": "API-2002",
      "condition": "身份/开通权契约按实际API-2002证据；未核不视为通过。",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 3,
      "from": "perm",
      "to": "ui",
      "message": "非有权超管拒绝开通，保持目标和其他模块状态。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2006-01｜原开通资格无效或未可靠核实。",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": [
        "ALT-2006-01"
      ]
    },
    {
      "step": 4,
      "from": "ui",
      "to": "module",
      "message": "读取目标模块原开通/启停状态，不重置已有AI租户配置。",
      "type": "request",
      "api_id": "API-2002",
      "condition": "条件目标｜有权操作范围、原状态和身份关系可核。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 5,
      "from": "module",
      "to": "ai_adapter",
      "message": "仅本次选择AI时核原AI资源和状态，不要求Cloud坐席/号码。",
      "type": "request",
      "api_id": null,
      "condition": "条件目标｜本次选择AI，原AI资源接入契约可核。",
      "source_step_refs": [
        3,
        4
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 6,
      "from": "ai_adapter",
      "to": "ai",
      "message": "读取所选租户原AI服务/资源依据，保独立原专业资源与财务资格。",
      "type": "external_call",
      "api_id": "API-2015",
      "condition": "条件目标｜仅在相关真实契约、稳定身份/对象映射及本次权限已核实后，原AI资源能力和对应租户映射已可靠核验时。",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 7,
      "from": "ai",
      "to": "ai_adapter",
      "message": "返回原AI实际资源/状态或失败未知，不将候选定义当实际已开通。",
      "type": "response",
      "api_id": "API-2015",
      "condition": "条件目标｜对应本次合法AI资源读取。",
      "source_step_refs": [
        3,
        4
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 8,
      "from": "module",
      "to": "cloud_adapter",
      "message": "仅本次选择云呼叫时核原必要资源，不要求AI机器人或AI模块。",
      "type": "request",
      "api_id": null,
      "condition": "条件目标｜本次选择云呼叫，原资源接入契约可核。",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 9,
      "from": "cloud_adapter",
      "to": "cloud",
      "message": "读取所选租户原云呼叫资源，沿原平台资源域/业务租户域及操作范围。",
      "type": "external_call",
      "api_id": "API-2013",
      "condition": "条件目标｜仅在相关真实契约、稳定身份/对象映射及本次权限已核实后，原Cloud资源协议及对象映射已可靠核验时。",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 10,
      "from": "cloud",
      "to": "cloud_adapter",
      "message": "返回原云呼叫资源实际结果或失败未知，不造资源或扩大供应商能力。",
      "type": "response",
      "api_id": "API-2013",
      "condition": "条件目标｜对应本次合法Cloud资源读取。",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 11,
      "from": "ai_adapter",
      "to": "module",
      "message": "交付本次已选AI模块的可确认资源/状态，未知不视为齐备。",
      "type": "response",
      "api_id": null,
      "condition": "仅AI被选择且本次原读取已返回。",
      "source_step_refs": [
        3,
        4
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 12,
      "from": "cloud_adapter",
      "to": "module",
      "message": "交付本次已选Cloud模块的可确认资源/状态，未知不视为齐备。",
      "type": "response",
      "api_id": null,
      "condition": "仅Cloud被选择且本次原读取已返回。",
      "source_step_refs": [
        3,
        4
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 13,
      "from": "module",
      "to": "ui",
      "message": "已开通则展示原状态，不重复开通或重置原资源配置。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2006-02｜可靠确认目标模块已开通。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2006-02"
      ]
    },
    {
      "step": 14,
      "from": "module",
      "to": "ui",
      "message": "目标模块资源缺失、原条件/契约或真实状态未知则本次受阻，保原状态；未选模块资源不构成门槛。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2006-03｜目标所需条件未齐或不能可靠确认。",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": [
        "ALT-2006-03"
      ]
    },
    {
      "step": 15,
      "from": "ui",
      "to": "super",
      "message": "展示仅目标模块和必需资源核对结论；模块开通与成员授权分开。",
      "type": "response",
      "api_id": null,
      "condition": "条件目标｜目标尚未开通且本次必要前置可靠满足。",
      "source_step_refs": [
        4,
        5
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 16,
      "from": "super",
      "to": "ui",
      "message": "提交本次所选模块开通，未选模块不随同开启。",
      "type": "request",
      "api_id": null,
      "condition": "有权超管本次明确提交。",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 17,
      "from": "ui",
      "to": "module",
      "message": "固定本次租户及所选模块进入开通控制，不写其他模块或全体成员权限。",
      "type": "request",
      "api_id": null,
      "condition": "条件目标｜目标与原状态仍有效。",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 18,
      "from": "module",
      "to": "perm",
      "message": "提交时重核原超管权、租户/模块状态和本次必要资源；过期或未知不执行。",
      "type": "request",
      "api_id": "API-2002",
      "condition": "本次提交前再次核验。",
      "source_step_refs": [
        2,
        3,
        4,
        5
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 19,
      "from": "perm",
      "to": "module",
      "message": "仅本次仍有权且目标前置明确满足才可开通；无权/缺口分别沿原拒绝/资源受阻分支。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2006-01、ALT-2006-03｜条件目标｜最终检查有可靠结果；无权或未知不当通过。",
      "source_step_refs": [
        2,
        4
      ],
      "covered_alternate_flow_ids": [
        "ALT-2006-01",
        "ALT-2006-03"
      ]
    },
    {
      "step": 20,
      "from": "module",
      "to": "module",
      "message": "按本方开通责任及可核原执行能力只保存目标模块实际开通结果，不把方案当已部署开通服务。",
      "type": "request",
      "api_id": "API-2002",
      "condition": "条件目标｜真实开通/状态保存契约与受控实现已符合；否则不声称办理成功。",
      "source_step_refs": [
        6
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 21,
      "from": "module",
      "to": "ui",
      "message": "失败或结果未知反馈本次未完成，保其他模块和成员授权，不盲重复开通。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2006-04｜本次真实开通失败或结果未知。",
      "source_step_refs": [
        6
      ],
      "covered_alternate_flow_ids": [
        "ALT-2006-04"
      ]
    },
    {
      "step": 22,
      "from": "module",
      "to": "ui",
      "message": "仅本次目标模块真实开通已确认时返回实际状态，允许进入后续成员可授范围。",
      "type": "response",
      "api_id": null,
      "condition": "条件目标｜目标开通最终结果明确成立。",
      "source_step_refs": [
        6
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 23,
      "from": "ui",
      "to": "super",
      "message": "按实际结果反馈；仅AI/仅Cloud/两者独立开通皆可，成员使用权另由有权租管办理，不自动授全区权。",
      "type": "response",
      "api_id": null,
      "condition": "条件目标｜本次最终结果已明确；失败/未知不显示成功。",
      "source_step_refs": [
        6
      ],
      "covered_alternate_flow_ids": []
    }
