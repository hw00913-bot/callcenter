      "api_id": null,
      "condition": "本次原电话事实结论。",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 7,
      "from": "guard",
      "to": "ui",
      "message": "仍有在途电话/必要话后或本人状态不明、离线失败时保留现场，不默认挂机或丢输入。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2003-01｜退出保护未完成；用户处理后另次发起。",
      "source_step_refs": [
        2
