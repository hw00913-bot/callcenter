      "covered_alternate_flow_ids": [
        "ALT-2003-05"
      ]
    },
    {
      "step": 10,
      "from": "guard",
      "to": "phone_guard",
      "message": "无在途且必要话后已实际完成后，需离线则承接原电话退出；仅退出电话不当统一退出。",
      "type": "request",
      "api_id": null,
      "condition": "条件目标｜本人仍在线且安全前置已可靠满足。",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 11,
      "from": "phone_guard",
      "to": "phone",
      "message": "沿原电话离线能力安全退出本人坐席，不强制中断未完通话。",
      "type": "external_call",
      "api_id": "API-2010",
      "condition": "条件目标｜仅在相关真实契约、稳定身份/对象映射及本次权限已核实后，原离线控制及最新状态确认可落实时。",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 12,
      "from": "phone",
      "to": "phone_guard",
      "message": "返回本次回执及可核对最新状态/事件；旧事件/命令发出不单独证明离线。",
      "type": "response",
      "api_id": "API-2010",
      "condition": "条件目标｜对应本次合法离线办理。",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 13,
      "from": "phone_guard",
      "to": "guard",
      "message": "仅确认本人最新离线或确无本人会话、必要话后已存后放行，失败未知仍留现场。",
      "type": "response",
      "api_id": null,
      "condition": "条件目标｜原电话及话后保护已完成。",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 14,
      "from": "ui",
      "to": "user",
      "message": "普通未保存内容按原流程选择保存、明确放弃或取消，不能默认丢弃。",
