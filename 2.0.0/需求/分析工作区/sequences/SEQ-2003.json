      "covered_alternate_flow_ids": []
    },
    {
      "step": 15,
      "from": "user",
      "to": "ui",
      "message": "取消本次统一退出，保留当前登录及普通输入。",
      "type": "request",
      "api_id": null,
      "condition": "ALT-2003-04｜用户明确取消。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2003-04"
      ]
    },
    {
      "step": 16,
      "from": "user",
      "to": "ui",
      "message": "仅放弃明确选定的普通未保存内容，随后可继续本次退出。",
      "type": "request",
      "api_id": null,
      "condition": "ALT-2003-03｜用户明确放弃普通草稿。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2003-03"
