      "type": "request",
      "api_id": null,
      "condition": "条件目标｜原通话/话后流程及保存资格可可靠落实；拒联联合入库复用SC-2013原责任。",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 9,
      "from": "business",
      "to": "guard",
      "message": "必要保存失败或未知时保留输入，本次不退出。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2003-05｜退出前保存未完成。",
      "source_step_refs": [
        2,
        3
