{
  "schema_version": "1.0",
  "id": "SEQ-2023",
  "scenario_id": "SC-2023",
  "name": "仅在无业务引用时删除原账号时序",
  "status": "S5_current_design_for_review_not_implementation",
  "participants": [
    {
      "id": "operator",
      "name": "具备原账号删除操作权及相应对象范围的人员",
      "kind": "actor"
    },
    {
      "id": "ui",
      "name": "公共账号与成员页面",
      "kind": "system"
    },
    {
      "id": "adapter",
      "name": "本方身份与删除适配（目标责任）",
      "kind": "system"
    },
    {
      "id": "platform",
      "name": "原AI平台服务（仅条件核符合时承接）",
      "kind": "external_system"
    }
  ],
  "source_acceptance_ids": [
    "AC-2079"
  ],
  "source_refs": [
    "scenarios/SC-2023.json",
    "inputs/source-index.json#SRC-2077",
    "inputs/source-index.json#SRC-2066",
    "inputs/source-index.json#SRC-2041",
    "inputs/source-index.json#SRC-2042",
    "inputs/source-index.json#SRC-2086",
    "inputs/source-index.json#SRC-2085",
    "inputs/source-index.json#SRC-2088",
    "inputs/source-index.json#SRC-2094",
    "inputs/source-index.json#SRC-2095",
    "inputs/source-index.json#SRC-2096"
  ],
  "messages": [
    {
      "step": 1,
      "from": "operator",
      "to": "ui",
      "message": "从原账号列表行选择删除准确对象，复用原入口，不新增删除页面/审批/恢复。",
      "type": "request",
      "api_id": null,
      "condition": "本次原删除操作",
      "source_step_refs": [
        1
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 2,
      "from": "ui",
      "to": "adapter",
      "message": "固定准确账号及本次合法对象上下文，交本方原身份/删除适配。",
      "type": "request",
      "api_id": null,
      "condition": "以AI生产原实体为基准，不按同名/手机号猜实体。",
      "source_step_refs": [
        1,
        2
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 3,
      "from": "adapter",
      "to": "adapter",
      "message": "核准确实体映射、原删除权承接及最终资格与删除一致控制能力是否真实落实。",
      "type": "request",
      "api_id": null,
      "condition": "本方责任；已有DELETE定义不等整合能力已具备。",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 4,
      "from": "adapter",
      "to": "ui",
      "message": "任一准确实体/原权或最终一致控制尚未落实则受阻，不调用原删除；页面仅提示暂无法办理。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2023-CONTRACT｜当前契约/可靠适配未落实或无法核实。",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": [
        "ALT-2023-CONTRACT"
      ]
    },
    {
      "step": 5,
      "from": "adapter",
      "to": "adapter",
      "message": "仅原前置可靠时核原删除操作权及准确对象管理范围；成员管理/模块开通/全局停用不代删除权。",
      "type": "request",
      "api_id": null,
      "condition": "条件目标｜原实体和受控执行前置明确落实。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 6,
      "from": "adapter",
      "to": "ui",
      "message": "原删除权/对象范围无效则拒绝；撤权后移除失效范围展示，不从超管或页面可见推定删除权。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2023-AUTH｜本次原删除资格明确不满足。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2023-AUTH"
      ]
    },
    {
      "step": 7,
      "from": "adapter",
      "to": "adapter",
      "message": "检查任务/通话/账务及实际新记录、节点、轮次、执行/模板关联和历史引用；账号不得另有关联租户。必要删除审计保留，不另加未投入使用标志；无关模板不推定引用。",
      "type": "request",
      "api_id": null,
      "condition": "条件目标｜必要引用及原保护可完整可靠核验。",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 8,
      "from": "adapter",
      "to": "ui",
      "message": "存在任一实际业务引用/历史或原保护不满足则保对象，禁止删除；不清引用、级联历史或清账来凑可删。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2023-REF｜业务引用或原保护成立；未知也不能通过，归契约受阻。",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": [
        "ALT-2023-REF"
      ]
    },
    {
      "step": 9,
      "from": "adapter",
      "to": "ui",
      "message": "仅原权有效且无实际业务引用、原保护满足时呈现准确账号及范围供原确认；不宣称无依据不可恢复。",
      "type": "response",
      "api_id": null,
      "condition": "条件目标｜完整可靠资格已满足；无关模板不作为拒绝理由。",
      "source_step_refs": [
        4,
        5
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 10,
      "from": "ui",
      "to": "operator",
      "message": "展示原删除确认和本次准确作用范围，不加入清历史、自动清账或恢复承诺。",
      "type": "response",
      "api_id": null,
      "condition": "本次原确认准备完成。",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 11,
      "from": "operator",
      "to": "ui",
      "message": "取消本次原删除确认，保对象及原合法位置/筛选，不替换为停用或成员移除。",
      "type": "request",
      "api_id": null,
      "condition": "ALT-2023-CANCEL｜用户提交前明确取消。",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": [
        "ALT-2023-CANCEL"
      ]
    },
    {
      "step": 12,
      "from": "operator",
      "to": "ui",
      "message": "确认本次准确对象及已说明范围。",
      "type": "request",
      "api_id": null,
      "condition": "本次用户明确确认原删除。",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 13,
      "from": "ui",
      "to": "adapter",
      "message": "提交本次固定对象和合法上下文；提交中防重复，不声明已有幂等字段。",
      "type": "request",
      "api_id": null,
      "condition": "用户已确认且本次仍合法。",
      "source_step_refs": [
        6
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 14,
      "from": "adapter",
      "to": "ui",
      "message": "同对象已有删除结果未知时先按可靠既有能力核对，不再DELETE当查询。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2023-UNKNOWN｜同一对象已有本次/前次删除结果未知。",
      "source_step_refs": [
        6,
        9
      ],
      "covered_alternate_flow_ids": [
        "ALT-2023-UNKNOWN"
      ]
    },
    {
      "step": 15,
      "from": "adapter",
      "to": "adapter",
      "message": "最终提交中一致重核准确对象、原权、当前业务引用及原保护；预查不代最终一致控制，本方可靠执行未具备则受阻。",
      "type": "request",
      "api_id": null,
      "condition": "条件目标｜同次未知已排除，最终受控能力已真实符合。",
      "source_step_refs": [
        7
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 16,
      "from": "adapter",
      "to": "ui",
      "message": "确认后对象/权限/引用变化时一致拒绝，保对象与可追溯事实，不先删引用换取资格。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2023-CHANGE｜本次最终检查明确拒绝；无法可靠检查归契约受阻。",
      "source_step_refs": [
        7
      ],
      "covered_alternate_flow_ids": [
        "ALT-2023-CHANGE"
      ]
    },
    {
      "step": 17,
      "from": "adapter",
      "to": "platform",
      "message": "仅实体及最终资格/一致控制已核符合时承接原账号DELETE定义，不造引用检查端点、幂等字段或新权限码。",
      "type": "external_call",
      "api_id": "API-2002",
      "condition": "条件目标｜仅在相关真实契约、稳定身份/对象映射及本次权限已核实后，本次无引用与原保护和最终一致执行均可靠满足时才发出；当前缺口分支不调用。",
      "source_step_refs": [
        8
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 18,
      "from": "platform",
      "to": "adapter",
      "message": "返回准确对象本次最终删除证据，或明确未删除失败/未知；HTTP200或受理不单独等于删除完成。",
      "type": "response",
      "api_id": "API-2002",
      "condition": "条件目标｜对应本次合法原DELETE办理。",
      "source_step_refs": [
        9
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 19,
      "from": "adapter",
      "to": "ui",
      "message": "服务明确未删除失败时保原可确认对象/筛选并说明；仅已明确未执行且再核合法后人员才可另次提交。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2023-FAIL｜本次服务明确返回未删除失败。",
      "source_step_refs": [
        9
      ],
      "covered_alternate_flow_ids": [
        "ALT-2023-FAIL"
      ]
    },
    {
      "step": 20,
      "from": "adapter",
      "to": "adapter",
      "message": "结果不明仅用已有可靠证据核同一准确对象/同次结果；无可靠能力保未知，不将普通查询无记录当成功，不重DELETE。",
      "type": "request",
      "api_id": null,
      "condition": "本次最终删除结果未知；不新增查询协议、字段或重试额度。",
      "source_step_refs": [
        9
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 21,
      "from": "adapter",
      "to": "ui",
      "message": "最终证据仍不足时保结果未知，不本地移行假成功、不盲重试；必要审计及主体追溯保持。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2023-UNKNOWN｜结果未知且无法取得可靠最终证据。",
      "source_step_refs": [
        9
      ],
      "covered_alternate_flow_ids": [
        "ALT-2023-UNKNOWN"
      ]
    },
    {
      "step": 22,
      "from": "adapter",
      "to": "ui",
      "message": "仅本次准确对象最终删除已可靠确认时传递成功及必要审计事实；不改变其他主体/历史。",
      "type": "response",
      "api_id": null,
      "condition": "条件目标｜本次最终删除证据明确成立。",
      "source_step_refs": [
        9,
        10
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 23,
      "from": "ui",
      "to": "ui",
      "message": "响应时重核当前账号/租户/对象上下文；已变化则旧响应不回填新列表，保准确操作结果事实。",
      "type": "event",
      "api_id": null,
      "condition": "ALT-2023-STALE｜处理响应时本次上下文已变化。",
      "source_step_refs": [
        10
      ],
      "covered_alternate_flow_ids": [
        "ALT-2023-STALE"
      ]
    },
    {
      "step": 24,
      "from": "ui",
      "to": "operator",
      "message": "仅当前合法上下文仍匹配且最终成功已确认时刷新账号列表/真实计数；失败/未知保可辨状态，不改其他主体或历史。",
      "type": "response",
      "api_id": null,
      "condition": "条件目标｜本次最终成功且当前合法上下文仍一致；其他分支不显示成功。",
      "source_step_refs": [
        10
      ],
      "covered_alternate_flow_ids": []
    }
  ],
