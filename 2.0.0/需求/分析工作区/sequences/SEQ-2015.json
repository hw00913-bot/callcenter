{
  "schema_version": "1.0",
  "id": "SEQ-2015",
  "scenario_id": "SC-2015",
  "name": "四类外呼执行公共禁呼检查时序",
  "status": "S5_current_design_for_review_not_implementation",
  "participants": [
    {
      "id": "initiator",
      "name": "发起人员或既有后台任务",
      "kind": "actor"
    },
    {
      "id": "exec",
      "name": "四类外呼本方执行适配",
      "kind": "system"
    },
    {
      "id": "list",
      "name": "当前租户有效限制服务",
      "kind": "system"
    },
    {
      "id": "vendor",
      "name": "本次真实执行供应商",
      "kind": "external_system"
    }
  ],
  "messages": [
    {
      "step": 1,
      "from": "initiator",
      "to": "exec",
      "message": "发起一次本方式处理；配置/选路径/分配不是电话尝试。",
      "type": "request",
      "api_id": null,
      "condition": "主线｜当前已核定范围内本次操作",
      "source_step_refs": [
        1
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 2,
      "from": "exec",
      "to": "exec",
      "message": "区分方向，核本次合法租户、号码、方式原权、资源和准确任务/记录。",
      "type": "request",
      "api_id": null,
      "condition": "主线｜当前已核定范围内本次操作",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 3,
      "from": "exec",
      "to": "initiator",
      "message": "正常呼入回原呼入处理，不因公共外呼禁呼拒接。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2015-INBOUND｜本次结束，ref SC-2018",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": [
        "ALT-2015-INBOUND"
      ]
    },
    {
      "step": 4,
      "from": "exec",
      "to": "initiator",
      "message": "上下文/资源/方式授权无效或不明，不借其他租户或品牌配置权起呼。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2015-CONTEXT｜本次不新增提交",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": [
        "ALT-2015-CONTEXT"
      ]
    },
    {
      "step": 5,
      "from": "exec",
      "to": "list",
      "message": "按当前实际业务租户检查该号码有效公共禁呼及本方式专项原范围/期限。",
      "type": "request",
      "api_id": "API-2007",
      "condition": "条件目标｜本期实际调用语义/身份及对象关系已核，原准入通过；否则当前待核受阻。主线｜当前上下文可靠；内部拨前合同仍须核验",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 6,
      "from": "list",
      "to": "exec",
      "message": "检查失败/不可靠，不冒充未命中或阻断成功。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2015-CHECKFAIL｜当前整合合同/有效状态未核或实际读取失败",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2015-CHECKFAIL"
      ]
    },
    {
      "step": 7,
      "from": "exec",
      "to": "initiator",
      "message": "保既有任务和本次证据，停止本次新增外呼/重呼/异常补提交。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2015-CHECKFAIL｜本次结束",
      "source_step_refs": [
        3,
        6
      ],
      "covered_alternate_flow_ids": [
        "ALT-2015-CHECKFAIL"
      ]
    },
    {
      "step": 8,
      "from": "list",
      "to": "exec",
      "message": "返回可核命中或未命中及适用范围，不把AI专项扩大四种永久禁呼。",
      "type": "response",
      "api_id": "API-2007",
      "condition": "条件目标｜API2007真实检查合同/租户范围已核且实际取得结果",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 9,
      "from": "exec",
      "to": "exec",
      "message": "未命中仍沿原方式权、资源、频次/时段及其他限制；不保证起呼/接通或节点完成。",
      "type": "request",
      "api_id": null,
      "condition": "ALT-2015-NOMATCH｜本次回原合法执行子流程",
      "source_step_refs": [
        3,
        4
      ],
      "covered_alternate_flow_ids": [
        "ALT-2015-NOMATCH"
      ]
    },
    {
      "step": 10,
      "from": "exec",
      "to": "exec",
      "message": "命中且尚未向供应商提交时本方阻止本条新增提交，不停止无关客户任务。",
      "type": "request",
      "api_id": null,
      "condition": "条件目标｜有效命中且本方尚未提交",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 11,
      "from": "exec",
      "to": "vendor",
      "message": "仅在现网能力逐供应商核实后，对其已接收未拨的本条执行原精准阻断/取消。",
      "type": "external_call",
      "api_id": "API-2008",
      "condition": "条件目标｜精确记录/号码关联与原取消语义可核；不新增未知取消端点",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 12,
      "from": "vendor",
      "to": "exec",
      "message": "返回本条实际处理事实，包括未取消/进行中/未知；不能以请求已发替代成功。",
      "type": "response",
      "api_id": "API-2008",
      "condition": "条件目标｜原供应商真实回执或已核查询事实",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 13,
      "from": "exec",
      "to": "initiator",
      "message": "已收未拨阻断能力未核/本次失败或未知时不报已拦截、不绕禁呼补提交。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2015-BLOCKUNCONFIRMED｜当前API2008部分定义不足或真实结果不明",
      "source_step_refs": [
        4,
        5
      ],
      "covered_alternate_flow_ids": [
        "ALT-2015-BLOCKUNCONFIRMED"
      ]
    },
    {
      "step": 14,
      "from": "exec",
      "to": "exec",
      "message": "只记录本次可确认的本地/远端阻断事实，分别保留，不生成虚假拨出/接通。",
      "type": "request",
      "api_id": null,
      "condition": "主线｜如实留痕，不新增补偿/回收动作",
      "source_step_refs": [
        5,
        6
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 15,
      "from": "exec",
      "to": "initiator",
      "message": "反馈本条受限及未核边界；不影响正常呼入/其他租户、不自动转交/推进。",
      "type": "response",
      "api_id": null,
      "condition": "本次结束｜成功仅指已取得的真实阻断事实",
      "source_step_refs": [
        6
      ],
      "covered_alternate_flow_ids": []
    }
  ],
