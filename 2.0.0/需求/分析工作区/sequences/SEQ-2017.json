      "step": 22,
      "from": "ui",
      "to": "ai",
      "message": "公共账号/租户/分类/名单分别ref原唯一SC；删除分别SC-2023/24，不复制维护、不能借原入口增权。",
      "type": "request",
      "api_id": null,
      "condition": "ALT-2017-PUBLIC｜仅本次确实选择该基础/名单操作",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2017-PUBLIC"
      ]
    },
