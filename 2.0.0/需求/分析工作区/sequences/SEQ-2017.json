      "from": "provider",
      "to": "ai",
      "message": "财务失败/回执未知保原账和实际事实，不重复记账。",
      "type": "response",
      "api_id": "API-2015",
      "condition": "ALT-2017-BILL-FAIL｜不新增补偿规则",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": [
        "ALT-2017-BILL-FAIL"
      ]
