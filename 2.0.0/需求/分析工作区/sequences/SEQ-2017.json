    {
      "step": 17,
      "from": "operator",
      "to": "ui",
      "message": "独立选择原AI充值/手工调整，另验真实财务/服务资格和对象范围。",
      "type": "request",
      "api_id": null,
      "condition": "ALT-2017-BILL｜非公共租户维护权，不强制无关成员/双模块",
