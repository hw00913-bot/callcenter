      "step": 24,
      "from": "ai",
      "to": "provider",
      "message": "读取准确有权原任务详情及名单原视图，不以任务入口授其他名单操作权。",
      "type": "external_call",
      "api_id": "API-2015",
      "condition": "ALT-2017-LIST｜条件目标｜本次选择任务详情且原读取合同已核",
      "source_step_refs": [
        4
