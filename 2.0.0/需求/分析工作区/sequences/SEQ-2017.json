      "kind": "external_system"
    }
  ],
  "messages": [
    {
      "step": 1,
      "from": "operator",
      "to": "ui",
      "message": "选择一次原查询、任务、专业标签配置或独立财务操作，保当前合法位置。",
      "type": "request",
      "api_id": null,
      "condition": "主线｜当前已核定范围内本次操作",
      "source_step_refs": [
        1
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 2,
      "from": "ui",
      "to": "ai",
      "message": "按所选原操作核真实身份/租户或独立平台资源/财务范围，不强制无关业务成员/本人坐席/双模块。",
      "type": "request",
      "api_id": null,
      "condition": "主线｜当前已核定范围内本次操作",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 3,
      "from": "ai",
      "to": "ui",
      "message": "失权或身份/映射不明拒绝，不猜租户或自动授权。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2017-AUTH｜本次结束",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": [
        "ALT-2017-AUTH"
      ]
    },
    {
      "step": 4,
      "from": "ai",
      "to": "ai",
      "message": "分派本次独立原操作；公共基础/名单委托原唯一场景，不必每次执行全部动作。",
      "type": "request",
      "api_id": null,
      "condition": "主线｜当前已核定范围内本次操作",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 5,
      "from": "ai",
      "to": "provider",
      "message": "查询本次有权原记录/统计或用量摘要/明细，保持供应商及原分钟口径。",
      "type": "external_call",
      "api_id": "API-2015",
      "condition": "条件目标｜真实原功能/授权/取数合同与当前范围经核实",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 6,
      "from": "ai",
      "to": "ui",
      "message": "查询失败或当前证据未足时保筛选，不以旧缓存或空列表冒充成功。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2017-QUERY-FAIL｜本次结束",
      "source_step_refs": [
        4,
        5
      ],
      "covered_alternate_flow_ids": [
        "ALT-2017-QUERY-FAIL"
      ]
    },
    {
      "step": 7,
      "from": "provider",
      "to": "ai",
      "message": "仅在本次真实可靠返回后显示原结果，允许真实空态；原始和可靠映射标签并存。",
      "type": "response",
      "api_id": "API-2015",
      "condition": "条件目标｜真实查询成功；未映射保原值不首项兜底",
      "source_step_refs": [
        4,
        5
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 8,
      "from": "operator",
      "to": "ui",
      "message": "独立选择原导出；原财务导出权/有权AI租户集合及一致取数另验，不继承摘要权。",
      "type": "request",
      "api_id": null,
      "condition": "ALT-2017-EXPORT｜仅本次选择导出",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": [
        "ALT-2017-EXPORT"
      ]
    },
    {
      "step": 9,
      "from": "ai",
      "to": "provider",
      "message": "按原有权导出意图取当前服务快照8列：名称/ID/类型、可用/冻结/累计分钟、有效期、呼叫控制；不回算金额/模型余额。",
      "type": "external_call",
      "api_id": "API-2015",
      "condition": "ALT-2017-EXPORT｜条件目标｜原导出与一致取数已核；独立于统计日期/平台及公共租户筛选",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": [
        "ALT-2017-EXPORT"
      ]
    },
    {
      "step": 10,
      "from": "ai",
      "to": "ui",
      "message": "实际启动才ref SC-2015；命中或检查未知阻本次新增提交，暂停不当新起呼。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2017-BLOCK｜ALT-2017-TASK/BLOCK｜选择已核原控制；仅启动执行SC-2015，命中/未知则受阻；暂停沿原控制",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2017-TASK",
        "ALT-2017-BLOCK"
      ]
    },
    {
      "step": 11,
      "from": "ai",
      "to": "provider",
      "message": "仅按已证实的原能力及当前任务状态办理本次启动/暂停，不自动重启或合并任务。",
      "type": "external_call",
      "api_id": "API-2015",
      "condition": "ALT-2017-TASK｜条件目标｜原控制/真实授权与映射已核；启动已通过SC-2015",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2017-TASK"
      ]
    },
    {
      "step": 12,
      "from": "provider",
      "to": "ai",
      "message": "原控制失败/未知如实保原任务，不重发启动。",
      "type": "response",
      "api_id": "API-2015",
      "condition": "ALT-2017-PROVIDER｜原服务真实失败或结果不明",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2017-PROVIDER"
      ]
    },
    {
      "step": 13,
      "from": "operator",
      "to": "ui",
      "message": "选择原供应商池/标签启用/标准映射或专业场景操作；不同身份不能互相代替。",
      "type": "request",
      "api_id": null,
      "condition": "ALT-2017-CONFIG｜本次原专业操作",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2017-CONFIG"
      ]
    },
    {
      "step": 14,
      "from": "ai",
      "to": "provider",
      "message": "沿原权及准确作用域办理一次原配置：池按supplier；启用/映射按supplier+租户类型+标签场景；标准集按租户类型+标签场景。",
      "type": "external_call",
      "api_id": "API-2015",
      "condition": "ALT-2017-CONFIG｜条件目标｜原接口/资格/稳定ID与版本已核，非按名称或首项猜配",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2017-CONFIG"
      ]
    },
    {
      "step": 15,
      "from": "ai",
      "to": "ui",
      "message": "仅凭真实原配置保存结果展示该范围更新；分类关联ref SC-2011，执行场景PAGE2110与标签场景PAGE2111分开。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2017-CONFIG｜条件目标｜原操作明确成功；不代表AI业务字段写入或自动流转",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": [
        "ALT-2017-CONFIG"
      ]
    },
    {
      "step": 16,
      "from": "ai",
      "to": "ui",
      "message": "原配置校验/保存失败或映射未核则保输入及原生效配置。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2017-SAVE｜不显示保存成功",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": [
        "ALT-2017-SAVE"
      ]
