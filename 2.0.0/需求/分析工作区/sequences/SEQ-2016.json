{
  "schema_version": "1.0",
  "id": "SEQ-2016",
  "scenario_id": "SC-2016",
  "name": "有权管理员解除公共禁呼时序",
  "status": "S5_current_design_for_review_not_implementation",
  "participants": [
    {
      "id": "admin",
      "name": "有当前租户解除管理权的人员",
      "kind": "actor"
    },
    {
      "id": "ui",
      "name": "原唯一联系限制界面",
      "kind": "system"
    },
    {
      "id": "list",
      "name": "公共禁呼解除及审计服务",
      "kind": "system"
    },
    {
      "id": "vendor",
      "name": "既有供应商同步适配/服务",
      "kind": "external_system"
    }
  ],
  "messages": [
    {
      "step": 1,
      "from": "admin",
      "to": "ui",
      "message": "选择当前租户拟解除的同一公共记录；AI快捷入口只带范围筛选。",
      "type": "request",
      "api_id": null,
      "condition": "主线｜当前已核定范围内本次操作",
      "source_step_refs": [
        1
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 2,
      "from": "ui",
      "to": "list",
      "message": "核本条解除管理权、租户及实际对象；新增权/运营称谓不代解除权。",
      "type": "request",
      "api_id": "API-2007",
      "condition": "条件目标｜本期实际调用语义/身份及对象关系已核，原准入通过；否则当前待核受阻。主线｜当前已核定范围内本次操作",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 3,
      "from": "list",
      "to": "ui",
      "message": "缺解除权或已失权拒绝；另有合法管理员权者按实际权，不因兼运营身份一概拒绝。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2016-AUTH｜本次结束",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": [
        "ALT-2016-AUTH"
      ]
    },
    {
      "step": 4,
      "from": "list",
      "to": "list",
      "message": "读取本条来源、期限、解除/到期历史及多来源状态，不复活旧记录。",
      "type": "request",
      "api_id": null,
      "condition": "主线｜当前已核定范围内本次操作",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 5,
      "from": "list",
      "to": "ui",
      "message": "读取或有效/多来源含义不可靠则保原约束，不擅自永久化/解除。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2016-LOADFAIL｜本次结束",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2016-LOADFAIL"
      ]
    },
    {
      "step": 6,
      "from": "list",
      "to": "ui",
      "message": "返回本次可靠状态及原历史，说明只解除本条来源。",
      "type": "response",
      "api_id": "API-2007",
      "condition": "条件目标｜本地状态合同与本次记录可核",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 7,
      "from": "admin",
      "to": "ui",
      "message": "填写有效原因并确认本次解除。",
      "type": "request",
      "api_id": null,
      "condition": "主线｜当前已核定范围内本次操作",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 8,
      "from": "admin",
      "to": "ui",
      "message": "取消，不改记录或历史。",
      "type": "request",
      "api_id": null,
      "condition": "ALT-2016-CANCEL｜本次结束",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": [
        "ALT-2016-CANCEL"
      ]
    },
    {
      "step": 9,
      "from": "ui",
      "to": "list",
      "message": "提交重核当前权限、准确记录/租户、版本与解除原因。",
      "type": "request",
      "api_id": "API-2007",
      "condition": "条件目标｜本期实际调用语义/身份及对象关系已核，原准入通过；否则当前待核受阻。主线｜当前已核定范围内本次操作",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 10,
      "from": "list",
      "to": "ui",
      "message": "原因缺失、目标/版本或范围校验不符，不执行解除。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2016-INVALID｜保合法输入；本次结束",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": [
        "ALT-2016-INVALID"
      ]
    },
    {
      "step": 11,
      "from": "list",
      "to": "ui",
      "message": "当前多来源有效判定/解除生效次序及审计合同未核则受阻，不报全部放行。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2016-RELEASEFAIL｜当前证据边界｜API2007 partial，原远端状态不替代本方本地解除",
      "source_step_refs": [
        5,
        6
      ],
      "covered_alternate_flow_ids": [
        "ALT-2016-RELEASEFAIL"
      ]
    },
    {
      "step": 12,
      "from": "list",
      "to": "list",
      "message": "本方按已核规则办理本条解除并留原因、人、时间，保其他来源及历史。",
      "type": "request",
      "api_id": null,
      "condition": "条件目标｜本地资格/状态/生效与恢复合同已经核实",
      "source_step_refs": [
        6
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 13,
      "from": "list",
      "to": "vendor",
      "message": "仅本条原同步配置确需且生效次序已核时，办理既有供应商对应解除/同步。",
      "type": "external_call",
      "api_id": "API-2009",
      "condition": "条件目标｜API2009真实对象/原同步合同已核；不定义新的本地/远端先后次序",
      "source_step_refs": [
        6
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 14,
      "from": "vendor",
      "to": "list",
      "message": "返回该供应商实际解除事实或失败/未知；不代替其他来源或供应商放行。",
      "type": "response",
      "api_id": "API-2009",
      "condition": "条件目标｜真实既有回执/可核结果",
      "source_step_refs": [
        6,
        7
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 15,
      "from": "list",
      "to": "ui",
      "message": "失败/不明保所有已确认事实和原来源，恢复先读实际状态，不盲重发。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2016-RELEASEFAIL｜本地/远端任一未确认，不虚报全部解除",
      "source_step_refs": [
        6,
        7
      ],
      "covered_alternate_flow_ids": [
        "ALT-2016-RELEASEFAIL"
      ]
    },
    {
      "step": 16,
      "from": "list",
      "to": "ui",
      "message": "分别返回本条本地实际结果、其他有效来源及已取得远端事实。",
      "type": "response",
      "api_id": "API-2007",
      "condition": "条件目标｜仅展示可确认结果",
      "source_step_refs": [
        7
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 17,
      "from": "ui",
      "to": "admin",
      "message": "说明本条解除不等于所有来源或所有供应商已可外呼；下一次拨前仍查限制。",
      "type": "response",
      "api_id": null,
      "condition": "本次结束｜不新增电话或解除豁免",
      "source_step_refs": [
        7
      ],
      "covered_alternate_flow_ids": []
    }
  ],
