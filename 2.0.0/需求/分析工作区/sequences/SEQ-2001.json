  "messages": [
    {
      "step": 1,
      "from": "user",
      "to": "ui",
      "message": "提交AI生产既有合法凭据，开始一次统一登录；不要求两套登录。",
      "type": "request",
      "api_id": null,
      "condition": "本次登录请求",
      "source_step_refs": [
        1
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 2,
      "from": "ui",
      "to": "auth",
      "message": "交身份接入边界验证；尚未确认身份前不读取受保护租户业务。",
      "type": "request",
      "api_id": null,
      "condition": "本次已提交登录",
      "source_step_refs": [
        1
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 3,
      "from": "auth",
      "to": "ai_identity",
      "message": "承接已有认证/令牌定义核验身份；不把仅按账号查询或退出callback当完整认证协议。",
      "type": "external_call",
      "api_id": "API-2001",
      "condition": "条件目标｜仅在相关真实契约、稳定身份/对象映射及本次权限已核实后，实际认证调用链可可靠承接时。",
      "source_step_refs": [
        1
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 4,
      "from": "ai_identity",
      "to": "auth",
      "message": "返回本次实际认证结论或失败/未知；文档候选不证明跨服务会话已互通。",
      "type": "response",
      "api_id": "API-2001",
      "condition": "条件目标｜仅响应本次合法认证请求，实际语义按API-2001核验。",
      "source_step_refs": [
        1
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 5,
      "from": "auth",
      "to": "ui",
      "message": "认证明确未通过：反馈失败并结束本次，不进入受保护功能。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2001-01｜本次认证明确失败；重新登录另算一次。",
      "source_step_refs": [
        1
      ],
      "covered_alternate_flow_ids": [
        "ALT-2001-01"
      ]
    },
    {
      "step": 6,
      "from": "auth",
      "to": "ui",
      "message": "认证/会话映射所需契约未落实或身份结果未知：本次受阻，不猜默认身份。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2001-02｜当前缺口仍保留；未知不当认证成功。",
      "source_step_refs": [
        1,
        2
      ],
      "covered_alternate_flow_ids": [
        "ALT-2001-02"
      ]
    },
    {
      "step": 7,
      "from": "auth",
      "to": "perm",
      "message": "仅身份已可靠确认后解析有权租户、模块、独立专业与管理范围。",
      "type": "request",
      "api_id": null,
      "condition": "条件目标｜认证明确有效且授权关系可核实时。",
      "source_step_refs": [
        2,
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 8,
      "from": "perm",
      "to": "ai_identity",
      "message": "按稳定身份读取原人员/租户及资源角色依据，不按姓名、手机号或品牌关系推权。",
      "type": "external_call",
      "api_id": "API-2002",
      "condition": "条件目标｜仅在相关真实契约、稳定身份/对象映射及本次权限已核实后，真实人员/租户关系查询及授权语义可核对时。",
      "source_step_refs": [
        2,
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 9,
      "from": "ai_identity",
      "to": "perm",
      "message": "返回可核对的范围依据或读取失败/关系未知；不据文档字段自行形成跨租户授权。",
      "type": "response",
      "api_id": "API-2002",
      "condition": "条件目标｜本次合法范围读取的实际结果。",
      "source_step_refs": [
        2,
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 10,
      "from": "perm",
      "to": "ui",
      "message": "关系读取失败、稳定映射或权限语义不能确认：提示本次未完成，可核对/另次重试，不当无权或空租户。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2001-02｜读取/关系核验失败或未知时停止进入。",
      "source_step_refs": [
        2,
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2001-02"
      ]
    },
    {
      "step": 11,
      "from": "perm",
      "to": "entry",
      "message": "按可靠原身份分流业务单租户、多租户或原独立平台/供应商资源/AI财务/管理范围。",
      "type": "request",
      "api_id": null,
      "condition": "条件目标｜身份和对应范围实际可核实。",
      "source_step_refs": [
        2,
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 12,
      "from": "entry",
      "to": "ui",
      "message": "单租户、仍合法历史租户及原独立平台范围自动继续；不额外增加确认弹窗。",
      "type": "response",
      "api_id": null,
      "condition": "条件目标｜唯一合法范围或仍合法历史已重验。",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 13,
      "from": "ui",
      "to": "user",
      "message": "仅需多租户手动选择时展示有权选择；失效历史租户不可恢复。",
