      "step": 25,
      "from": "ui",
      "to": "perm",
      "message": "目标读取前重验该PAGE及片段权限；入口可见不等区内全权。",
      "type": "request",
      "api_id": null,
      "condition": "本次确定目标后再次校验。",
      "source_step_refs": [
        5,
        6
      ],
      "covered_alternate_flow_ids": []
