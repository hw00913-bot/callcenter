  "status": "S5_current_design_for_review_not_implementation",
  "messages": [
    {
      "step": 1,
      "from": "user",
      "to": "ui",
      "message": "选择另一个原功能入口，或明确选择目标租户；普通区域导航保持当前租户。",
      "type": "request",
      "api_id": null,
      "condition": "本次导航/显式租户切换",
      "source_step_refs": [
        1
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 2,
      "from": "ui",
      "to": "perm",
      "message": "按实际原模块、页面/操作和目标租户核可用范围；原管理/专业权独立，不按中心名赋权。",
      "type": "request",
      "api_id": "API-2002",
      "condition": "当前身份/权限契约未核时不推定可用。",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 3,
      "from": "perm",
      "to": "ui",
      "message": "目标未开通、无权或租户失效则拒切，保留仍有权来源位置，不另选租户。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2002-01｜目标资格无效或不可靠。",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": [
        "ALT-2002-01"
      ]
    },
    {
      "step": 4,
      "from": "perm",
      "to": "guard",
      "message": "辨别同租户原Cloud现场、切到AI/原管理/不能保留现场功能、仅看监管无本人会话及显式换租户。",
      "type": "request",
      "api_id": null,
      "condition": "条件目标｜目标原操作资格可确认；同新中心内也按实际功能判断。",
      "source_step_refs": [
        1,
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 5,
      "from": "guard",
      "to": "phone_adapter",
      "message": "仅需本人电话事实时核本人当前通话/话后和电话状态；不以被监管坐席状态作本人事实。",
      "type": "request",
      "api_id": null,
      "condition": "存在或不能排除本人的原Cloud电话现场；仅明确无本人会话不强求坐席。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 6,
      "from": "phone_adapter",
      "to": "phone",
      "message": "沿已有电话状态能力取得本人当前可靠事实，不新造电话状态协议。",
      "type": "external_call",
      "api_id": "API-2010",
      "condition": "条件目标｜仅在相关真实契约、稳定身份/对象映射及本次权限已核实后，本人坐席映射、版本及状态时序可可靠核验时。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 7,
      "from": "phone",
      "to": "phone_adapter",
      "message": "返回本次电话状态/事件或失败未知；命令回执、整理标志、旧事件不等最新离线或业务话后已保存。",
      "type": "response",
      "api_id": "API-2010",
      "condition": "条件目标｜本次合法状态读取/事件的实际结果。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 8,
      "from": "phone_adapter",
      "to": "guard",
      "message": "仅交付可核对的本人最新事实；映射/状态未知保留为未知，不当已离线。",
      "type": "response",
      "api_id": null,
      "condition": "只按实际可确认电话证据处理。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 9,
      "from": "guard",
      "to": "ui",
      "message": "需切离且仍拨号/振铃/通话时本次不切；先沿原流程处理，不能自动挂机。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2002-02｜本人在途呼叫明确存在。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2002-02"
      ]
    },
    {
      "step": 10,
      "from": "guard",
      "to": "ui",
      "message": "电话/话后初始或保存后状态未知、离线失败时留原现场/输入；不以单一标志放行。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2002-06｜真实电话契约/映射未落实或本次状态/离线无法确认。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2002-06"
      ]
    },
    {
      "step": 11,
      "from": "ui",
      "to": "business",
      "message": "需切离且无在途但必要话后未保存时，复用原话后保存；如含拒联仅联合入库结果成立才算完成。",
      "type": "request",
      "api_id": "API-2005",
      "condition": "ALT-2002-03｜条件目标｜已结束当前通话且原保存/入库契约可支持；不在此补新端点。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2002-03"
      ]
    },
    {
      "step": 12,
      "from": "business",
      "to": "guard",
      "message": "话后保存失败/结果未知保留输入及来源；不继续切离。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2002-05｜必要话后未取得可靠保存完成结论。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2002-05"
      ]
    },
    {
      "step": 13,
      "from": "business",
      "to": "guard",
      "message": "交付本次必要话后真实保存完成证据，再核本人电话状态，整理结束不代保存。",
      "type": "response",
      "api_id": null,
      "condition": "条件目标｜原业务保存及必要联合结果均明确成立。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 14,
      "from": "guard",
      "to": "phone_adapter",
      "message": "无在途及未存话后，但本人仍在线时，仅退出本人电话坐席，统一系统登录保持。",
      "type": "request",
      "api_id": null,
      "condition": "ALT-2002-04｜条件目标｜确需切离且安全前置成立、本人明确在线。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2002-04"
      ]
    },
    {
      "step": 15,
      "from": "phone_adapter",
      "to": "phone",
      "message": "承接原电话离线控制；不得用强制参数打断仍在通话者。",
      "type": "external_call",
      "api_id": "API-2010",
      "condition": "条件目标｜仅在相关真实契约、稳定身份/对象映射及本次权限已核实后，本次离线控制与确认协议及安全时点可核实时。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 16,
      "from": "phone",
      "to": "phone_adapter",
      "message": "返回本次离线命令实际回执及可核对状态/事件；回执本身不单独作为离线成功。",
      "type": "response",
      "api_id": "API-2010",
      "condition": "条件目标｜本次合法电话离线操作之后。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 17,
      "from": "phone_adapter",
      "to": "guard",
      "message": "只在本人最新离线及必要话后均可靠时放行；失败/未知按保留现场分支处理。",
      "type": "response",
      "api_id": null,
      "condition": "条件目标｜离线确认可证明；否则ALT-2002-06。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2002-06"
      ]
    },
    {
      "step": 18,
      "from": "guard",
      "to": "guard",
      "message": "同租户原Cloud页（含客户档案/名单作业/云报表）沿原检查保同一电话条；仅看监管/报表且确无本人会话者只验查看权和表单，不受他人电话状态阻拦。",
      "type": "event",
      "api_id": null,
      "condition": "ALT-2002-13、ALT-2002-14｜两条互斥范围分支；原管理功能迁位仍是切离目标。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2002-13",
        "ALT-2002-14"
      ]
    },
    {
      "step": 19,
      "from": "guard",
      "to": "ui",
      "message": "切离保护成立或无需切离时继续普通表单保护；话后保存后也须确认本人离线/确无需坐席。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2002-03｜条件目标｜本次原电话检查已放行；保护失败不执行后续。",
      "source_step_refs": [
        3,
        4
      ],
      "covered_alternate_flow_ids": [
        "ALT-2002-03"
      ]
    },
    {
      "step": 20,
      "from": "ui",
      "to": "user",
      "message": "普通未保存输入沿原流程提供保存/放弃/取消；必要话后不混入可任意丢弃的普通草稿。",
      "type": "response",
      "api_id": null,
      "condition": "存在普通未保存输入。",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 21,
      "from": "user",
      "to": "ui",
      "message": "选择取消本次导航，保留普通表单及当前合法位置。",
      "type": "request",
      "api_id": null,
      "condition": "ALT-2002-09｜用户明确取消。",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": [
        "ALT-2002-09"
      ]
    },
    {
      "step": 22,
      "from": "user",
      "to": "ui",
      "message": "仅明确放弃选定的普通未保存内容后继续；已保存业务事实不撤销。",
      "type": "request",
      "api_id": null,
      "condition": "ALT-2002-08｜用户明确选择放弃普通草稿。",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": [
        "ALT-2002-08"
      ]
    },
    {
      "step": 23,
      "from": "ui",
      "to": "business",
      "message": "按原普通表单责任保存本次输入，不新增统一草稿或云端保存服务。",
      "type": "request",
      "api_id": null,
      "condition": "ALT-2002-07｜用户选择保存普通表单。",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": [
        "ALT-2002-07"
      ]
    },
    {
      "step": 24,
      "from": "business",
      "to": "ui",
      "message": "普通保存明确失败/未知时留原页与输入；仅原表单真实保存成功才继续。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2002-10｜按原保存真实结果分别处理；取消不进入本分支。",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": [
        "ALT-2002-10"
      ]
    },
    {
      "step": 25,
      "from": "ui",
      "to": "target",
      "message": "保护全部通过后按账号/来源租户/原稳定PAGE、子视图和筛选记录离开位置；管理页仍同窗口返回/同次登录记忆。",
      "type": "request",
      "api_id": null,
      "condition": "条件目标｜无未处理输入或本次普通表单已保存/明确放弃。",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 26,
      "from": "target",
      "to": "perm",
      "message": "恢复前再验目标合法范围；显式换租户只用目标自身位置，不携原对象、筛选、草稿或电话在线。",
      "type": "request",
      "api_id": null,
      "condition": "ALT-2002-15｜普通导航保持租户；显式换租户分支完成同样保护后才办理。",
      "source_step_refs": [
        6
      ],
      "covered_alternate_flow_ids": [
        "ALT-2002-15"
      ]
    },
    {
      "step": 27,
      "from": "perm",
      "to": "target",
      "message": "目标失权/无入口/读取资格未知则反馈未完成；不回滚已保存内容或已确认离线。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2002-12｜本次恢复期间权限变化或无法确认。",
      "source_step_refs": [
        6,
        7
      ],
      "covered_alternate_flow_ids": [
        "ALT-2002-12"
      ]
    },
    {
      "step": 28,
      "from": "target",
      "to": "target",
      "message": "目标历史缺失/失效按原合法入口意图回退；原管理按原有权顺序，不按六入口顺序或首次窄导入规则兜底。",
      "type": "event",
      "api_id": null,
      "condition": "ALT-2002-11｜原位置无效或缺失。",
      "source_step_refs": [
        6
      ],
      "covered_alternate_flow_ids": [
        "ALT-2002-11"
      ]
    },
    {
      "step": 29,
      "from": "target",
      "to": "ui",
      "message": "重验并读取目标最新内容；失败明确反馈未完成，不用旧缓存成功；成功仅使用本次已核目标上下文。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2002-12｜按实际读取结果分支；失败保仍可访问的来源，已保存/离线事实保持。",
      "source_step_refs": [
        7
      ],
      "covered_alternate_flow_ids": [
        "ALT-2002-12"
      ]
    },
    {
      "step": 30,
      "from": "ui",
      "to": "user",
      "message": "仅本次成功时展示原有权目标与筛选；返回不自动上线/拨号，已受理租户后台任务仍按原条件继续。",
      "type": "response",
      "api_id": null,
      "condition": "条件目标｜所有相应保护/权限/读取明确成功，非失败或取消分支。",
      "source_step_refs": [
        6,
        7
      ],
      "covered_alternate_flow_ids": []
    }
