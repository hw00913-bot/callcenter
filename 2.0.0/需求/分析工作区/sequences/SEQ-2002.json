  "scenario_id": "SC-2002",
  "name": "切换有权区域及功能并安全返回工作位置时序",
  "participants": [
    {
      "id": "user",
      "name": "当前租户成员/本人电话坐席",
      "kind": "actor"
    },
    {
      "id": "ui",
      "name": "D联络云业务导航与租户切换前端",
      "kind": "system"
    },
    {
      "id": "perm",
      "name": "目标租户与原操作范围校验（内部目标）",
      "kind": "system"
    },
    {
      "id": "guard",
      "name": "电话与话后切离保护（内部目标）",
      "kind": "system"
    },
    {
      "id": "phone_adapter",
      "name": "电话接入边界（内部目标）",
      "kind": "system"
    },
    {
      "id": "business",
      "name": "原话后及表单业务服务（内部目标）",
      "kind": "system"
    },
    {
      "id": "target",
      "name": "目标有权页面／片段恢复与读取（内部目标）",
      "kind": "system"
    },
    {
      "id": "phone",
      "name": "实际AliCti/云呼叫电话系统（生产映射待核）",
      "kind": "external_system"
    }
  ],
