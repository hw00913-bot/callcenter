{
  "schema_version": "1.0",
  "id": "SEQ-2012",
  "scenario_id": "SC-2012",
  "name": "集中查看公共与专项名单状态时序",
  "status": "S5_current_design_for_review_not_implementation",
  "participants": [
    {
      "id": "viewer",
      "name": "本租户名单有权查看人员",
      "kind": "actor"
    },
    {
      "id": "ui",
      "name": "联系限制界面",
      "kind": "system"
    },
    {
      "id": "list",
      "name": "本租户公共及专项名单服务",
      "kind": "system"
    },
    {
      "id": "sync",
      "name": "既有供应商同步事实服务",
      "kind": "external_system"
    }
  ],
  "messages": [
    {
      "step": 1,
      "from": "viewer",
      "to": "ui",
      "message": "从联系限制唯一入口查询当前租户；AI入口仅带原范围筛选。",
      "type": "request",
      "api_id": null,
      "condition": "主线｜当前已核定范围内本次操作",
      "source_step_refs": [
        1
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 2,
      "from": "ui",
      "to": "list",
      "message": "核本次租户、列表及逐条来源查看权，读取同一份名单。",
      "type": "request",
      "api_id": "API-2007",
      "condition": "条件目标｜本期实际调用语义/身份及对象关系已核，原准入通过；否则当前待核受阻。主线｜当前已核定范围内本次操作",
      "source_step_refs": [
        2,
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 3,
      "from": "list",
      "to": "ui",
      "message": "无权不展示跨租户/同品牌其他租户数据或来源。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2012-AUTH｜未获该对象查看权；本次结束",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": [
        "ALT-2012-AUTH"
      ]
    },
    {
      "step": 4,
      "from": "list",
      "to": "ui",
      "message": "当前契约/身份/有效状态不能可靠核定时受阻；读取失败不伪装0条。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2012-QUERYFAIL｜当前证据缺口或本次读取失败",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2012-QUERYFAIL"
      ]
    },
    {
      "step": 5,
      "from": "list",
      "to": "ui",
      "message": "条件具备后读取实际列表，保分组、来源、范围、期限及本地有效事实；查询不迁入历史。",
      "type": "response",
      "api_id": "API-2007",
      "condition": "条件目标｜API2007真实范围/状态合同已核，查询成功",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 6,
      "from": "ui",
      "to": "viewer",
      "message": "真实成功且无匹配时展示空态，不拼其他租户。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2012-EMPTY｜可靠查询0条；本次结束",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2012-EMPTY"
      ]
    },
    {
      "step": 7,
      "from": "viewer",
      "to": "ui",
      "message": "仅查看当前列表即结束，保查询条件。",
      "type": "request",
      "api_id": null,
      "condition": "ALT-2012-LISTONLY｜不打开详情；本次结束",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": [
        "ALT-2012-LISTONLY"
      ]
    },
    {
      "step": 8,
      "from": "viewer",
      "to": "ui",
      "message": "选择本次有权名单记录打开详情。",
      "type": "request",
      "api_id": null,
      "condition": "主线｜当前已核定范围内本次操作",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 9,
      "from": "ui",
      "to": "list",
      "message": "重核记录与来源范围，读有效/解除/到期事实；含义不明保原约束。",
      "type": "request",
      "api_id": "API-2007",
      "condition": "条件目标｜本期实际调用语义/身份及对象关系已核，原准入通过；否则当前待核受阻。主线｜当前已核定范围内本次操作",
      "source_step_refs": [
        4,
        5
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 10,
      "from": "list",
      "to": "ui",
      "message": "详情读取失败不造来源或同步成功，保列表与条件。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2012-DETAILFAIL｜本次详情未可靠取得；本次结束",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": [
        "ALT-2012-DETAILFAIL"
      ]
    },
    {
      "step": 11,
      "from": "list",
      "to": "sync",
      "message": "仅在原同步流程确有配置且本次需要读取时，取该记录已有供应商同步事实。",
      "type": "external_call",
      "api_id": "API-2009",
      "condition": "条件目标｜现网同步查询/来源映射和查看权已核；不触发新同步",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 12,
      "from": "sync",
      "to": "list",
      "message": "返回实际已有同步事实或真实失败/未知；无回执不当远端成功。",
      "type": "response",
      "api_id": "API-2009",
      "condition": "ALT-2012-DETAILFAIL｜条件目标｜原查询真实返回；未知沿详情失败/不完整处理",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": [
        "ALT-2012-DETAILFAIL"
      ]
    },
    {
      "step": 13,
      "from": "list",
      "to": "ui",
      "message": "组合本次已取得的有权来源、期限和本地/远端独立状态。",
      "type": "response",
      "api_id": null,
      "condition": "条件目标｜仅表达实际可核事实",
      "source_step_refs": [
        5,
        6
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 14,
      "from": "ui",
      "to": "viewer",
      "message": "显示逐条适用范围；专项不改成永久四类禁呼，已解除/到期不复活。",
      "type": "response",
      "api_id": null,
      "condition": "条件目标｜资料可靠；不保证四类远端均拦截成功",
      "source_step_refs": [
        6
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 15,
      "from": "list",
      "to": "list",
      "message": "保唯一名单和本次只读结果；未核历史不自动永久化或执行迁入。",
      "type": "request",
      "api_id": null,
      "condition": "本方只读责任｜结束本次，不改名单",
      "source_step_refs": [
        3,
        6
      ],
      "covered_alternate_flow_ids": []
    }
  ],
