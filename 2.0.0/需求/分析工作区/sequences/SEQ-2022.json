{
  "schema_version": "1.0",
  "id": "SEQ-2022",
  "scenario_id": "SC-2022",
  "name": "查询品牌关联租户列表时序",
  "participants": [
    {
      "id": "operator",
      "name": "有品牌查询及租户资料范围权限的管理员",
      "kind": "actor"
    },
    {
      "id": "ui",
      "name": "公共品牌列表前端",
      "kind": "system"
    },
    {
      "id": "data",
      "name": "当前授权与品牌关联基础资料责任（内部目标）",
      "kind": "system"
    }
  ],
  "status": "S5_current_design_for_review_not_implementation",
  "messages": [
    {
      "step": 1,
      "from": "operator",
      "to": "ui",
      "message": "在原品牌管理入口选品牌并发起关联租户基础资料查询。",
      "type": "request",
      "api_id": null,
      "condition": "本次只读查询请求",
      "source_step_refs": [
        1
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 2,
      "from": "operator",
      "to": "ui",
      "message": "选择后取消查询，不发起读取或归属写入，保原合法位置。",
      "type": "request",
      "api_id": null,
      "condition": "ALT-2022-01｜提交前明确取消。",
      "source_step_refs": [
        1
      ],
      "covered_alternate_flow_ids": [
        "ALT-2022-01"
      ]
    },
    {
      "step": 3,
      "from": "ui",
      "to": "data",
      "message": "按当前身份核品牌有效性和租户基础资料可见范围；不强制业务租户、成员、双模块或本人坐席。",
      "type": "request",
      "api_id": null,
      "condition": "进入原管理功能的电话/表单保护已沿SC-2002完成。",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 4,
      "from": "data",
      "to": "ui",
      "message": "无查询权/范围或读取中撤权则拒绝/移除失效展示，不泄露旧记录或无权数量。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2022-02｜本次查询前或响应时原权限失效。",
      "source_step_refs": [
        2,
        4
      ],
      "covered_alternate_flow_ids": [
        "ALT-2022-02"
      ]
    },
    {
      "step": 5,
      "from": "data",
      "to": "ui",
      "message": "品牌已失效则明确不可查看，不显示旧缓存或伪装为无关联租户。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2022-03｜所选品牌查询前或读取期间失效。",
      "source_step_refs": [
        2,
        4
      ],
      "covered_alternate_flow_ids": [
        "ALT-2022-03"
      ]
    },
    {
      "step": 6,
      "from": "data",
      "to": "ui",
      "message": "授权或品牌检查不能完成则提示本次检查未完成，保条件，不把未知当有权/空结果。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2022-07｜本次有效性检查失败或未知。",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": [
        "ALT-2022-07"
      ]
    },
    {
      "step": 7,
      "from": "data",
      "to": "data",
      "message": "仅查询所选品牌关联租户与当前有权资料范围的交集；不取无权数量或业务/任务/报表数据。",
      "type": "request",
      "api_id": null,
      "condition": "条件目标｜品牌与当前资料范围已可靠确认；本方内部查询责任。",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 8,
      "from": "data",
      "to": "ui",
      "message": "基础资料读取失败则保查询条件并明确失败，不用缓存或空列表替代成功。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2022-04｜本次实际读取失败。",
      "source_step_refs": [
        3,
        4
      ],
      "covered_alternate_flow_ids": [
        "ALT-2022-04"
      ]
    },
    {
      "step": 9,
      "from": "operator",
      "to": "ui",
      "message": "读取中切品牌、取消查询或会话失效，结束旧查询的展示资格。",
      "type": "event",
      "api_id": null,
      "condition": "ALT-2022-08｜本次尚未完成时上下文变化。",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": [
        "ALT-2022-08"
      ]
    },
    {
      "step": 10,
      "from": "ui",
      "to": "data",
      "message": "标明旧查询不再回填；切品牌由新选择另次查询，失效会话沿原规则处理。",
      "type": "event",
      "api_id": null,
      "condition": "ALT-2022-08｜原查询已取消/切品牌/会话失效。",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": [
        "ALT-2022-08"
      ]
    },
    {
      "step": 11,
      "from": "data",
      "to": "data",
      "message": "响应前复核当前品牌、会话、查询与授权仍匹配，查询时已核不代响应时有效。",
      "type": "request",
      "api_id": null,
      "condition": "取得本次读取结果时再次核对。",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 12,
      "from": "data",
      "to": "ui",
      "message": "旧查询结果不回填当前页面，不以旧缓存作成功；保准确结果事实及当前合法位置。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2022-08｜响应已不属于当前有效查询。",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": [
        "ALT-2022-08"
      ]
    },
    {
      "step": 13,
      "from": "data",
      "to": "ui",
      "message": "响应时失权/品牌失效/有效性未知分别结束本次展示并保可辨原因，不显示无权基础资料。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2022-02、ALT-2022-03、ALT-2022-07｜响应时授权撤销、品牌失效或检查无法完成。",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": [
        "ALT-2022-02",
        "ALT-2022-03",
        "ALT-2022-07"
      ]
    },
    {
      "step": 14,
      "from": "data",
      "to": "ui",
      "message": "有效授权交集确为空时显示“当前条件下无可查看的关联租户”，不推断该品牌总数或存在无权记录。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2022-05｜条件目标｜读取成功且当前品牌/查询/权限仍有效、授权交集为空。",
      "source_step_refs": [
        4,
        5
      ],
      "covered_alternate_flow_ids": [
        "ALT-2022-05"
      ]
    },
    {
      "step": 15,
      "from": "data",
      "to": "ui",
      "message": "仅返回本次有效授权交集内租户基础资料，按原字段范围只读。",
      "type": "response",
      "api_id": null,
      "condition": "条件目标｜读取明确成功且响应时上下文/权限仍有效、有可见记录。",
      "source_step_refs": [
        4,
        5
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 16,
      "from": "ui",
      "to": "operator",
      "message": "展示本次有效结果或有权范围空态；列表不改归属，不切业务租户，不授业务/财务/监管权限。",
      "type": "response",
      "api_id": null,
      "condition": "条件目标｜已接纳本次有效查询结果。",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 17,
      "from": "operator",
      "to": "ui",
      "message": "仅从本次可见记录选择前往既有归属维护，或停留只读列表；空列表无维护目标。",
      "type": "request",
      "api_id": null,
      "condition": "本次人员另行选择已有维护入口时。",
      "source_step_refs": [
        6
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 18,
      "from": "ui",
      "to": "data",
      "message": "重新核目标租户及SC-2004原独立归属维护权限；查询权不代修改权。",
      "type": "request",
      "api_id": null,
      "condition": "本次请求前往维护。",
      "source_step_refs": [
        7
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 19,
      "from": "data",
      "to": "ui",
      "message": "目标或原维护权限无效则拒绝跳转并保查询条件；查询权也失效时移除失效展示。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2022-06｜当前目标/维护权不满足。",
      "source_step_refs": [
        7
      ],
      "covered_alternate_flow_ids": [
        "ALT-2022-06"
      ]
    },
    {
      "step": 20,
      "from": "data",
      "to": "ui",
      "message": "本次维护资格检查无法完成则保只读列表/条件，不导航或当检查成功。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2022-07｜原权限或目标检查结果未知。",
      "source_step_refs": [
        7
      ],
      "covered_alternate_flow_ids": [
        "ALT-2022-07"
      ]
    },
    {
      "step": 21,
      "from": "data",
      "to": "ui",
      "message": "仅本次原维护权与准确目标可靠可用时给出既有维护入口；不保存任何归属变化。",
      "type": "response",
      "api_id": null,
      "condition": "条件目标｜独立维护资格及目标已可靠核验。",
      "source_step_refs": [
        7,
        8
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 22,
      "from": "ui",
      "to": "operator",
      "message": "导航同一SC-2004原维护流程并仅带已授权对象；实际变更由其再次控制，不新增维护库。",
      "type": "response",
      "api_id": null,
      "condition": "条件目标｜本次有权跳转已确认；否则停留列表。",
      "source_step_refs": [
        8
      ],
      "covered_alternate_flow_ids": []
    }
  ],
