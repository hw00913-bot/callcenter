{
  "schema_version": "1.0",
  "id": "SEQ-2014",
  "scenario_id": "SC-2014",
  "name": "人工核实AI拒联后加入公共禁呼时序",
  "status": "S5_current_design_for_review_not_implementation",
  "participants": [
    {
      "id": "operator",
      "name": "本租户有新增权且有来源查看权人员",
      "kind": "actor"
    },
    {
      "id": "ui",
      "name": "联系限制/原来源界面",
      "kind": "system"
    },
    {
      "id": "list",
      "name": "公共拒联服务",
      "kind": "system"
    },
    {
      "id": "ai",
      "name": "原AI通话记录服务",
      "kind": "external_system"
    }
  ],
  "messages": [
    {
      "step": 1,
      "from": "operator",
      "to": "ui",
      "message": "发起本租户AI拒联人工核实；AI标签/挂机/意向等级不自动构成拒联。",
      "type": "request",
      "api_id": null,
      "condition": "主线｜当前已核定范围内本次操作",
      "source_step_refs": [
        1
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 2,
      "from": "ui",
      "to": "list",
      "message": "分别核本租户新增及准确来源查看权；不授解除权。",
      "type": "request",
      "api_id": "API-2006",
      "condition": "条件目标｜本期实际调用语义/身份及对象关系已核，原准入通过；否则当前待核受阻。主线｜当前已核定范围内本次操作",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 3,
      "from": "list",
      "to": "ui",
      "message": "缺新增或来源权/提交时失权，拒绝且不泄露来源。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2014-AUTH｜本次结束",
      "source_step_refs": [
        2
      ],
      "covered_alternate_flow_ids": [
        "ALT-2014-AUTH"
      ]
    },
    {
      "step": 4,
      "from": "list",
      "to": "ai",
      "message": "读取本次准确有权AI来源通话及原证据，不按同号/标签猜来源。",
      "type": "external_call",
      "api_id": "API-2006",
      "condition": "条件目标｜原服务读取权、记录/租户映射及实际取数已核",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 5,
      "from": "ai",
      "to": "list",
      "message": "给出实际有权来源或真实失败/未知，不把拒接/失败标签当明确拒联。",
      "type": "response",
      "api_id": "API-2006",
      "condition": "条件目标｜原服务真实返回",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 6,
      "from": "list",
      "to": "ui",
      "message": "来源失败/非本租户/不可可靠关联则停止，不确认或入库。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2014-SOURCEFAIL｜保合法输入；本次结束",
      "source_step_refs": [
        3
      ],
      "covered_alternate_flow_ids": [
        "ALT-2014-SOURCEFAIL"
      ]
    },
    {
      "step": 7,
      "from": "ui",
      "to": "operator",
      "message": "有权呈现原通话证据，要求人员核实客户明确拒联。",
      "type": "response",
      "api_id": null,
      "condition": "条件目标｜来源可靠取得",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 8,
      "from": "operator",
      "to": "ui",
      "message": "不能确认明确拒联则不新增；无意向/拒接/挂机不是替代依据。",
      "type": "request",
      "api_id": null,
      "condition": "ALT-2014-NOREFUSAL｜本次结束",
      "source_step_refs": [
        4
      ],
      "covered_alternate_flow_ids": [
        "ALT-2014-NOREFUSAL"
      ]
    },
    {
      "step": 9,
      "from": "operator",
      "to": "ui",
      "message": "取消本次新增，保原名单。",
      "type": "request",
      "api_id": null,
      "condition": "ALT-2014-CANCEL｜本次结束",
      "source_step_refs": [
        4,
        5
      ],
      "covered_alternate_flow_ids": [
        "ALT-2014-CANCEL"
      ]
    },
    {
      "step": 10,
      "from": "operator",
      "to": "ui",
      "message": "确认明确拒联后提交本租户号码及原来源引用。",
      "type": "request",
      "api_id": null,
      "condition": "主线｜当前已核定范围内本次操作",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 11,
      "from": "ui",
      "to": "list",
      "message": "提交再次核权、号码/租户/准确来源及当前记录，不由前端旧预览放行。",
      "type": "request",
      "api_id": "API-2006",
      "condition": "条件目标｜本期实际调用语义/身份及对象关系已核，原准入通过；否则当前待核受阻。主线｜当前已核定范围内本次操作",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 12,
      "from": "list",
      "to": "ui",
      "message": "关系/号码/租户不合法则保输入，名单不变。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2014-INVALID｜本次结束",
      "source_step_refs": [
        5
      ],
      "covered_alternate_flow_ids": [
        "ALT-2014-INVALID"
      ]
    },
    {
      "step": 13,
      "from": "list",
      "to": "ui",
      "message": "来源授权/公共新增及可靠保存合同尚未核实则当前受阻；不标已新增。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2014-SAVEFAIL｜当前证据边界｜partial不足端到端证明",
      "source_step_refs": [
        5,
        6
      ],
      "covered_alternate_flow_ids": [
        "ALT-2014-SAVEFAIL"
      ]
    },
    {
      "step": 14,
      "from": "list",
      "to": "list",
      "message": "按已核本方规则保存长期公共拒联和人工确认来源，不影响正常呼入。",
      "type": "request",
      "api_id": null,
      "condition": "条件目标｜新增/来源/持久化合同经核实且全部通过",
      "source_step_refs": [
        6
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 15,
      "from": "list",
      "to": "ui",
      "message": "保存失败/未知保来源和原名单，先读实际状态再处理。",
      "type": "response",
      "api_id": null,
      "condition": "ALT-2014-SAVEFAIL｜本次结束",
      "source_step_refs": [
        6,
        7
      ],
      "covered_alternate_flow_ids": [
        "ALT-2014-SAVEFAIL"
      ]
    },
    {
      "step": 16,
      "from": "list",
      "to": "ui",
      "message": "返回本次实际本地生效事实；供应商远端状态另列。",
      "type": "response",
      "api_id": "API-2007",
      "condition": "条件目标｜实际本地可靠保存生效",
      "source_step_refs": [
        7
      ],
      "covered_alternate_flow_ids": []
    },
    {
      "step": 17,
      "from": "ui",
      "to": "operator",
      "message": "仅可靠生效才提示加入；不声称所有远端已拦截，不自动改业务字段或推进。",
      "type": "response",
      "api_id": null,
      "condition": "条件目标｜可信结果",
      "source_step_refs": [
        7
      ],
      "covered_alternate_flow_ids": []
    }
  ],
