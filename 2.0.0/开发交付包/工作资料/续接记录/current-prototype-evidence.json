  "audit_corrections": {
    "id": "AUDIT-040",
    "statement": "AI-only准入共享只读模型及异步失效检查；ELSE正文与验收统一，继承测试/入口/状态及统计修复"
  },
  "changes": [
    {
      "id": "CHG-029-NAV",
      "title": "普通导航不再以电话状态拦截",
      "acceptance_id": "AC-2138",
      "statement": "正常跨业务域、切租户及系统退出不因拨号/振铃/通话/话后/电话未知而拦截，也不强制先退出电话；身份、数据范围和普通未保存表单检查保留，撤权后的有限当前收尾是独立机制。",
      "local_ids": [
        "LOCAL-PLAT-NAVIGATE",
        "LOCAL-PLAT-CONTEXT-SWITCH",
        "LOCAL-PLAT-LOGOUT"
      ]
    },
    {
      "id": "CHG-030-DIRECTORY",
      "title": "客户档案页签与筛选记忆",
      "acceptance_id": "AC-2147",
      "statement": "业务跟进/联系档案统一页签与tabpanel，键盘方向/Home/End可用；同身份切换保各自查询/分页，跨身份不恢复旧状态，显式客户详情与原摘要刷新仍定位正确。",
      "local_ids": [
        "LOCAL-FLOW-CUSTOMER-TIMELINE",
        "LOCAL-PLAT-CUSTOMER-DIRECTORY"
      ]
    },
    {
      "id": "CHG-031-ELSE",
      "title": "当前方案强制唯一末位ELSE",
      "acceptance_id": "AC-2139",
      "statement": "所有有出口的当前新配置须有且仅有一个末位ELSE；IF/ELSE IF按优先级首命中，明确不匹配才到兜底，未知继续PENDING。保存/新导入/重开/启用均校验，不依赖DIRECT绕开分流。",
      "local_ids": [
        "LOCAL-FLOW-TEMPLATE-CREATE",
        "LOCAL-FLOW-TEMPLATE-EDIT",
        "LOCAL-FLOW-ROUTE-BIND",
        "LOCAL-FLOW-IMPORT-PREVIEW"
      ]
    },
    {
      "id": "CHG-031-NULL",
      "title": "当前选填导入缺列按空捕获",
      "acceptance_id": "AC-2140",
      "statement": "对当前可可靠读取schema内、启用且支持条件的非必填IMPORT字段，新导入/新run准备时缺列规范化为null用于判断；必填缺失或schema读取失败仍拒绝，通话/填写未知及已捕获历史缺失不在读取时补空。",
      "local_ids": [
        "LOCAL-FLOW-IMPORT-PREVIEW",
        "LOCAL-FLOW-IMPORT-COMMIT",
        "LOCAL-FLOW-REOPEN",
        "LOCAL-FLOW-ENABLE-TEMPLATE",
        "LOCAL-FLOW-RECLASSIFY"
      ]
    },
    {
      "id": "CHG-032-EDITOR",
      "title": "条件优先与未选目标草稿",
      "acceptance_id": "AC-2142",
      "statement": "节点按命名→条件→下一节点→继续条件编辑，末位轻量“其他情况”；未选目标可留编辑草稿但不产生业务连线，保存仍逐项拒绝缺项并定位。",
      "local_ids": [
        "LOCAL-FLOW-TEMPLATE-CREATE",
        "LOCAL-FLOW-TEMPLATE-EDIT"
      ]
    },
    {
      "id": "CHG-032-END",
      "title": "END两种动作及真实接续",
      "acceptance_id": "AC-2141",
      "statement": "END只配置名称和DIRECT_FOLLOWUP/CLOSE两种后续动作。先结束原run；CLOSE不再跟进，DIRECT_FOLLOWUP同record/当前tenant生成无模板人工周期，不自动起呼。合法END来源可授权此接续，即使分类没有开放普通DIRECT导入；原run/节点/call/快照保留，原人员仅当前仍有效且具电话资格时沿用。",
      "local_ids": [
        "LOCAL-FLOW-END-HANDOFF"
      ]
    },
    {
      "id": "CHG-033-TASK",
      "title": "任务页移除额外统计模块",
      "acceptance_id": "AC-2148",
      "statement": "预外呼及IVR页不额外显示“今日任务名单分布”，保原任务查询/筛选/空态/重置和专业报表口径；不因此删除底层任务状态或统计能力。",
      "local_ids": [
        "LOCAL-PLAT-CLOUD-TASK-QUERY"
      ]
    },
    {
      "id": "CHG-034-RULE",
      "title": "条件即时修改与防环",
      "acceptance_id": "AC-2143",
      "statement": "条件修改直接进入当前草稿，不再显示待应用三按钮；兼容operator保值，字段/来源或不兼容类型/基数变化清不适用比较值，空判断清值。目标选择/拖线拒环并保原草稿，保存仍防绕过。",
      "local_ids": [
        "LOCAL-FLOW-TEMPLATE-CREATE",
        "LOCAL-FLOW-TEMPLATE-EDIT"
      ]
    },
    {
      "id": "CHG-035-SIP",
      "title": "人工/预外呼客户侧SIP判断",
      "acceptance_id": "AC-2144",
      "statement": "流转判断分别使用TIANRUN_MANUAL_SIP_CAUSE和TIANRUN_PREDICTIVE_SIP_CAUSE客户侧结果：200已接通、710～724当前字典；不再用1～4接听标记推断，不改AI状态域或原专业记录的其他状态展示。新回执与实际方式/原段/场景准确关联，未知PENDING。",
      "local_ids": [
        "LOCAL-FLOW-CALL-FACTS",
        "LOCAL-FLOW-EVALUATE"
      ]
    },
    {
      "id": "CHG-036-LOCAL",
      "title": "本租户路径继续办理",
      "acceptance_id": "AC-2145",
      "statement": "线索域转交组件允许CURRENT本租户分支；命中后保持owner、run及tenant阶段，不新建跨租户截止/轮次，不清原安排与封存结果，并重核后继CALL资格。OTHER仍执行原意向锚定和跨租户保护；CURRENT不冒充OTHER，拒伪造目标或过期令牌。",
      "local_ids": [
        "LOCAL-FLOW-TRANSFER",
        "LOCAL-FLOW-IMPORT-PREVIEW",
        "LOCAL-FLOW-TEMPLATE-EDIT"
      ]
    },
    {
      "id": "CHG-037-038-FEEDBACK",
      "title": "多值提示及错误定位",
      "acceptance_id": "AC-2146",
      "statement": "普通及START比较值提示“多个值请换行填写/每行一个值”，保持IN/NOT_IN类型含义；报错节点/START/提示区统一浅红，切换节点保留定位，编辑该节点清当前标记，保存重新判断，不改变原校验。",
      "local_ids": [
        "LOCAL-FLOW-TEMPLATE-CREATE",
        "LOCAL-FLOW-TEMPLATE-EDIT"
      ]
    },
    {
      "id": "CHG-039-ENTRY",
      "title": "移除分类行AI标签快捷入口",
      "acceptance_id": "AC-2149",
      "statement": "业务分类行只保编辑/路由配置/预览/删除；不恢复AI标签配置快捷按钮。标签维护仍在呼叫中心AI配置的独立有权入口，原具体AI场景分类引用及其稳定身份保留。",
