{
  "schema_version": "1.0",
  "id": "SC-008",
  "name": "接入阿里或外部线路号码并授权租户",
  "summary": "区分阿里号码同步/关联与外部企业号码导入，不把导入成功当线路开通；号码实例独占、同实例多租户授权",
  "actors": [
    "超级管理员",
    "统一外呼中台",
    "线路供应商/阿里开通服务",
    "阿里云CCC"
  ],
  "trigger": "线路资源需要进入当前实例并开放使用",
  "preconditions": [
    "已确定目标 CCC 实例和外部线路供应商"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "超级管理员",
      "action": "选择阿里号码或外部企业号码路径",
      "system_response": "资源接入申请",
      "input": "供应商、实例、所需方向",
      "rule_ids": [
        "BR-008"
      ]
    },
    {
      "step": 2,
      "actor": "线路供应商/阿里开通服务",
      "action": "先完成购买/线路开通与必要配置",
      "system_response": "开通依据；非中台页面自动开通",
      "input": "合同、资质、网络与路由信息",
      "rule_ids": [
        "BR-008"
      ]
    },
    {
      "step": 3,
      "actor": "超级管理员",
      "action": "阿里号码同步选择；外部号码提交导入",
      "system_response": "导入/同步请求",
      "input": "已开通号码或企业号码资料",
      "rule_ids": [
        "BR-008"
      ]
    },
    {
      "step": 4,
      "actor": "阿里云CCC",
      "action": "接收号码导入或返回可用号码",
      "system_response": "号码目录与处理结果",
      "input": "号码及所需参数",
      "rule_ids": [
        "BR-008"
      ]
    },
    {
      "step": 5,
      "actor": "统一外呼中台",
      "action": "号码归属、线路可用及实例关联已确认？",
      "system_response": "满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "input": "前一步操作与当前上下文",
      "rule_ids": [
        "BR-008"
      ]
    },
    {
      "step": 6,
      "actor": "统一外呼中台",
      "action": "关联当前实例并保存来源映射",
      "system_response": "号码唯一实例归属",
      "input": "号码与线路标识",
      "rule_ids": [
        "BR-008"
      ]
    },
    {
      "step": 7,
      "actor": "超级管理员",
      "action": "授权同实例一个或多个租户及用途",
      "system_response": "租户用号授权",
      "input": "已关联号码、租户、呼入/呼出",
      "rule_ids": [
        "BR-008"
      ]
    },
    {
      "step": 8,
      "actor": "统一外呼中台",
      "action": "保存授权并保留校验边界",
      "system_response": "未授权租户不能用号；共享不等于数据共享",
      "input": "实例号码与租户范围",
      "rule_ids": [
        "BR-008"
      ]
    }
  ],
  "alternate_flows": [
