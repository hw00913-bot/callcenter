{
  "schema_version": "1.0",
  "id": "SEQ-008",
  "scenario_id": "SC-008",
  "name": "接入AliCti或外部线路号码并授权租户时序",
  "participants": [
    {
      "id": "u",
      "name": "当前有权操作人",
      "kind": "actor"
    },
    {
      "id": "ui",
      "name": "中台页面",
      "kind": "system"
    },
    {
      "id": "svc",
      "name": "中台业务服务",
      "kind": "system"
    },
    {
      "id": "db",
      "name": "中台数据存储",
      "kind": "system"
    },
    {
      "id": "vendor",
      "name": "AliCti",
      "kind": "external_system"
    }
  ],
  "messages": [
    {
      "step": 1,
      "from": "u",
      "to": "ui",
      "message": "线路资源需要进入当前供应商账号并开放使用",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 2,
      "from": "ui",
      "to": "svc",
      "message": "提交当前登录态、租户及业务操作；供应商账号由授权映射确定",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 3,
      "from": "svc",
      "to": "db",
      "message": "校验当前用户、租户、enterpriseId和目标业务对象权限",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 4,
      "from": "db",
      "to": "svc",
      "message": "返回授权上下文及有效业务数据",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 5,
      "from": "svc",
      "to": "ui",
      "message": "拒绝越权/失效操作，保留输入且不调用供应商",
      "type": "error",
      "api_id": null,
      "condition": "校验失败；本路径结束"
    },
    {
      "step": 6,
      "from": "u",
      "to": "ui",
      "message": "选择供应商已有号码同步或外部号码接入路径",
      "type": "request",
      "api_id": null,
      "condition": "前置业务条件成立"
    },
    {
      "step": 7,
      "from": "svc",
      "to": "ui",
      "message": "号码远端开通契约未明确；显示待确认，已存在号码可按查询接口同步",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 8,
      "from": "u",
      "to": "ui",
      "message": "查询已开通号码；外部来源仅在接入确认后登记",
      "type": "request",
      "api_id": null,
      "condition": "前置业务条件成立"
    },
    {
      "step": 9,
      "from": "svc",
      "to": "vendor",
      "message": "按enterpriseId分页查询企业号码，每页不超过1000",
      "type": "request",
      "api_id": "API-310",
      "condition": "对应操作/呼叫类型，且其前置路径成立"
    },
    {
      "step": 10,
      "from": "vendor",
      "to": "svc",
      "message": "返回号码、用途标记、状态及中继信息",
      "type": "response",
      "api_id": "API-310",
      "condition": "对应操作/呼叫类型，且其前置路径成立"
    },
    {
      "step": 11,
      "from": "svc",
      "to": "svc",
      "message": "号码归属、线路可用及供应商账号关联已确认？；满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 12,
      "from": "svc",
      "to": "svc",
      "message": "关联当前供应商账号并保存来源映射；号码唯一供应商账号归属",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 13,
      "from": "u",
      "to": "ui",
      "message": "授权同供应商账号一个或多个租户及用途",
      "type": "request",
      "api_id": null,
      "condition": "前置业务条件成立"
    },
    {
      "step": 14,
      "from": "svc",
      "to": "svc",
      "message": "保存授权并保留校验边界；未授权租户不能用号；共享不等于数据共享",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 15,
      "from": "svc",
      "to": "ui",
      "message": "显示待开通/失败/待核对；导入成功不当作可呼叫",
      "type": "error",
      "api_id": null,
      "condition": "号码归属、线路可用及供应商账号关联已确认？：不满足"
    },
    {
      "step": 16,
      "from": "svc",
      "to": "ui",
      "message": "返回已证实结果；未知能力显示待确认，保留数据并可再次核对",
      "type": "response",
      "api_id": null,
      "condition": null
    }
  ],
  "notes": [
    "接口能力以AliCti文档为最终事实；未明确支持显示待确认，不生成虚构远端成功。",
    "中台权限、数据归属和业务结果保存是本平台职责。演示数据不代表真实联调。"
  ],
  "source_refs": [
    "inputs/source-index.json#SRC-302",
    "inputs/user-instructions.md#本轮差异处理确认"
  ]
}
