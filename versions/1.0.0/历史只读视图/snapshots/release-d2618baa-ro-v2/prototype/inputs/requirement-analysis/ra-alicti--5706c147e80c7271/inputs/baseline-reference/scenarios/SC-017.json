{
  "schema_version": "1.0",
  "id": "SC-017",
  "name": "客户呼入、IVR 导航与人工接听",
  "summary": "客户通过实例共享号码进入 IVR，由分支或默认兜底锁定租户，再路由到该租户合适坐席完成服务。",
  "actors": [
    "来电客户",
    "统一外呼中台",
    "阿里云 CCC",
    "本租户承接坐席"
  ],
  "trigger": "客户拨打已启用的实例共享呼入号码",
  "preconditions": [
    "共享号码、实例级 IVR、分支—租户映射、默认租户及各租户呼入规则已启用"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "来电客户",
      "action": "客户拨打已开通的实例呼入号码",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-017"
      ]
    },
    {
      "step": 2,
      "actor": "阿里云 CCC",
      "action": "执行已发布 IVR 分支，在转人工前锁定唯一租户",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-017"
      ]
    },
    {
      "step": 3,
      "actor": "统一外呼中台",
      "action": "目标租户、授权号码及承接技能有效？",
      "system_response": "通过才继续；不通过结束本次操作",
      "rule_ids": [
        "BR-017"
      ]
    },
    {
      "step": 4,
      "actor": "阿里云 CCC",
      "action": "将通话路由给本租户已上线空闲坐席",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-017"
      ]
    },
    {
      "step": 5,
      "actor": "统一外呼中台",
      "action": "自有界面收到来电提示，坐席经 Core SDK 接听，WebRTC 承担音频",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-017"
      ]
    },
    {
      "step": 6,
      "actor": "本租户承接坐席",
      "action": "处理客户问题并填写本平台跟进结果",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-017"
      ]
    },
    {
      "step": 7,
      "actor": "统一外呼中台",
      "action": "按锁定租户及规范化手机号展示平台档案；各批次记录分别保留",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-017"
      ]
    },
    {
      "step": 8,
      "actor": "统一外呼中台",
      "action": "结束后归集最终话单与适用录音；保存结果后再恢复就绪",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-017"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-017-3",
      "condition": "目标租户、授权号码及承接技能有效？：不通过",
      "steps": [
        "执行本号码已发布兜底流程，不跨租户寻找坐席"
      ]
