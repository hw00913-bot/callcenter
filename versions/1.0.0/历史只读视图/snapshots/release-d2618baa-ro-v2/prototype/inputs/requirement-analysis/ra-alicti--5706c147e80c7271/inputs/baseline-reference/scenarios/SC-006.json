  "name": "创建逻辑技能模板与租户物理技能组",
  "summary": "复用售前、售后等业务分类，同时用租户独占的阿里物理技能组保证原生路由不跨租户。",
  "actors": [
    "超级管理员",
    "统一外呼中台",
    "阿里云CCC"
  ],
  "trigger": "某实例需要新增可复用技能分类，或某租户需要启用既有技能分类",
  "preconditions": [
    "超级管理员已选定实例；目标租户绑定该实例并启用联络中心能力"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "超级管理员",
      "action": "选择实例技能分类与目标租户",
      "system_response": "逻辑模板及物理组创建申请",
      "input": "售前/售后等逻辑分类、租户",
      "rule_ids": [
        "BR-006"
      ]
    },
    {
      "step": 2,
      "actor": "统一外呼中台",
      "action": "同一实例且映射不冲突？",
      "system_response": "满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "input": "前一步操作与当前上下文",
      "rule_ids": [
        "BR-006"
      ]
    },
    {
      "step": 3,
      "actor": "统一外呼中台",
      "action": "准备租户独占物理组",
      "system_response": "厂商创建参数",
      "input": "逻辑模板、租户归属",
      "rule_ids": [
        "BR-006"
      ]
    },
    {
      "step": 4,
      "actor": "阿里云CCC",
      "action": "创建或查询目标技能组",
      "system_response": "物理技能组ID",
      "input": "实例及技能组资料",
      "rule_ids": [
        "BR-006"
      ]
    },
    {
      "step": 5,
      "actor": "统一外呼中台",
      "action": "物理组已确认创建且归属正确？",
      "system_response": "满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "input": "前一步操作与当前上下文",
      "rule_ids": [
        "BR-006"
      ]
    },
    {
      "step": 6,
      "actor": "统一外呼中台",
      "action": "保存模板到租户物理组映射",
      "system_response": "实例分类可复用；组内ACD不跨租户",
      "input": "厂商技能组ID",
      "rule_ids": [
        "BR-006"
      ]
    }
  ],
  "alternate_flows": [
