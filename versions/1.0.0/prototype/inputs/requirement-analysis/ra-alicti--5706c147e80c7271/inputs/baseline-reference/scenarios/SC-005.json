  "name": "联络中心身份停用、恢复与删除",
  "summary": "由管理员独立控制电话能力生命周期，在不打断进行中通话的前提下完成状态变更并永久保留历史。",
  "actors": [
    "租户管理员",
    "统一外呼中台",
    "阿里云CCC"
  ],
  "trigger": "租户管理员主动选择停用、恢复或删除联络中心身份",
  "preconditions": [
    "联络中心身份已归属当前租户，并具有可核验的中台与阿里实际状态"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "租户管理员",
      "action": "选择坐席停用、恢复或删除",
      "system_response": "生命周期操作申请",
      "input": "本租户坐席与当前状态",
      "rule_ids": [
        "BR-005"
      ]
    },
    {
      "step": 2,
      "actor": "统一外呼中台",
      "action": "有权限且满足所选操作前置条件？",
      "system_response": "满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "input": "前一步操作与当前上下文",
      "rule_ids": [
        "BR-005"
      ]
    },
    {
      "step": 3,
      "actor": "统一外呼中台",
      "action": "停用先禁止新任务；恢复按当前配置复检",
      "system_response": "当前通话允许完成；未就绪不得恢复",
      "input": "所选操作、通话状态、当前配置",
      "rule_ids": [
        "BR-005"
      ]
    },
    {
      "step": 4,
      "actor": "阿里云CCC",
      "action": "执行相应电话状态或用户操作",
      "system_response": "厂商状态或待核对结果",
      "input": "坐席映射及操作要求",
      "rule_ids": [
        "BR-005"
      ]
    },
    {
      "step": 5,
      "actor": "统一外呼中台",
      "action": "操作成功且进行中通话已安全结束？",
      "system_response": "满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "input": "前一步操作与当前上下文",
      "rule_ids": [
        "BR-005"
      ]
    },
    {
      "step": 6,
      "actor": "统一外呼中台",
      "action": "确认生命周期结果并保留历史",
      "system_response": "停用/恢复/删除状态；历史记录不删",
      "input": "厂商结果与引用检查",
      "rule_ids": [
        "BR-005"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-005-2",
      "condition": "有权限且满足所选操作前置条件？：不满足",
