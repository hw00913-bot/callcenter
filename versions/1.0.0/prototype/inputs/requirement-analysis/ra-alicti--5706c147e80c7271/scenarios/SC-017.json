{
  "schema_version": "1.0",
  "id": "SC-017",
  "name": "客户呼入、IVR 导航与人工接听",
  "summary": "客户通过供应商账号共享号码进入 IVR，由分支或默认兜底锁定租户，再路由到该租户合适坐席完成服务。",
  "actors": [
    "来电客户",
    "统一外呼中台",
    "AliCti",
    "本租户承接坐席"
  ],
  "trigger": "客户拨打已启用的供应商账号共享呼入号码",
  "preconditions": [
    "共享号码、供应商账号级 IVR、分支—租户映射、默认租户及各租户呼入规则已启用"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "来电客户",
      "action": "客户拨打已开通的供应商账号呼入号码",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-017"
      ]
    },
    {
      "step": 2,
      "actor": "AliCti",
      "action": "在已验证的号码入口与语音导航中锁定唯一租户",
      "system_response": "不明确归属进入异常，不路由到任意租户",
      "rule_ids": [
        "BR-017"
      ],
      "input": "当前租户及enterpriseId范围内经授权的业务上下文"
    },
    {
      "step": 3,
      "actor": "统一外呼中台",
      "action": "目标租户、授权号码及承接技能有效？",
      "system_response": "通过才继续；不通过结束本次操作",
      "rule_ids": [
        "BR-017"
      ]
    },
    {
      "step": 4,
      "actor": "AliCti",
      "action": "将通话路由给本租户已上线空闲坐席",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-017"
      ]
    },
    {
      "step": 5,
      "actor": "统一外呼中台",
      "action": "自有界面收到来电并通过软电话接听",
      "system_response": "CTILink.SipSession接听；音频状态与业务接通分开",
      "rule_ids": [
        "BR-017"
      ],
      "input": "当前租户及enterpriseId范围内经授权的业务上下文"
    },
    {
      "step": 6,
      "actor": "本租户承接坐席",
      "action": "处理客户问题并填写本平台跟进结果",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-017"
      ]
    },
    {
      "step": 7,
      "actor": "统一外呼中台",
      "action": "按锁定租户及规范化手机号展示平台档案；各批次记录分别保留",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-017"
      ]
    },
    {
      "step": 8,
      "actor": "统一外呼中台",
      "action": "结束后归集来电话单与媒体并保存话后",
      "system_response": "系统应答不计人工接听；保存前保护就绪状态",
      "rule_ids": [
        "BR-017"
      ],
      "input": "当前租户及enterpriseId范围内经授权的业务上下文"
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-017-3",
      "condition": "目标租户、授权号码及承接技能有效？：不通过",
      "steps": [
        "执行本号码已发布兜底流程，不跨租户寻找坐席"
      ]
    }
  ],
  "postconditions": [
    "客户通过供应商账号共享号码进入 IVR，由分支或默认兜底锁定租户，再路由到该租户合适坐席完成服务。"
  ],
  "acceptance_points": [
    "来电入 IVR 与坐席接听分开记录；不等待异步轨迹到达后才路由。",
    "沿用已确认呼入场景；自有界面的实时媒体及模式联调未通过前不能宣称已上线。"
  ],
  "source_story_ids": [
