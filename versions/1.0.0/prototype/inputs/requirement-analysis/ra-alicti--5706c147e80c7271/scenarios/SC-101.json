{
  "schema_version": "1.0",
  "id": "SC-101",
  "name": "在账号管理关联现有或新建坐席",
  "summary": "管理员从账号列表为当前租户成员关联现有坐席，或带入账号资料新建并关联。",
  "actors": [
    "租户管理员/超级管理员",
    "统一外呼中台"
  ],
  "trigger": "已有账号需要在中台工作台外呼",
  "preconditions": [
    "目标账号为当前租户有效成员"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "租户管理员/超级管理员",
      "action": "账号列表选择“关联坐席”，账号新增和编辑沿用线上表单",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-101"
      ]
    },
    {
      "step": 2,
      "actor": "统一外呼中台",
      "action": "成员、坐席及操作人同租户且有权？",
      "system_response": "通过才继续；不通过结束本次操作",
      "rule_ids": [
        "BR-101"
      ]
    },
    {
      "step": 3,
      "actor": "租户管理员/超级管理员",
      "action": "选择未被关联的现有坐席，或进入新建坐席分支",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-101"
      ]
    },
    {
      "step": 4,
      "actor": "统一外呼中台",
      "action": "新建分支先完成 SC-003 并确认实际坐席，现有分支直接复检",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-101"
      ]
    },
    {
      "step": 5,
      "actor": "统一外呼中台",
      "action": "坐席已有效开通、未被其他账号占用且不在使用中换绑？",
      "system_response": "通过才继续；不通过结束本次操作",
      "rule_ids": [
        "BR-101"
      ]
    },
    {
      "step": 6,
      "actor": "统一外呼中台",
      "action": "原子保存平台账号与本租户坐席的一对一关系",
      "system_response": "平台accountId—本地坐席ID—enterpriseId/cno，UUID不参与",
      "rule_ids": [
        "BR-101"
      ],
      "input": "当前租户及enterpriseId范围内经授权的业务上下文"
    },
    {
      "step": 7,
      "actor": "租户管理员/超级管理员",
      "action": "账号列表显示已开通/未开通及关联结果；有资源并上线后才可通话",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-101"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-101-2",
      "condition": "成员、坐席及操作人同租户且有权？：不通过",
      "steps": [
        "拒绝越权；不把账号角色直接视为电话资格"
      ]
    },
    {
      "id": "ALT-101-5",
      "condition": "坐席已有效开通、未被其他账号占用且不在使用中换绑？：不通过",
      "steps": [
        "保留原关系；新建失败不显示已关联，不自动删除已创建的坐席"
      ]
    }
  ],
  "postconditions": [
    "管理员从账号列表为当前租户成员关联现有坐席，或带入账号资料新建并关联。"
  ],
  "acceptance_points": [
    "现有坐席和新建坐席二选一；一个坐席不得同时关联多个账号。",
    "取消不保存关系；创建失败、保存失败均明确反馈，不显示虚假成功。"
  ],
  "source_story_ids": [
    "US-101"
  ],
  "source_refs": [
    "inputs/baseline-reference/scenarios/SC-101.json",
    "inputs/source-index.json#SRC-302",
    "inputs/source-index.json#SRC-303"
  ],
