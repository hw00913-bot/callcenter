{
  "schema_version": "1.0",
  "id": "SC-007",
  "name": "为坐席分配多个技能组和技能等级",
  "summary": "维护技能与路由优先级，按skillLevels越小优先；合法值域待确认。",
  "actors": [
    "租户管理员",
    "统一外呼中台",
    "AliCti"
  ],
  "trigger": "新坐席需要分配业务能力，或现有坐席职责变化",
  "preconditions": [
    "本租户已有可用物理技能组；坐席已启用且归属当前租户"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "租户管理员",
      "action": "选择坐席及多个本租户技能组",
      "system_response": "成员关系调整申请",
      "input": "坐席、技能组、技能等级",
      "rule_ids": [
        "BR-007"
      ]
    },
    {
      "step": 2,
      "actor": "统一外呼中台",
      "action": "坐席和组同租户同供应商账号且有效？",
      "system_response": "满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "input": "前一步操作与当前上下文",
      "rule_ids": [
        "BR-007"
      ]
    },
    {
      "step": 3,
      "actor": "统一外呼中台",
      "action": "读取既有技能并形成完整目标技能列表",
      "system_response": "保留未修改技能；数值越小优先；合法值域待确认",
      "input": "当前租户及enterpriseId范围内经授权的业务上下文",
      "rule_ids": [
        "BR-007"
      ]
    },
    {
      "step": 4,
      "actor": "AliCti",
      "action": "全量更新坐席技能并返回逐项结果",
      "system_response": "skillIds/skillLevels；小值优先，逐个核对failCno",
      "input": "当前租户及enterpriseId范围内经授权的业务上下文",
      "rule_ids": [
        "BR-007"
      ]
    },
    {
      "step": 5,
      "actor": "统一外呼中台",
      "action": "目标坐席均已确认成功且技能列表一致？",
      "system_response": "部分失败不当全量成功，在线限制明确提示",
      "input": "当前租户及enterpriseId范围内经授权的业务上下文",
      "rule_ids": [
        "BR-007"
      ]
    },
    {
      "step": 6,
      "actor": "统一外呼中台",
      "action": "显示生效成员及等级",
      "system_response": "人工配置承接范围，厂商在组内按路由分配",
      "input": "厂商结果",
      "rule_ids": [
        "BR-007"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-007-2",
      "condition": "坐席和组同租户同供应商账号且有效？：不满足",
      "steps": [
        "拦截跨租户、失效组及无权变更"
      ],
      "continuation": "本次操作结束；修正后由用户重新发起，不自动重试不可重复动作。"
    },
    {
      "id": "ALT-007-5",
      "condition": "变更已确认生效？：不满足",
      "steps": [
        "保留失败项；管理员按项重试；不假装已具备技能"
      ],
      "continuation": "本次操作结束；修正后由用户重新发起，不自动重试不可重复动作。"
    },
    {
      "id": "ALT-007-CANCEL",
      "condition": "执行变更前取消确认",
      "steps": [
        "取消提交：不执行本次变更，保留已有有效数据"
      ]
    }
  ],
  "postconditions": [
    "维护技能与路由优先级，按skillLevels越小优先；合法值域待确认。"
  ],
  "acceptance_points": [
    "由租户管理员人工决定坐席可承接的业务，并让AliCti按skillLevels数值越小优先级越高执行分配，合法值域待确认。",
    "权限或资源条件不满足时明确拦截，不跨租户执行，不伪造成功；具体失败/超时与补偿边界见本场景图及关联接口核验。"
  ],
  "source_story_ids": [
    "US-007"
  ],
