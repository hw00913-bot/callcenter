{
  "schema_version": "1.0",
  "id": "SC-006",
  "name": "运营精准删除指定供应商记录与本地计划停止",
  "summary": "有原任务操作权限的运营/管理员明确选定并确认唯一记录，原子停止该目标未执行失败计划；可精准表达时才候选供应商删除，本地取消与远端结果分别保存。",
  "actors": [
    "有权运营和管理员（沿任务现有权限）",
    "云呼叫中心",
    "AliCti供应商"
  ],
  "trigger": "有该任务权限的运营或管理员在既有任务记录选择具体对象并确认删除",
  "scope": "in_scope",
  "status": "S3_current_Tianwang_G1_scope_preserved_delete_G2_pending",
  "source_story_ids": [
    "US-008"
  ],
  "source_refs": [
    "inputs/source-index.json#SRC-110",
    "inputs/source-index.json#SRC-107",
    "inputs/source-index.json#SRC-109",
    "inputs/source-index.json#SRC-115",
    "inputs/source-index.json#SRC-116"
  ],
  "business_rule_ids": [
    "BR-007",
    "BR-012",
    "BR-013",
    "BR-015",
    "BR-016",
    "BR-019"
  ],
  "acceptance_points": [
    "AC-016",
    "AC-024",
    "AC-025",
    "AC-061"
  ],
  "design_notes": [
    "独立发起意图复用既有PAGE-002/删除记录操作；不新增顶级页面、权限授予或通用策略操作。",
    "SRC-107tels优先不是与fileId取AND；仅独占fileId是本轮候选精确选择器，不设默认skip值。",
    "确认/权限/预算与当前目标必须服务端守卫；未知响应不等删除成功，更不证明在途撤回。",
    "SRC-115及本轮实际G1恢复DCC完整闭环，指定删除仍仅原任务有权运营/管理员；此场景主/备选步骤及图逐值保持，不恢复DCC删除或扩同号/root。",
    "本轮范围批准不代表G2/G3或生产接口确认；原删除/在途/授权/原子证据缺口继续保留。"
  ],
  "preconditions": [
    "当前登录身份在授权tenant/原task内沿既有任务操作权限允许删除该准确对象；不是仅角色名或按钮可见。",
    "具体record/batch/phone映射准确，保存root、每次真实supplier fileId及内部attempt关联可核；不按leadCode/root/最近同号扩大范围。",
    "真实AliCti删除/跳过/在途和取消并发仍partial；独占fileId选择器仅候选，共享fileId多attempt不可定位则不外发。"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "有权运营和管理员（沿任务现有权限）",
      "action": "在既有任务记录选择具体供应商号码记录发起删除",
      "system_response": "加载本次record/batch/实际fileId/phone及保存root；切换目标/结果样例清此前反馈，不抹旧目标业务证据。",
      "rule_ids": [
        "BR-007",
        "BR-016"
      ]
    },
    {
      "step": 2,
      "actor": "有权运营和管理员（沿任务现有权限）",
      "action": "核对本次精确对象并明确确认删除",
      "system_response": "取消不操作；服务端每次核当前身份/tenant/task/该对象的原任务操作权限及目标版本，拒绝/冲突不误删其他对象。",
      "rule_ids": [
        "BR-007",
        "BR-015",
        "BR-016"
      ]
    },
    {
      "step": 3,
      "actor": "云呼叫中心",
      "action": "对已授权且准确确认的目标原子保存取消意图，停止其尚未执行失败计划",
      "system_response": "只作用该记录关联待执行计划，不按root/leadCode清组；保留停止证据、已用与UNKNOWN占用，不把本地停止显示为远端已删或在途已撤回。",
      "rule_ids": [
        "BR-007",
        "BR-013",
        "BR-015"
      ]
    },
    {
      "step": 4,
      "actor": "云呼叫中心",
      "action": "核实本次实际fileId是否独占该精确目标并可用于供应商删除",
      "system_response": "tels优先于fileId/fileName而非AND；仅独占fileId时，以原taskId+fileId候选按批选择、不同时传tels。不确定或共享fileId多attempt无法定位则保留待核、不外发、不扩大同号范围。",
      "rule_ids": [
        "BR-007",
        "BR-012",
        "BR-015"
      ]
    },
    {
      "step": 5,
      "actor": "云呼叫中心",
      "action": "准确选择器和当前守卫通过时，候选发起本次供应商删除",
      "system_response": "不新增默认skipCalling/skipRetry或先删后重导策略；重复/UNKNOWN沿原操作证据核查，不盲重发。生产接口仍partial，只使用独立合成情形。",
      "rule_ids": [
        "BR-007",
        "BR-015"
      ]
    },
    {
      "step": 6,
      "actor": "AliCti供应商",
      "action": "返回本次供应商原始删除结果与skippedCallingTels等可核证据",
      "system_response": "result=0也可能跳过目标，必须核本次目标是否实际被删；skipRetry不证明原生后续重呼停止，不假造在途撤回。",
      "rule_ids": [
        "BR-007",
        "BR-015"
      ]
    },
    {
      "step": 7,
      "actor": "云呼叫中心",
      "action": "只在当前精确目标明确成功时标其已从供应商删除；拒绝/跳过/UNKNOWN分别保存",
      "system_response": "本地record/root/fileId/call、秒挂三态、内部计划/attempt、共享已用/UNKNOWN预算和去重证据保留，不级联其他同号/主子/任务。",
      "rule_ids": [
        "BR-007",
        "BR-013",
        "BR-015",
        "BR-019"
      ]
    },
    {
      "step": 8,
      "actor": "有权运营和管理员（沿任务现有权限）",
      "action": "查看本次精准目标的本地待计划停止与供应商删除结果",
      "system_response": "本地停止和远端成功/拒绝/跳过/UNKNOWN分别显示；保存历史业务证据、失败额度不重置，秒挂没有可停止的本方重导计划。",
      "rule_ids": [
        "BR-007",
        "BR-011",
        "BR-013",
        "BR-019"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-001",
      "condition": "用户取消本次删除确认",
      "steps": [
        "不停止计划、不调用供应商、不修改任何目标结果。"
      ]
    },
    {
      "id": "ALT-002",
      "condition": "当前任务/对象权限不足或确认前身份/目标版本变化",
      "steps": [
        "服务端拒绝或重新核当前目标；不授予新权限、不借旧选择误删。"
      ]
    },
    {
      "id": "ALT-003",
      "condition": "记录/批次/fileId/phone关联缺失、多候选或真实冲突",
      "steps": [
        "待核，不猜根或按最近同号确定目标，不进行远端删除。"
      ]
    },
    {
      "id": "ALT-004",
      "condition": "实际fileId共享多个attempt或选择器无法仅表示当前目标",
      "steps": [
        "本地已准确确认的停止标记保留；远端待核不外发，不同时传tels期待AND，不扩大批次/同号删除。"
      ]
    },
    {
      "id": "ALT-005",
      "condition": "供应商明确失败、目标被跳过或只有部分/非目标成功",
      "steps": [
        "保存原原因/跳过列表，不标当前目标已删；本地已确认待计划停止保留。"
      ]
    },
    {
      "id": "ALT-006",
      "condition": "供应商超时、响应未知或结果可信矛盾",
      "steps": [
        "保留本次操作证据待核，不盲重发删除、不释放业务补提交UNKNOWN占用，不伪造远端成功或在途撤回。"
      ]
    },
    {
      "id": "ALT-007",
      "condition": "目标有业务补提交已发起/在途或预算UNKNOWN占用",
      "steps": [
        "本地取消仅阻断未执行计划；已发起和未知占用不释放，远端在途行为仍按供应商能力待核，不追加停止原生规则API。"
      ]
    }
  ],
  "postconditions": [
    "用户明确取消不产生副作用；当前授权确认只作用具体目标待计划及可准确表达的供应商对象。",
    "本地停止与远端已删是两个分别核实的状态；失败/跳过/UNKNOWN不假成功。",
    "必要本地记录/root/fileId/call/三态及失败累计已用/UNKNOWN证据保留，其他同号记录/批次/任务不受误删。"
  ],
