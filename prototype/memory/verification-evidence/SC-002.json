{
  "schema_version": "1.0",
  "id": "SC-002",
  "name": "线路侧风控结果关联与回传",
  "summary": "每次线路侧话单/SIP和供应商最后一条标记回传DCC；导航/任务重呼不假定停用，不承诺绝对换主叫。",
  "actors": [
    "云呼叫中心",
    "AliCti供应商",
    "DCC",
    "运营人员"
  ],
  "trigger": "供应商本次结果事件或话单更新",
  "preconditions": [
    "已保存当前record/batch→supplier fileId及tenant/原task/leadCode/固定phone可准确关联，读回原request行/root；不按后来新主重算旧事件",
    "任务来源创建提交后锁定，技术未知保留待核",
    "同phone多leadCode等既有未决业务歧义仍待核，不因新flag/归组键自动许可或纳组；手工不扩展DCC协议。"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "AliCti供应商",
      "action": "获取本次事件/话单并保留原字段来源",
      "system_response": "每次结果准确追溯，未知与false分开；未核能力仅模拟",
      "rule_ids": [
        "BR-015",
        "BR-017"
      ]
    },
    {
      "step": 2,
      "actor": "云呼叫中心",
      "action": "按已保存当前record/batch→supplier fileId和原号码数据关联结果，读回原request行/root；缺失或冲突待核",
      "system_response": "每次结果准确追溯，未知与false分开；未核能力仅模拟",
      "rule_ids": [
        "BR-012",
        "BR-015",
        "BR-017"
      ]
    },
    {
      "step": 3,
      "actor": "云呼叫中心",
      "action": "记录本次风控/话单/SIP及最后一通；秒挂按真实组合识别",
      "system_response": "每次结果准确追溯，未知与false分开；未核能力仅模拟",
      "rule_ids": [
        "BR-015",
        "BR-017"
      ]
    },
    {
      "step": 4,
      "actor": "云呼叫中心",
      "action": "按锁定来源分流：接口结果携原requestId/行定位/recordId/当前batchId/已存rootBatchId及真实call/事件回传，手工仅平台查看",
      "system_response": "每次结果准确追溯，未知与false分开；未核能力仅模拟",
      "rule_ids": [
        "BR-015",
        "BR-017"
      ]
    },
    {
      "step": 5,
      "actor": "DCC",
      "action": "DCC决定是否/何时再次业务导入；新requestId及逐行isNewBatch可选Boolean（缺省false）、同组固定phone、本次priority",
      "system_response": "平台无倒计时/额度，接收复用SC-001/SEQ-001主子协议，不传父批字段；不保证供应商换主叫/排重接收/无并行在途",
      "rule_ids": [
        "BR-002",
        "BR-003",
        "BR-012"
      ]
    },
    {
      "step": 6,
      "actor": "云呼叫中心",
      "action": "鉴权后先按flag缺省false归一请求去重；新ID逐行核同tenant/原task/lead固定phone和历史归组，分配新record/batch及主/子root",
      "system_response": "true独立新主root=batch；false/missing有同组主则新子直接最近已保存主，无主首主；最近按保存创建序列，旧请求回原映射不重交；改phone/历史关联不明不提交",
      "rule_ids": [
        "BR-002",
        "BR-003",
        "BR-004",
        "BR-012",
        "BR-015"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-001",
      "condition": "结果/关联未知或冲突",
      "steps": [
        "保留待核，不伪造最终结果，不按查询空值反推无话单"
      ]
    },
    {
      "id": "ALT-002",
      "condition": "重复、晚更新或回传失败",
      "steps": [
        "重复不作为新呼叫，晚更新同对象；失败可观察可补送，技术策略交开发"
      ]
    },
    {
      "id": "ALT-003",
      "condition": "手工来源任务",
      "steps": [
        "平台查看，不回传DCC，不改变锁定来源"
      ]
    },
    {
      "id": "ALT-004",
      "condition": "同tenant/原task/leadCode固定phone改变，或历史归组关联不明/冲突",
      "steps": [
        "该行拒绝或待核且不提交，不按最近同号/结果/priority猜根；同请求重传先回原映射"
      ]
    },
    {
      "id": "ALT-005",
      "condition": "同requestId归一有效完整业务请求相同重传",
      "steps": [
        "返回原逐行record/batch/root，新主后来变化也不重算，不重建不重交；flag missing与false归一一致"
      ]
    },
    {
      "id": "ALT-006",
      "condition": "同requestId归一完整业务内容不同",
      "steps": [
        "整重复request冲突拒绝，不覆盖原逐行结果"
      ]
    }
  ],
  "postconditions": [
    "接口任务每次结果/同对象更新携原request行/record/batch/root，手工仅平台查看；无话单不伪造callID。",
    "DCC负责再次业务导入决策，本平台无每日衰减、倒计时或额度。",
    "每有效新业务行新record/batch；true独立新主，false/missing有同组已保存主则子直接root、无主首主；最近主只按保存创建序列。",
    "旧请求同归一内容重传回原root不受后来新主影响、不重复供应商导入；供应商排重/精准删除/旧批并行在途仍待核，不自动先删或等finish。"
  ],
