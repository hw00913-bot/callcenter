  "query": {
    "get": {
      "required": {
        "exten": "String,3–11位"
      },
      "response": "data extension object"
    },
    "list": {
      "filters": {
        "exten": "String optional,3–11位",
        "type": "Int 1/2/3",
        "isBind": "Int 1 bound /0 unbound",
        "active": "Int 1 active /0 inactive; omitted queries all"
      },
      "pagination": {
        "limit": "Int, >0 and <=500, default10",
        "offset": "Int, official description says positive integer but default0"
      },
      "response": "data.list[] and pagination fields",
