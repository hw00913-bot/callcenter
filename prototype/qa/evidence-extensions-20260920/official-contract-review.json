    }
  },
  "delete": {
    "single": {
      "endpoint": "/interface/v10/exten/delete",
      "extenDocumentedType": "Int",
      "conflict": "create/get/update/list define extension number as String; this discrepancy is NOT covered by the prior supplier cno clarification",
      "response": "no data definition"
    },
    "batch": {
      "endpoint": "/interface/v10/exten/batchDelete",
      "required": {
        "extens": "String; comma-delimited extension numbers, maximum100"
      },
      "response": {
        "success": "String count",
        "fail": "String count"
      },
      "singleItemProposal": "Pass a one-item extens list, preserving original string and leading zeros. This uses the documented batch endpoint; do not rewrite the single-delete document into String. Confirm per-item outcome by get/list after success since batch response has counts only."
    }
  },
  "batchCreate": {
    "required": [
      "fromExten:String 3–11位",
      "toExten:String 3–11位",
      "password:String",
      "areaCode:String",
      "type:Int"
    ],
    "range": "fromExten < toExten; maximum100; existing extension is not created",
    "response": [
      "success:String",
      "successExtens:String[]",
      "fail:String",
      "failExtens:String[]"
    ]
  },
  "accountScopeAndBinding": {
    "official": [
      "All extension APIs are authenticated by departmentId or enterpriseId and returned extension data carries enterpriseId.",
      "Extension CRUD requests have no tenantId and no cno binding parameter.",
      "List supports isBind=0/1; bindCno/lastBindCno occur in response examples but their complete lifecycle is not defined.",
      "Agent.update has bindTel/bindTelType in response example only, not documented write parameters.",
      "Toolbar Agent.login requires bindTel:String and bindType:Int; bindType=3 is softphone. Resource type=2 is WebRTC. Agent data bindTelType=4 is softphone: these enums must not be conflated.",
      "Toolbar changeBindTel documents bindType=1/2 only, not3.",
      "personnel/createAndBind creates employee, agent and extension together; it is not an existing-extension assignment API."
    ],
    "proposedLocalPolicy": [
      "Use enterpriseId + original exten string as a local scoped identity; do not infer globally unique extension numbers.",
      "Maintain tenant allocation locally. Permit one assigned tenant and one non-deleted occupying agent per extension, within the same enterprise account.",
      "Agent selection must use an existing active WebRTC extension authorized for the current tenant, not arbitrary typed text.",
      "Read the stored selected extension into Agent.login.bindTel on the next login; do not claim live softphone rebinding via changeBindTel.",
      "Unknown/stale directory or invalid selection should prevent a new login; it must not prevent normal logout of an already logged-in agent."
    ],
    "notEstablishedByDocs": [
      "Global uniqueness across enterprise accounts",
      "Password complexity / numeric-only extension regex beyond the documented length",
      "Lifetime of bindCno/lastBindCno and persistent ownership semantics",
      "Effects of extension update/disable/delete on ongoing calls",
      "Real-time softphone rebind support"
    ]
  },
