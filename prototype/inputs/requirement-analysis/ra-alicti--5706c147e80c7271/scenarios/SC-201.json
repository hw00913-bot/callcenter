      "rule_ids": [
        "BR-201"
      ]
    },
    {
      "step": 5,
      "actor": "统一外呼中台",
      "action": "建立当前范围并加载角色菜单",
      "system_response": "普通用户不能切供应商账号；超管仅一个有效供应商账号",
      "input": "成员单一角色、租户供应商账号",
      "rule_ids": [
        "BR-201"
      ]
    },
    {
      "step": 6,
      "actor": "中台账号用户",
      "action": "进入当前角色工作台",
      "system_response": "完成登录；演示切换不计生产功能",
      "input": "有效访问上下文",
      "rule_ids": [
        "BR-201"
      ]
