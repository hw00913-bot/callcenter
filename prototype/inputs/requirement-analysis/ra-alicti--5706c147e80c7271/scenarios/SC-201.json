      "step": 1,
      "actor": "中台账号用户",
      "action": "使用账号或手机号登录",
      "system_response": "认证申请",
      "input": "既有密码/验证码规则",
      "rule_ids": [
        "BR-201"
      ]
    },
    {
      "step": 2,
      "actor": "统一外呼中台",
      "action": "账号认证及状态有效？",
      "system_response": "满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "input": "前一步操作与当前上下文",
      "rule_ids": [
        "BR-201"
      ]
    },
    {
      "step": 3,
      "actor": "中台账号用户",
      "action": "多租户时选择一个租户及业务域",
      "system_response": "唯一租户及业务域",
      "input": "有效成员关系与产品能力",
      "rule_ids": [
        "BR-201"
      ]
    },
    {
      "step": 4,
      "actor": "统一外呼中台",
      "action": "租户、角色与产品能力有效？",
      "system_response": "满足条件沿通过分支继续，否则按异常分支结束本次操作",
