{
  "schema_version": "1.0",
  "id": "SC-201",
  "name": "选择登录租户及业务域",
  "summary": "继承账号或手机号登录；多租户在登录时选择，换租户退出重登；双能力租户选择业务域；普通用户不切供应商账号",
  "actors": [
    "中台账号用户",
    "统一外呼中台"
