{
  "schema_version": "1.0",
  "id": "SC-005",
  "name": "联络中心身份停用、恢复与删除",
  "summary": "由管理员独立控制电话能力生命周期，在不打断进行中通话的前提下完成状态变更并永久保留历史。",
  "actors": [
    "租户管理员",
    "统一外呼中台",
    "AliCti"
  ],
  "trigger": "租户管理员主动选择停用、恢复或删除联络中心身份",
  "preconditions": [
    "联络中心身份已归属当前租户，并具有可核验的中台与AliCti实际状态"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "租户管理员",
      "action": "选择坐席停用、恢复或删除",
      "system_response": "生命周期操作申请",
      "input": "本租户坐席与当前状态",
      "rule_ids": [
        "BR-005"
      ]
    },
    {
      "step": 2,
      "actor": "统一外呼中台",
      "action": "有权限且满足所选操作前置条件？",
      "system_response": "满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "input": "前一步操作与当前上下文",
      "rule_ids": [
        "BR-005"
      ]
    },
    {
      "step": 3,
      "actor": "统一外呼中台",
      "action": "停用先阻止新任务并等待在途通话/话后完成；恢复先复检资源",
      "system_response": "未安全结束保持待停用，不强制挂断",
      "input": "当前租户及enterpriseId范围内经授权的业务上下文",
      "rule_ids": [
        "BR-005"
      ]
    },
    {
      "step": 4,
      "actor": "AliCti",
      "action": "在安全状态执行坐席变更并反馈结果",
      "system_response": "active/isOb等更新；在线限制或失败保持待处理，删除需对应契约核验",
      "input": "当前租户及enterpriseId范围内经授权的业务上下文",
      "rule_ids": [
        "BR-005"
      ]
    },
    {
      "step": 5,
      "actor": "统一外呼中台",
      "action": "安全条件和厂商操作结果均已确认？",
      "system_response": "未确认不伪造停用、恢复或删除成功",
      "input": "当前租户及enterpriseId范围内经授权的业务上下文",
      "rule_ids": [
        "BR-005"
      ]
    },
    {
      "step": 6,
      "actor": "统一外呼中台",
      "action": "确认生命周期结果并保留历史",
      "system_response": "停用/恢复/删除状态；历史记录不删",
      "input": "厂商结果与引用检查",
      "rule_ids": [
        "BR-005"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-005-2",
      "condition": "有权限且满足所选操作前置条件？：不满足",
      "steps": [
        "拒绝跨租户或不满足条件的操作；列明引用和当前通话"
      ],
      "continuation": "本次操作结束；修正后由用户重新发起，不自动重试不可重复动作。"
    },
    {
      "id": "ALT-005-5",
      "condition": "操作成功且进行中通话已安全结束？：不满足",
      "steps": [
        "保留处理中/失败待核对，不假定已停用或已删除"
      ],
      "continuation": "本次操作结束；修正后由用户重新发起，不自动重试不可重复动作。"
    },
    {
      "id": "ALT-005-CANCEL",
      "condition": "执行变更前取消确认",
      "steps": [
        "取消提交：不执行本次变更，保留已有有效数据"
      ]
    }
  ],
  "postconditions": [
    "由管理员独立控制电话能力生命周期，在不打断进行中通话的前提下完成状态变更并永久保留历史。"
  ],
  "acceptance_points": [
    "由管理员独立控制电话能力生命周期，在不打断进行中通话的前提下完成状态变更并永久保留历史。",
    "权限或资源条件不满足时明确拦截，不跨租户执行，不伪造成功；具体失败/超时与补偿边界见本场景图及关联接口核验。"
  ],
  "source_story_ids": [
    "US-005"
  ],
