      "name": "中台业务服务",
      "kind": "system"
    },
    {
      "id": "db",
      "name": "中台数据存储",
      "kind": "system"
    }
  ],
  "messages": [
    {
      "step": 1,
      "from": "u",
      "to": "ui",
      "message": "已有账号需要在中台工作台外呼",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 2,
      "from": "ui",
      "to": "svc",
      "message": "提交当前登录态、租户及业务操作；供应商账号由授权映射确定",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 3,
      "from": "svc",
      "to": "db",
      "message": "校验当前用户、租户、enterpriseId和目标业务对象权限",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 4,
      "from": "db",
      "to": "svc",
      "message": "返回授权上下文及有效业务数据",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 5,
      "from": "svc",
      "to": "ui",
      "message": "拒绝越权/失效操作，保留输入且不调用供应商",
      "type": "error",
      "api_id": null,
      "condition": "校验失败；本路径结束"
    },
    {
      "step": 6,
      "from": "u",
      "to": "ui",
      "message": "账号列表选择“关联坐席”，账号新增和编辑沿用线上表单",
      "type": "request",
      "api_id": null,
      "condition": "前置业务条件成立"
    },
    {
      "step": 7,
      "from": "svc",
      "to": "svc",
      "message": "成员、坐席及操作人同租户且有权？；通过才继续；不通过结束本次操作",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 8,
      "from": "u",
      "to": "ui",
      "message": "选择未被关联的现有坐席，或进入新建坐席分支",
      "type": "request",
      "api_id": null,
      "condition": "前置业务条件成立"
    },
    {
      "step": 9,
      "from": "svc",
      "to": "svc",
      "message": "新建分支先完成 SC-003 并确认实际坐席，现有分支直接复检；按本步骤完成结果继续",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 10,
      "from": "svc",
      "to": "svc",
      "message": "坐席已有效开通、未被其他账号占用且不在使用中换绑？；通过才继续；不通过结束本次操作",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 11,
      "from": "svc",
      "to": "svc",
      "message": "原子保存平台账号与本租户坐席的一对一关系；平台accountId—本地坐席ID—enterpriseId/cno，UUID不参与",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 12,
      "from": "u",
      "to": "ui",
      "message": "账号列表显示已开通/未开通及关联结果；有资源并上线后才可通话",
      "type": "request",
      "api_id": null,
      "condition": "前置业务条件成立"
    },
    {
      "step": 13,
      "from": "svc",
      "to": "ui",
      "message": "拒绝越权；不把账号角色直接视为电话资格",
      "type": "error",
      "api_id": null,
      "condition": "成员、坐席及操作人同租户且有权？：不通过"
    },
    {
      "step": 14,
      "from": "svc",
      "to": "ui",
      "message": "保留原关系；新建失败不显示已关联，不自动删除已创建的坐席",
      "type": "error",
      "api_id": null,
      "condition": "坐席已有效开通、未被其他账号占用且不在使用中换绑？：不通过"
    },
    {
      "step": 15,
      "from": "svc",
      "to": "ui",
      "message": "返回已证实结果；未知能力显示待确认，保留数据并可再次核对",
      "type": "response",
      "api_id": null,
      "condition": null
    }
  ],
  "notes": [
