      "name": "中台数据存储",
      "kind": "system"
    },
    {
      "id": "vendor",
      "name": "AliCti",
      "kind": "external_system"
    }
  ],
  "messages": [
    {
      "step": 1,
      "from": "u",
      "to": "ui",
      "message": "需要自动语音通知或交互",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 2,
      "from": "ui",
      "to": "svc",
      "message": "提交当前登录态、租户及业务操作；供应商账号由授权映射确定",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 3,
      "from": "svc",
      "to": "db",
      "message": "校验当前用户、租户、enterpriseId和目标业务对象权限",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 4,
      "from": "db",
      "to": "svc",
      "message": "返回授权上下文及有效业务数据",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 5,
      "from": "svc",
      "to": "ui",
      "message": "拒绝越权/失效操作，保留输入且不调用供应商",
      "type": "error",
      "api_id": null,
      "condition": "校验失败；本路径结束"
    },
    {
      "step": 6,
      "from": "u",
      "to": "ui",
      "message": "新建IVR外呼并填写本次配置",
      "type": "request",
      "api_id": null,
      "condition": "前置业务条件成立"
    },
    {
      "step": 7,
      "from": "svc",
      "to": "svc",
      "message": "按当前角色处理可选客户；草稿预选不占用；运营由管理员后续分配",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 8,
      "from": "svc",
      "to": "svc",
      "message": "资源、参数、分配权限及所选客户复检通过？；满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 9,
      "from": "svc",
      "to": "vendor",
      "message": "创建type=2任务，指定ivrId或ivrName；autoStart=0，不启用autoDelete",
      "type": "request",
      "api_id": "API-311",
      "condition": "对应操作/呼叫类型，且其前置路径成立"
    },
    {
      "step": 10,
      "from": "vendor",
      "to": "svc",
      "message": "保存taskId及创建结果，不标运行",
      "type": "response",
      "api_id": "API-311",
      "condition": "对应操作/呼叫类型，且其前置路径成立"
    },
    {
      "step": 11,
      "from": "u",
      "to": "ui",
      "message": "名单就绪后单独请求启动",
      "type": "request",
      "api_id": null,
      "condition": "前置业务条件成立"
    },
    {
      "step": 12,
      "from": "svc",
      "to": "svc",
      "message": "名单、用号权及已验证的语音导航执行条件有效？；纯IVR零坐席、转人工资源及节点输出是POC前提",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 13,
      "from": "svc",
      "to": "vendor",
      "message": "发送名单JSON/property，importTelAutoStart=0；大小<=8MB、单批<=10万",
      "type": "request",
      "api_id": "API-312",
      "condition": "对应操作/呼叫类型，且其前置路径成立"
    },
    {
      "step": 14,
      "from": "vendor",
      "to": "svc",
      "message": "记录有效/失败计数；来源映射未证实的行不假定已贯通",
      "type": "response",
      "api_id": "API-312",
      "condition": "对应操作/呼叫类型，且其前置路径成立"
    },
    {
      "step": 15,
      "from": "svc",
      "to": "ui",
      "message": "启动/恢复契约未核验，显示待确认，不发送虚构调用或生成本次通话",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 16,
      "from": "svc",
      "to": "svc",
      "message": "执行已确认受理且可持续取得结果？；满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 17,
      "from": "svc",
      "to": "svc",
      "message": "归集IVR轨迹和适用话单，更新原批次；未知保持待确认；纯IVR不等待虚构人工录音",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 18,
      "from": "svc",
      "to": "ui",
      "message": "保留草稿；运营携带客户选择则拒绝，不虚构名单数量",
      "type": "error",
      "api_id": null,
      "condition": "资源、参数、分配权限及所选客户复检通过？：不满足"
    },
    {
      "step": 19,
      "from": "svc",
      "to": "ui",
      "message": "禁止空名单或失效资源启动；草稿不可启动",
      "type": "error",
      "api_id": null,
      "condition": "有名单且用号/流程/技能等执行条件有效？：不满足"
    },
    {
      "step": 20,
      "from": "svc",
      "to": "ui",
      "message": "保留失败或待核对，先查询状态，不盲目重复投放",
      "type": "error",
      "api_id": null,
      "condition": "执行已确认受理且可持续取得结果？：不满足"
    },
    {
      "step": 21,
      "from": "svc",
      "to": "ui",
      "message": "取消本次提交：既有草稿保留，预选客户不占用",
      "type": "error",
      "api_id": null,
      "condition": "执行变更前取消确认"
    },
    {
      "step": 22,
      "from": "svc",
      "to": "ui",
      "message": "返回已证实结果；未知能力显示待确认，保留数据并可再次核对",
      "type": "response",
      "api_id": null,
      "condition": null
    }
