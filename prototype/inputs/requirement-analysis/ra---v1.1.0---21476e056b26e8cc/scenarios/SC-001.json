{
  "schema_version": "1.0",
  "id": "SC-001",
  "name": "DCC客户接收与按手机号拆批",
  "summary": "接收DCC客户并按一个手机号一个批次拆分，保留线索编码；R为可选来源元数据，提供则保留追踪，缺R不失败且无需字典维护；在云呼叫中心本地持久保存导入客户记录；支持导入失败记录导出；导入接口增加独立优先级字段；有效客户保存拆批后自动提交供应商接口；本地优先级配置与每日自然日降级；DCC定向删除供应商号码；应用凭据换租户token；创建提交锁定单一任务来源，后端校验，接口任务回传、手工仅查看。 同步证据与53失败分片独立处理，按来源回传，快照导出不删除必要业务状态。",
  "actors": [
    "DCC",
    "云呼叫中心",
    "AliCti供应商",
    "运营人员"
  ],
  "trigger": "DCC主动传入外呼客户数据",
  "preconditions": [
    "应用及租户授权配置是已确认业务目标；无真实凭据",
    "每行独立判断，未约定的幂等行为不推定",
    "应用配置仅由超管维护；租户管理员直达管理页面/接口拒绝；业务租户token不授予管理权"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "DCC",
      "action": "使用授权应用凭证与tenantId申请租户token",
      "system_response": "验证应用租户授权；返回值/时效待定",
      "rule_ids": [
        "BR-001"
      ]
    },
    {
      "step": 2,
      "actor": "DCC",
      "action": "携租户token提交客户和供应商taskId",
      "system_response": "按租户/task归属及创建提交锁定方式逐行校验，接口任务拒绝手工混入",
      "rule_ids": [
        "BR-001",
        "BR-003"
      ]
    },
    {
      "step": 3,
      "actor": "云呼叫中心",
      "action": "对有效行保存独立客户记录和单手机号批次",
      "system_response": "关联原始导入来源，不覆盖历史",
      "rule_ids": [
        "BR-002"
      ]
    },
    {
      "step": 4,
      "actor": "云呼叫中心",
      "action": "待提交记录高优先级先、同级本地时间FIFO自动提交供应商",
      "system_response": "已提交不撤回重排；未知提交不重复；仅同任务，不同任务独立，实际拨打次序不承诺",
      "rule_ids": [
        "BR-003",
        "BR-004"
      ]
    },
    {
      "step": 5,
      "actor": "AliCti供应商",
      "action": "返回号码导入业务结果",
      "system_response": "保留同步数量及准确成功证据；result0不等逐条全成功，未知待核",
      "rule_ids": [
        "BR-004"
      ]
    },
    {
      "step": 6,
      "actor": "云呼叫中心",
      "action": "按后续事件跟进该条记录",
      "system_response": "每日可信状态priority降级或DCC精准删除；每次结果按任务来源回传/查看，不自建重导",
      "rule_ids": [
        "BR-006",
        "BR-007"
      ]
    },
    {
      "step": 7,
      "actor": "AliCti供应商",
      "action": "异步推送导入失败结果分片",
      "system_response": "关联本次导入批次及leadCode，去重/迟到处理；接口回传DCC、手工只查看，失败不计呼叫；导出按快照清理",
      "rule_ids": [
        "BR-018",
        "BR-019"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-001",
      "condition": "身份/授权无效",
      "steps": [
        "拒绝当前请求，不创建业务记录"
      ]
    },
    {
      "id": "ALT-002",
      "condition": "该行线索编码/priority/目标等必要校验失败（缺R不失败、不做字典范围校验）",
      "steps": [
        "该行失败明细进入FLOW-002",
        "其他有效行继续，不回滚整请求"
      ]
    },
    {
      "id": "ALT-003",
      "condition": "供应商明确拒绝",
      "steps": [
        "保留已保存本地记录",
        "失败进入FLOW-002"
      ]
    },
    {
      "id": "ALT-004",
      "condition": "结果未知或超时",
      "steps": [
        "结果待核实暂停，核实后再处理，不自动再次提交",
        "明确拒绝/重复通知独立记录，不算新实际呼叫"
      ]
    },
    {
      "id": "ALT-005",
      "condition": "删除失败/未知或执行并发边界不明",
      "steps": [
        "不标供应商已删除",
        "实际并发保护方式待G2决策"
      ]
    },
    {
      "id": "ALT-006",
      "condition": "手工导入逐行校验失败",
      "steps": [
        "失败入同一下载生命周期",
        "按钮常驻；无操作权限时的具体矩阵待核，不伪造许可"
      ]
    },
    {
      "id": "ALT-007",
      "condition": "本次业务为手工线索导入",
      "steps": [
        "常驻按钮导入编码/可选R/priority",
        "统一填写可逐条修改，仅提交前",
        "逐行校验并对有效行单号拆批、最终值自动提交",
        "明确拒绝/校验失败走同失败导出，未知待核，不新增提交后priority手改入口"
      ]
    },
    {
      "id": "ALT-008",
      "condition": "53分片重复、迟到或关联/声明冲突",
      "steps": [
        "可信关联的新失败保存并按来源回传/查看；重复不新增，已导出重复不再生",
        "关联冲突或分片矛盾保持待核；未知不推定全成功",
        "后到新失败进入下一次导出，必要去重/关联/交付状态保留"
      ]
    }
  ],
  "postconditions": [
    "本地记录可留存且新批次独立",
    "导入接受不等于呼叫接通",
    "删除成功只影响精准记录",
    "结果未知/矛盾：待核实暂停继续重提；明确拒绝/重复通知另记，不算新实际呼叫；外部能力仅合成模拟"
  ],
