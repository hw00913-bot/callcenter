{
  "schema_version": "1.0",
  "id": "SC-004",
  "name": "客户秒挂识别与每次结果回传",
  "summary": "客户真实接通、客户主动挂断、有效时长0～2秒含真实0/2；识别回传DCC，不在平台调度重导。",
  "actors": [
    "云呼叫中心",
    "AliCti供应商",
    "DCC",
    "运营人员"
  ],
  "trigger": "供应商本次结果事件或话单更新",
  "preconditions": [
    "租户/task/线索编码/手机号/本次批次或稳定事件可准确关联",
    "任务来源创建提交后锁定，技术未知保留待核"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "AliCti供应商",
      "action": "获取本次事件/话单并保留原字段来源",
      "system_response": "每次结果准确追溯，未知与false分开；未核能力仅模拟",
      "rule_ids": [
        "BR-015",
        "BR-017"
      ]
    },
    {
      "step": 2,
      "actor": "云呼叫中心",
      "action": "回查本地任务/批次/线索编码/手机号，缺失关联待核",
      "system_response": "每次结果准确追溯，未知与false分开；未核能力仅模拟",
      "rule_ids": [
        "BR-015",
        "BR-017"
      ]
    },
    {
      "step": 3,
      "actor": "云呼叫中心",
      "action": "记录本次风控/话单/SIP及最后一通；秒挂按真实组合识别",
      "system_response": "每次结果准确追溯，未知与false分开；未核能力仅模拟",
      "rule_ids": [
        "BR-015",
        "BR-017"
      ]
    },
    {
      "step": 4,
      "actor": "云呼叫中心",
      "action": "按锁定来源分流：接口任务回传固定DCC地址，手工任务仅平台查看",
      "system_response": "每次结果准确追溯，未知与false分开；未核能力仅模拟",
      "rule_ids": [
        "BR-015",
        "BR-017"
      ]
    },
    {
      "step": 5,
      "actor": "DCC",
      "action": "DCC决定是否再次推送；平台仅接收新导入，不创建倒计时或额度",
      "system_response": "每次结果准确追溯，未知与false分开；未核能力仅模拟",
      "rule_ids": [
        "BR-015",
        "BR-017"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-001",
      "condition": "结果/关联未知或冲突",
      "steps": [
        "保留待核，不伪造最终结果，不按查询空值反推无话单"
      ]
    },
    {
      "id": "ALT-002",
      "condition": "重复、晚更新或回传失败",
      "steps": [
        "重复不作为新呼叫，晚更新同对象；失败可观察可补送，技术策略交开发"
      ]
    },
    {
      "id": "ALT-003",
      "condition": "手工来源任务",
      "steps": [
        "平台查看，不回传DCC，不改变锁定来源"
      ]
    }
  ],
  "postconditions": [
    "接口任务每次结果及其更新回传DCC，手工任务仅平台查看",
    "DCC负责重新导入决策，平台不建立重呼计划",
