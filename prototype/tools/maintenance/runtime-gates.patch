+def register_rule_reference(args: argparse.Namespace) -> int:
+    """Record only the authorized reference-line migration, not PM approval."""
+    project = Path(args.project).expanduser().resolve()
+    workflow = load_json(project / "config/workflow.json")
+    iteration = workflow.get("currentIteration", {})
+    path = project / CLAUDE_PATH
+    if not path.exists() or len(args.evidence.strip()) < 6:
+        print("- ERROR: 缺少规则文件或本次技术迁移授权依据")
+        return 1
+    data = path.read_bytes()
+    before = before_reference(data)
+    if before is None or digest(before) != iteration.get("approvedClaudeSha256"):
+        print("- ERROR: 仅允许增加一行功能记忆引用；存在其他规则变化，不能兼容迁移")
+        return 1
+    previous = iteration.get("ruleReferenceMigration")
+    if previous:
+        errors = validate_plan_approval(project)
+        if errors:
+            print("\n".join(f"- ERROR: {error}" for error in errors))
+            return 1
+        print("Rule reference migration already registered; original approval preserved.")
+        return 0
+    migration = {
+        "kind": RULE_REFERENCE_MIGRATION,
+        "writer": "tools/loop_run.py",
+        "migratedAt": datetime.now().isoformat(timespec="seconds"),
+        "authorization": args.evidence.strip(),
+        "originalPlanApprovalId": iteration.get("planApprovalId"),
+        "beforeSha256": digest(before),
+        "afterSha256": digest(data),
+    }
+    # Validate the candidate against all existing approval checks before commit.
+    # The temporary copy is only approval metadata; no project stage is advanced.
+    candidate = json.loads(json.dumps(workflow))
+    candidate["currentIteration"]["ruleReferenceMigration"] = migration
+    errors = validate_plan_approval(project, candidate)
+    if errors:
+        print("\n".join(f"- ERROR: {error}" for error in errors))
+        return 1
+    write_json(project / "config/workflow.json", candidate)
+    print("Rule reference migrated; original PM approval, frozen plan and stage state preserved.")
+    return 0
+
