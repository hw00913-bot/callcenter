{
  "schema_version": "1.0",
  "id": "SC-204",
  "name": "按外呼方式分配或改派客户",
  "summary": "勾选客户后选择人工、预外呼或 IVR；人工选择有效运营坐席，其他选择同租户同供应商账号同类型未启动任务。",
  "actors": [
    "租户管理员",
    "统一外呼中台"
  ],
  "trigger": "需要安排已导入客户的呼叫方式",
  "preconditions": [
    "当前身份与租户能力有效"
  ],
  "main_flow": [
    {
      "step": 1,
      "actor": "租户管理员",
      "action": "筛选待分配客户，逐条勾选或全选当前筛选可分配项",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-204"
      ]
    },
    {
      "step": 2,
      "actor": "租户管理员",
      "action": "点击分配，弹窗选择人工外呼、预外呼或 IVR",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-204"
      ]
    },
    {
      "step": 3,
      "actor": "统一外呼中台",
      "action": "人工返回有效且关联账号的本租户坐席；自动方式返回同类型未启动任务",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-204"
      ]
    },
    {
      "step": 4,
      "actor": "统一外呼中台",
      "action": "所选客户与目标仍同租户同供应商账号，且满足分配/改派条件？",
      "system_response": "通过才继续；不通过结束本次操作",
      "rule_ids": [
        "BR-204"
      ]
    },
    {
      "step": 5,
      "actor": "租户管理员",
      "action": "确认客户数量和目标；取消保持原分配关系",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-204"
      ]
    },
    {
      "step": 6,
      "actor": "统一外呼中台",
      "action": "事务保存 ownerId 或 taskId；不混用人员和任务，不改写历史通话",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-204"
      ]
    },
    {
      "step": 7,
      "actor": "租户管理员",
      "action": "已分配客户移出默认待分配；人工进入本人坐席工作台，自动进入对应任务",
      "system_response": "按本步骤完成结果继续",
      "rule_ids": [
        "BR-204"
      ]
    }
  ],
  "alternate_flows": [
    {
      "id": "ALT-204-4",
      "condition": "所选客户与目标仍同租户同供应商账号，且满足分配/改派条件？：不通过",
      "steps": [
        "拒绝已占用、通话/话后锁定、已完成或自动任务已启动的冲突项"
      ]
    }
  ],
  "postconditions": [
    "勾选客户后选择人工、预外呼或 IVR；人工选择有效运营坐席，其他选择同租户同供应商账号同类型未启动任务。"
  ],
  "acceptance_points": [
    "全选受当前筛选与可分配资格约束，并清楚展示选中数量。",
    "已联系但未完成的人工客户在无在途/话后锁定时可改派；历史归属不随改派变化。"
  ],
  "source_story_ids": [
