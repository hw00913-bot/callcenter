{
  "schema_version": "1.0",
  "id": "SEQ-002",
  "scenario_id": "SC-002",
  "name": "创建或复用中台登录账号并加入租户时序",
  "participants": [
    {
      "id": "u",
      "name": "当前有权操作人",
      "kind": "actor"
    },
    {
      "id": "ui",
      "name": "中台页面",
      "kind": "system"
    },
    {
      "id": "svc",
      "name": "中台业务服务",
      "kind": "system"
    },
    {
      "id": "db",
      "name": "中台数据存储",
      "kind": "system"
    }
  ],
  "messages": [
    {
      "step": 1,
      "from": "u",
      "to": "ui",
      "message": "租户管理员或超级管理员需要新增管理员/运营成员",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 2,
      "from": "ui",
      "to": "svc",
      "message": "提交当前登录态、租户及业务操作；供应商账号由授权映射确定",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 3,
      "from": "svc",
      "to": "db",
      "message": "校验当前用户、租户、enterpriseId和目标业务对象权限",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 4,
      "from": "db",
      "to": "svc",
      "message": "返回授权上下文及有效业务数据",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 5,
      "from": "svc",
      "to": "ui",
      "message": "拒绝越权/失效操作，保留输入且不调用供应商",
      "type": "error",
      "api_id": null,
      "condition": "校验失败；本路径结束"
    },
    {
      "step": 6,
      "from": "u",
      "to": "ui",
      "message": "选定目标租户并检查手机号",
      "type": "request",
      "api_id": null,
      "condition": "前置业务条件成立"
    },
    {
      "step": 7,
      "from": "svc",
      "to": "svc",
      "message": "目标租户在管理范围内？；满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 8,
      "from": "u",
      "to": "ui",
      "message": "已有账号复用；不存在则显式创建",
      "type": "request",
      "api_id": null,
      "condition": "前置业务条件成立"
    },
    {
      "step": 9,
      "from": "svc",
      "to": "svc",
      "message": "账号唯一性与表单校验通过？；满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 10,
      "from": "svc",
      "to": "svc",
      "message": "保存账号及租户成员关系；新增或复用同一账号；不自动开通电话身份",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 11,
      "from": "svc",
      "to": "ui",
      "message": "拒绝跨租户创建或加入",
      "type": "error",
      "api_id": null,
      "condition": "目标租户在管理范围内？：不满足"
    },
    {
      "step": 12,
      "from": "svc",
      "to": "ui",
      "message": "不重复注册；保留输入并提示冲突",
      "type": "error",
      "api_id": null,
      "condition": "账号唯一性与表单校验通过？：不满足"
    },
    {
      "step": 13,
      "from": "svc",
      "to": "ui",
      "message": "取消提交：不执行本次变更，保留已有有效数据",
      "type": "error",
      "api_id": null,
      "condition": "执行变更前取消确认"
    },
    {
      "step": 14,
      "from": "svc",
      "to": "ui",
      "message": "返回已证实结果；未知能力显示待确认，保留数据并可再次核对",
      "type": "response",
      "api_id": null,
      "condition": null
    }
  ],
  "notes": [
