      "rule_ids": [
        "BR-206"
      ]
    },
    {
      "step": 4,
      "actor": "统一外呼中台",
      "action": "提交时复检草稿作者或正式任务释放资格",
      "system_response": "复检通过才提交；失败保留任务与关联",
      "input": "本人草稿无客户占用；正式任务需管理员且客户无通话/话后/完成占用",
      "rule_ids": [
        "BR-206"
      ]
    },
    {
      "step": 5,
      "actor": "统一外呼中台",
      "action": "关联客户可安全释放且保存成功？",
      "system_response": "满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "input": "前一步操作与当前上下文",
      "rule_ids": [
        "BR-206"
      ]
    },
    {
      "step": 6,
      "actor": "统一外呼中台",
      "action": "删除未启动任务并释放客户",
      "system_response": "客户返回待分配；草稿预选不占用；审计保留",
      "input": "任务记录及关联客户",
      "rule_ids": [
        "BR-206"
      ]
    }
  ],
