{
  "schema_version": "1.0",
  "id": "SEQ-005",
  "scenario_id": "SC-005",
  "name": "联络中心身份停用、恢复与删除时序",
  "participants": [
    {
      "id": "u",
      "name": "当前有权操作人",
      "kind": "actor"
    },
    {
      "id": "ui",
      "name": "中台页面",
      "kind": "system"
    },
    {
      "id": "svc",
      "name": "中台业务服务",
      "kind": "system"
    },
    {
      "id": "db",
      "name": "中台数据存储",
      "kind": "system"
    },
    {
      "id": "vendor",
      "name": "AliCti",
      "kind": "external_system"
    }
  ],
  "messages": [
    {
      "step": 1,
      "from": "u",
      "to": "ui",
      "message": "租户管理员主动选择停用、恢复或删除联络中心身份",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 2,
      "from": "ui",
      "to": "svc",
      "message": "提交当前登录态、租户及业务操作；供应商账号由授权映射确定",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 3,
      "from": "svc",
      "to": "db",
      "message": "校验当前用户、租户、enterpriseId和目标业务对象权限",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 4,
      "from": "db",
      "to": "svc",
      "message": "返回授权上下文及有效业务数据",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 5,
      "from": "svc",
      "to": "ui",
      "message": "拒绝越权/失效操作，保留输入且不调用供应商",
      "type": "error",
      "api_id": null,
      "condition": "校验失败；本路径结束"
    },
    {
      "step": 6,
      "from": "u",
      "to": "ui",
      "message": "选择坐席停用、恢复或删除",
      "type": "request",
      "api_id": null,
      "condition": "前置业务条件成立"
    },
    {
      "step": 7,
      "from": "svc",
      "to": "svc",
      "message": "有权限且满足所选操作前置条件？；满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 8,
      "from": "svc",
      "to": "svc",
      "message": "停用先阻止新任务并等待在途通话/话后完成；恢复先复检资源；未安全结束保持待停用，不强制挂断",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 9,
      "from": "svc",
      "to": "ui",
      "message": "删除契约及更新对在途通话影响未明确；显示待确认，不模拟删除成功",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 10,
      "from": "svc",
      "to": "vendor",
      "message": "仅对文档支持的更新字段提交坐席变更；在线限制先检查",
      "type": "request",
      "api_id": "API-308",
      "condition": "对应操作/呼叫类型，且其前置路径成立"
    },
    {
      "step": 11,
      "from": "vendor",
      "to": "svc",
      "message": "返回更新结果或拒绝；不推断已安全下线",
      "type": "response",
      "api_id": "API-308",
      "condition": "对应操作/呼叫类型，且其前置路径成立"
    },
    {
      "step": 12,
      "from": "svc",
      "to": "svc",
      "message": "安全条件和厂商操作结果均已确认？；未确认不伪造停用、恢复或删除成功",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 13,
      "from": "svc",
      "to": "svc",
      "message": "确认生命周期结果并保留历史；停用/恢复/删除状态；历史记录不删",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 14,
      "from": "svc",
      "to": "ui",
      "message": "拒绝跨租户或不满足条件的操作；列明引用和当前通话",
      "type": "error",
      "api_id": null,
      "condition": "有权限且满足所选操作前置条件？：不满足"
    },
    {
      "step": 15,
      "from": "svc",
      "to": "ui",
      "message": "保留处理中/失败待核对，不假定已停用或已删除",
      "type": "error",
      "api_id": null,
      "condition": "操作成功且进行中通话已安全结束？：不满足"
    },
    {
      "step": 16,
      "from": "svc",
      "to": "ui",
      "message": "取消提交：不执行本次变更，保留已有有效数据",
      "type": "error",
      "api_id": null,
      "condition": "执行变更前取消确认"
    },
    {
      "step": 17,
      "from": "svc",
      "to": "ui",
      "message": "返回已证实结果；未知能力显示待确认，保留数据并可再次核对",
      "type": "response",
      "api_id": null,
      "condition": null
    }
  ],
  "notes": [
    "接口能力以AliCti文档为最终事实；未明确支持显示待确认，不生成虚构远端成功。",
    "中台权限、数据归属和业务结果保存是本平台职责。演示数据不代表真实联调。"
  ],
  "source_refs": [
    "inputs/source-index.json#SRC-302",
    "inputs/user-instructions.md#本轮差异处理确认"
  ]
}
