{
  "schema_version": "1.0",
  "id": "SEQ-014",
  "scenario_id": "SC-014",
  "name": "创建、配置与启动预外呼任务时序",
  "participants": [
    {
      "id": "u",
      "name": "当前有权操作人",
      "kind": "actor"
    },
    {
      "id": "ui",
      "name": "中台页面",
      "kind": "system"
    },
    {
      "id": "svc",
      "name": "中台业务服务",
      "kind": "system"
    },
    {
      "id": "db",
      "name": "中台数据存储",
      "kind": "system"
    },
    {
      "id": "vendor",
      "name": "AliCti",
      "kind": "external_system"
    }
  ],
  "messages": [
    {
      "step": 1,
      "from": "u",
      "to": "ui",
      "message": "需要批量呼叫并由本租户空闲坐席承接",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 2,
      "from": "ui",
      "to": "svc",
      "message": "提交当前登录态、租户及业务操作；供应商账号由授权映射确定",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 3,
      "from": "svc",
      "to": "db",
      "message": "校验当前用户、租户、enterpriseId和目标业务对象权限",
      "type": "request",
      "api_id": null,
      "condition": null
    },
    {
      "step": 4,
      "from": "db",
      "to": "svc",
      "message": "返回授权上下文及有效业务数据",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 5,
      "from": "svc",
      "to": "ui",
      "message": "拒绝越权/失效操作，保留输入且不调用供应商",
      "type": "error",
      "api_id": null,
      "condition": "校验失败；本路径结束"
    },
    {
      "step": 6,
      "from": "u",
      "to": "ui",
      "message": "新建预外呼并填写本次配置",
      "type": "request",
      "api_id": null,
      "condition": "前置业务条件成立"
    },
    {
      "step": 7,
      "from": "svc",
      "to": "svc",
      "message": "按当前角色处理可选客户；草稿预选不占用；运营由管理员后续分配",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 8,
      "from": "svc",
      "to": "svc",
      "message": "资源、参数、分配权限及所选客户复检通过？；满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 9,
      "from": "svc",
      "to": "vendor",
      "message": "创建type=1任务；autoStart=0，不启用autoDelete；记录autoComplete策略",
      "type": "request",
      "api_id": "API-311",
      "condition": "对应操作/呼叫类型，且其前置路径成立"
    },
    {
      "step": 10,
      "from": "vendor",
      "to": "svc",
      "message": "保存taskId及明确创建结果，不标运行",
      "type": "response",
      "api_id": "API-311",
      "condition": "对应操作/呼叫类型，且其前置路径成立"
    },
    {
      "step": 11,
      "from": "u",
      "to": "ui",
      "message": "名单就绪后单独请求启动",
      "type": "request",
      "api_id": null,
      "condition": "前置业务条件成立"
    },
    {
      "step": 12,
      "from": "svc",
      "to": "svc",
      "message": "名单、授权及坐席/外呼组任务互斥均满足？；核对最小可用坐席、并发、额度、流程及重呼开通条件",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 13,
      "from": "svc",
      "to": "vendor",
      "message": "按已确认名单发送JSON；property保存来源；显式importTelAutoStart=0",
      "type": "request",
      "api_id": "API-312",
      "condition": "对应操作/呼叫类型，且其前置路径成立"
    },
    {
      "step": 14,
      "from": "vendor",
      "to": "svc",
      "message": "接收成功/无效计数；默认任务排重与跨批同号冲突保持待确认",
      "type": "response",
      "api_id": "API-312",
      "condition": "对应操作/呼叫类型，且其前置路径成立"
    },
    {
      "step": 15,
      "from": "svc",
      "to": "ui",
      "message": "启动/恢复契约未核验，显示待确认，不发送虚构调用或生成本次通话",
      "type": "response",
      "api_id": null,
      "condition": null
    },
    {
      "step": 16,
      "from": "svc",
      "to": "svc",
      "message": "执行已确认受理且可持续取得结果？；满足条件沿通过分支继续，否则按异常分支结束本次操作",
      "type": "request",
      "api_id": null,
      "condition": "前置条件成立；待确认路径不得继续标记生效"
    },
    {
      "step": 17,
      "from": "svc",
      "to": "vendor",
      "message": "对已存在通话按时间窗查询预测话单，分页或scroll",
      "type": "request",
      "api_id": "API-318",
      "condition": "对应操作/呼叫类型，且其前置路径成立"
    },
    {
      "step": 18,
      "from": "vendor",
      "to": "svc",
      "message": "客户upTime、坐席bridgeTime、40/41/42/43、重呼轮次及终轮标记",
      "type": "response",
      "api_id": "API-318",
      "condition": "对应操作/呼叫类型，且其前置路径成立"
    },
    {
      "step": 19,
      "from": "svc",
      "to": "ui",
      "message": "保留草稿；运营携带客户选择则拒绝，不虚构名单数量",
      "type": "error",
      "api_id": null,
      "condition": "资源、参数、分配权限及所选客户复检通过？：不满足"
    },
    {
      "step": 20,
      "from": "svc",
      "to": "ui",
      "message": "禁止空名单或失效资源启动；草稿不可启动",
      "type": "error",
      "api_id": null,
      "condition": "有名单且用号/流程/技能等执行条件有效？：不满足"
    },
    {
      "step": 21,
      "from": "svc",
      "to": "ui",
      "message": "保留失败或待核对，先查询状态，不盲目重复投放",
      "type": "error",
      "api_id": null,
      "condition": "执行已确认受理且可持续取得结果？：不满足"
    },
    {
      "step": 22,
      "from": "svc",
      "to": "ui",
      "message": "取消本次提交：既有草稿保留，预选客户不占用",
      "type": "error",
      "api_id": null,
      "condition": "执行变更前取消确认"
    },
    {
      "step": 23,
      "from": "svc",
      "to": "ui",
      "message": "返回已证实结果；未知能力显示待确认，保留数据并可再次核对",
      "type": "response",
      "api_id": null,
      "condition": null
    }
  ],
  "notes": [
    "接口能力以AliCti文档为最终事实；未明确支持显示待确认，不生成虚构远端成功。",
    "中台权限、数据归属和业务结果保存是本平台职责。演示数据不代表真实联调。"
  ],
